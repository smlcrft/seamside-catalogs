    {"why": "the deck an installed copy left in the space", "as": "collaborator", "at": "space", "do": "PUT /files/Slideshow/slides.json", "body": "{\n  \"settings\": {\n    \"background\": \"dark\",\n    \"aspect\": \"4:3\",\n    \"syncPresent\": true,\n    \"palette\": \"sunset\"\n  },\n  \"slides\": [\n    {\n      \"id\": \"aaaaaaaa11111111\",\n      \"background\": \"inherit\",\n      \"elements\": [\n        {\n          \"id\": \"e1e1e1e1e1e1e1e1\",\n          \"type\": \"text\",\n          \"x\": 120,\n          \"y\": 80,\n          \"w\": 960,\n          \"h\": 130,\n          \"text\": \"Quarterly review\",\n          \"style\": \"heading\",\n          \"align\": \"center\",\n          \"color\": \"text\",\n          \"size\": 64,\n          \"weight\": 700\n        }\n      ]\n    },\n    {\n      \"id\": \"bbbbbbbb22222222\",\n      \"background\": \"accent\",\n      \"elements\": [\n        {\n          \"id\": \"e2e2e2e2e2e2e2e2\",\n          \"type\": \"image\",\n          \"x\": 100,\n          \"y\": 100,\n          \"w\": 500,\n          \"h\": 330,\n          \"imageId\": \"0a1b2c3d-0000-4000-8000-00000000abcd\",\n          \"fit\": \"cover\",\n          \"radius\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"cccccccc33333333\",\n      \"background\": \"inherit\",\n      \"elements\": [\n        {\n          \"id\": \"e3e3e3e3e3e3e3e3\",\n          \"type\": \"shape\",\n          \"x\": 10,\n          \"y\": 10,\n          \"w\": 280,\n          \"h\": 170,\n          \"shape\": \"rect\",\n          \"fill\": \"accent\",\n          \"radius\": 16\n        }\n      ]\n    }\n  ]\n}", "status": 200},
