{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a recipe a Recipe Box left, in the contract's shape", "as": "collaborator", "at": "space", "do": "KV.PUT t/recipes/r1", "body": { "title": "Pancakes", "ingredients_lines": "2 cups flour\n2 eggs\n\n milk ", "steps_lines": "Mix\nFry", "servings": 4, "tags": "breakfast,sweet", "notes": "", "created_ms": 3, "photo": "data:image/jpeg;base64,AAAA", "_created_at": 3, "_modified_at": 3 }, "status": 200 },
    { "why": "and another, with a picture that is not one", "as": "collaborator", "at": "space", "do": "KV.PUT t/recipes/r2", "body": { "title": "Chili", "ingredients_lines": "beans\nonion", "steps_lines": "", "servings": 0, "tags": "dinner", "notes": "", "created_ms": 4, "photo": "https://example.com/chili.jpg", "_created_at": 4, "_modified_at": 4 }, "status": 200 },
    { "why": "a meal an installed copy left behind, on a recipe", "as": "collaborator", "at": "space", "do": "KV.PUT t/meal_plan/old1", "body": { "day_date": "2026-09-28", "slot": "dinner", "title": "Pancakes for dinner", "recipe_id": "r1", "servings": 4, "notes": "double batch", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a freeform one", "as": "collaborator", "at": "space", "do": "KV.PUT t/meal_plan/old2", "body": { "day_date": "2026-09-29", "slot": "lunch", "title": "leftovers", "recipe_id": "", "servings": 0, "notes": "", "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "one whose recipe is gone", "as": "collaborator", "at": "space", "do": "KV.PUT t/meal_plan/old3", "body": { "day_date": "2026-10-01", "slot": "brunch", "title": "Gone dish", "recipe_id": "ghost", "servings": 0, "notes": "", "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "and one the week after", "as": "collaborator", "at": "space", "do": "KV.PUT t/meal_plan/next1", "body": { "day_date": "2026-10-05", "slot": "dinner", "title": "Next week's soup", "recipe_id": "", "servings": 0, "notes": "", "_created_at": 8, "_modified_at": 8 }, "status": 200 },
    { "why": "a grocery row still to buy, from the first recipe", "as": "collaborator", "at": "space", "do": "KV.PUT t/grocery/g1", "body": { "item": "2 eggs", "quantity": "", "category": "", "checked": 0, "source": "r1", "added_ms": 1, "_created_at": 1, "_modified_at": 1 }, "status": 200 },
    { "why": "and one already bought", "as": "collaborator", "at": "space", "do": "KV.PUT t/grocery/g2", "body": { "item": "milk", "quantity": "", "category": "dairy", "checked": 1, "source": "r1", "added_ms": 2, "_created_at": 2, "_modified_at": 2 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Meal Planner", "/lib/js/framelib.js", "/dyn/frame-prefs.css"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the week of any day, from its Monday, in day order", "do": "GET {api}/week?start=2026-10-01", "status": 200, "is": { "/start": "2026-09-28", "/days/0": "2026-09-28", "/days/6": "2026-10-04", "/meals/0/id": "old1", "/meals/0/title": "Pancakes for dinner", "/meals/0/recipe_ok": true, "/meals/0/photo": "data:image/jpeg;base64,AAAA", "/meals/0/servings": 4, "/meals/0/notes": "double batch", "/meals/1/id": "old2", "/meals/1/recipe_ok": false, "/meals/2/id": "old3", "/meals/2/slot": "brunch", "/meals/2/title": "Gone dish", "/meals/2/recipe_ok": false }, "absent": ["/meals/3", "/meals/0/_created_at"], "lacks": ["Next week's soup"] },
    { "why": "and only the recipes the week names, never the rest of the box", "do": "GET {api}/week?start=2026-09-28", "is": { "/recipes/0/id": "r1", "/recipes/0/title": "Pancakes" }, "absent": ["/recipes/1"], "lacks": ["Chili", "Mix", "2 cups flour"] },
    { "why": "a missing or broken start is this week", "do": "GET {api}/week?start=nope", "status": 200, "has": ["\"days\":["] },
    { "why": "the next week holds its own", "do": "GET {api}/week?start=2026-10-05", "is": { "/meals/0/title": "Next week's soup", "/recipes": [] }, "absent": ["/meals/1"] },
    { "why": "a stranger plans nothing", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "title": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "changes nothing", "do": "POST {api}/meal/old1", "body": { "title": "mine" }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/meal/old1/delete", "body": {}, "status": 403 },
    { "why": "sends nothing to the grocery list", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/meal_plan/x", "body": { "title": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/meal_plan/", "lacks": ["Pancakes", "leftovers"] },
    { "why": "nor the recipes", "do": "KV.LIST t/recipes/", "lacks": ["Chili", "flour"] },
    { "why": "the plan is as it was", "table": "meal_plan", "has": ["Pancakes for dinner", "leftovers"], "lacks": ["sneak", "mine", "\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who sees the week and not the box", "as": "signed", "do": "GET {api}/week?start=2026-09-28", "status": 200, "is": { "/meals/0/title": "Pancakes for dinner" }, "lacks": ["Chili"] },
    { "why": "and writes nothing", "as": "signed", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "title": "sneak" }, "status": 403 },
    { "why": "nor sends", "as": "signed", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer is handed the whole recipe box, by title, a picture only when it is one", "as": "viewer", "do": "GET {api}/week?start=2026-09-28", "status": 200, "is": { "/recipes/0/id": "r2", "/recipes/0/title": "Chili", "/recipes/0/photo": "", "/recipes/0/tags": "dinner", "/recipes/1/id": "r1", "/recipes/1/servings": 4, "/recipes/1/photo": "data:image/jpeg;base64,AAAA" }, "absent": ["/recipes/2", "/recipes/0/ingredients_lines"] },
    { "why": "a viewer plans nothing", "as": "viewer", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "title": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "changes nothing", "as": "viewer", "do": "PUT {api}/meal/old1", "body": { "servings": 9 }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/meal/old2/delete", "body": {}, "status": 403 },
    { "why": "sends nothing", "as": "viewer", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/meal_plan/x", "body": { "title": "x" }, "status": 403 },
    { "why": "nor a grocery row", "as": "viewer", "at": "space", "do": "KV.PUT t/grocery/x", "body": { "item": "x" }, "status": 403 },
    { "why": "the plan is still as it was", "table": "meal_plan", "has": ["\"servings\":4"], "lacks": ["mine", "\"servings\":9"] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a collaborator sends the week's ingredients, skipping what is still on the list", "as": "collaborator", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 200, "is": { "/ok": true, "/sent": 2 } },
    { "why": "as rows in the grocery contract's shape, sourced from the recipe", "table": "grocery", "has": ["\"item\":\"2 cups flour\"", "\"source\":\"r1\"", "\"quantity\":\"\"", "\"category\":\"\"", "\"added_ms\":", "_created_at", "_modified_at"], "lacks": ["ghost"] },
    { "why": "sending again sends nothing", "as": "collaborator", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 200, "is": { "/sent": 0 } },
    { "why": "and the rows that were there are untouched, the bought one still bought", "table": "grocery", "has": ["\"_modified_at\":1", "\"_modified_at\":2", "\"checked\":1"] },
    { "why": "one day sends that day's", "as": "collaborator", "do": "POST {api}/send_to_grocery", "body": { "day_date": "2026-09-29" }, "status": 200, "is": { "/sent": 0 } },
    { "why": "a send names a day or a week", "as": "collaborator", "do": "POST {api}/send_to_grocery", "body": {}, "status": 400, "is": { "/error": "day_date or week_start required" } },

    { "why": "a meal needs a day", "as": "collaborator", "do": "POST {api}/meal", "body": { "day_date": "Tuesday", "title": "x" }, "status": 400, "is": { "/error": "day_date required" } },
    { "why": "and a title", "as": "collaborator", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "title": "   " }, "status": 400, "is": { "/error": "title required" } },
    { "why": "and a recipe that is there", "as": "collaborator", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "recipe_id": "ghost" }, "status": 400, "is": { "/error": "bad recipe" } },
    { "why": "a meal on a recipe takes its title", "as": "collaborator", "do": "POST {api}/meal", "body": { "day_date": "2026-09-30", "recipe_id": "r2" }, "status": 200, "is": { "/ok": true } },
    { "why": "as a row of the space starting from the contract's defaults", "table": "meal_plan", "has": ["\"day_date\":\"2026-09-30\"", "\"title\":\"Chili\"", "\"recipe_id\":\"r2\""] },
    { "why": "a freeform meal, its slot lowered", "as": "collaborator", "do": "POST {api}/meal", "body": { "day_date": "2026-10-02", "slot": " Snack ", "title": " Popcorn ", "servings": "3" }, "status": 200 },
    { "why": "and both are on the week", "as": "collaborator", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/2/title": "Chili", "/meals/2/recipe_ok": true, "/meals/2/slot": "dinner", "/meals/2/servings": 0, "/meals/2/notes": "", "/meals/4/title": "Popcorn", "/meals/4/slot": "snack", "/meals/4/servings": 3 }, "save": { "chili": "/meals/2/id", "popcorn": "/meals/4/id" } },

    { "why": "a meal's servings change over the row", "as": "collaborator", "do": "POST {api}/meal/old1", "body": { "servings": 2 }, "status": 200 },
    { "why": "which kept what it held and when it was made", "as": "viewer", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/0/id": "old1", "/meals/0/servings": 2, "/meals/0/title": "Pancakes for dinner", "/meals/0/recipe_id": "r1", "/meals/0/notes": "double batch" } },
    { "why": "in the table too", "table": "meal_plan", "has": ["\"_created_at\":5", "\"double batch\""] },
    { "why": "a new recipe re-snapshots the title", "as": "collaborator", "do": "PUT {api}/meal/old1", "body": { "recipe_id": "r2" }, "status": 200 },
    { "why": "the week says so", "as": "collaborator", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/0/title": "Chili", "/meals/0/recipe_id": "r2" } },
    { "why": "unless the same change names one", "as": "collaborator", "do": "POST {api}/meal/old1", "body": { "recipe_id": "r1", "title": "Sunday pancakes" }, "status": 200 },
    { "why": "the named title stands", "as": "collaborator", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/0/title": "Sunday pancakes", "/meals/0/recipe_id": "r1" } },
    { "why": "a meal is made just text again, its title kept", "as": "collaborator", "do": "POST {api}/meal/old1", "body": { "recipe_id": "" }, "status": 200 },
    { "why": "and its link is dropped", "as": "collaborator", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/0/title": "Sunday pancakes", "/meals/0/recipe_id": "", "/meals/0/recipe_ok": false, "/meals/0/photo": "" } },
    { "why": "a recipe that is not there is refused", "as": "collaborator", "do": "POST {api}/meal/old1", "body": { "recipe_id": "ghost" }, "status": 400, "is": { "/error": "bad recipe" } },
    { "why": "a meal moves to another day, notes and slot with it", "as": "collaborator", "do": "POST {api}/meal/{popcorn}", "body": { "day_date": "2026-10-06", "notes": "movie night", "slot": "Lunch" }, "status": 200 },
    { "why": "and is on that week now", "as": "collaborator", "do": "GET {api}/week?start=2026-10-06", "is": { "/meals/1/title": "Popcorn", "/meals/1/notes": "movie night", "/meals/1/slot": "lunch", "/meals/1/servings": 3 } },
    { "why": "a meal there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/meal/ghost", "body": { "title": "boo" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/meal/old1/nope", "body": {}, "status": 404 },
    { "why": "and nothing was made for either", "table": "meal_plan", "lacks": ["boo"] },
    { "why": "a meal is deleted", "as": "collaborator", "do": "POST {api}/meal/old2/delete", "body": {}, "status": 200 },
    { "why": "and gone from the table", "table": "meal_plan", "lacks": ["leftovers"] },

    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": true, "/is_owner": true, "/user_id": "{did:owner}" } },
    { "why": "the owner plans a meal", "as": "owner", "do": "POST {api}/meal", "body": { "day_date": "2026-10-03", "recipe_id": "r1" }, "status": 200 },
    { "why": "and sends the week, the new meal's ingredients all on the list already", "as": "owner", "do": "POST {api}/send_to_grocery", "body": { "week_start": "2026-09-28" }, "status": 200, "is": { "/sent": 2 } },
    { "why": "only Chili's were new", "table": "grocery", "has": ["\"item\":\"beans\"", "\"item\":\"onion\"", "\"source\":\"r2\""] },
    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/meal/{chili}", "body": { "servings": 6 }, "status": 200 },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },
    { "why": "a stranger sees every change", "do": "GET {api}/week?start=2026-09-28", "is": { "/meals/0/title": "Sunday pancakes", "/meals/1/title": "Chili", "/meals/1/servings": 6, "/meals/2/title": "Gone dish", "/meals/3/title": "Pancakes", "/recipes/0/title": "Chili", "/recipes/1/title": "Pancakes" }, "absent": ["/meals/4", "/recipes/2"], "lacks": ["leftovers", "Popcorn"] }
  ]
}
