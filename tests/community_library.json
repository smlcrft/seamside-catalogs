{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the owner names the library and sets its types and loans", "as": "owner", "do": "POST {api}/settings", "body": { "org_name": "Tool Shed", "item_types": ["Book", "Tool"], "borrow_options": [{ "label": "1 week", "days": 7 }, { "label": "2 weeks", "days": 14 }], "default_borrow_days": 7, "owner_only_edit": false }, "status": 200, "is": { "/prefs/org_name": "Tool Shed" } },
    { "why": "a roster Member Manager keeps", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/m1", "body": { "name": "Ada Lovelace", "role": "Member", "email": "ada@example.com", "_created_at": 2, "_modified_at": 2 }, "status": 200 },
    { "why": "an item already out on loan", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Flibrary_assets/old1", "body": { "needs_attention": 0, "_created_at": 5, "name": "Hammer", "item_type": "Tool", "notes": "Handle is loose", "checked_out_member_id": "m1", "checked_out_manual_name": "", "checked_out_at": 1000, "borrow_days": 7, "_modified_at": 6 }, "status": 200 },
    { "why": "and one on the shelf", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Flibrary_assets/old2", "body": { "needs_attention": 0, "_created_at": 7, "name": "Atlas", "item_type": "Book", "notes": "", "_modified_at": 7 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["id=\"root\"", "/lib/js/framelib.js"] },
    { "why": "its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "and its module", "do": "GET {frame}/members_list.js", "status": 200, "has": ["chooseList"] },

    { "why": "a stranger is told who they are and what the library is called", "do": "GET {api}/state", "status": 200, "is": { "/viewer/is_anon": true, "/viewer/is_owner": false, "/can_edit": false, "/can_bind": false, "/bound": null, "/prefs/org_name": "Tool Shed", "/prefs/item_types": ["Book", "Tool"], "/prefs/default_borrow_days": 7 } },
    { "why": "the library's rules and who may edit are the session's own settings, two rows", "table": "_settings", "has": ["\"id\":\"library\"", "Tool Shed", "2 weeks", "\"id\":\"prefs\"", "owner_only_edit"] },
    { "why": "which a stranger does not read at the door", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["owner_only_edit"] },
    { "why": "nor a collaborator", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["owner_only_edit"] },
    { "why": "who writes none there either", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"owner_only_edit\":false}" }, "status": 403 },
    { "why": "nor reads the library's rules there", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/library f:{id}", "status": 403, "lacks": ["Tool Shed"] },
    { "why": "nor rewrites them", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/library f:{id}", "body": { "v": "{\"org_name\":\"Mine\"}" }, "status": 403 },
    { "why": "nor does a stranger", "do": "KV.PUT t/_settings/library f:{id}", "body": { "v": "{\"org_name\":\"Mine\"}" }, "status": 403 },
    { "why": "a stranger is shown what is in and what is out, and nothing else", "do": "GET {api}/assets", "status": 200, "is": { "/anon_view": true, "/rows/0": { "_row_id": "old2", "name": "Atlas", "item_type": "Book", "status": "available", "due_at": null }, "/rows/1/name": "Hammer", "/rows/1/status": "overdue", "/rows/1/due_at": 604801000 }, "lacks": ["Ada", "Handle is loose", "checked_out", "notes", "m1"] },
    { "why": "a stranger reads no roster", "do": "GET {api}/members", "status": 200, "is": { "/rows": [] }, "lacks": ["Ada"] },
    { "why": "a stranger adds nothing", "do": "POST {api}/asset", "body": { "name": "Mine", "item_type": "Tool" }, "status": 403, "is": { "/error": "editing is restricted" } },
    { "why": "checks nothing in", "do": "POST {api}/asset/checkin", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "checks nothing out", "do": "POST {api}/asset/checkout", "body": { "row_id": "old2", "manual_name": "Me" }, "status": 403 },
    { "why": "flags nothing", "do": "POST {api}/asset/attention", "body": { "row_id": "old2", "needs_attention": true }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/asset/delete", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "chooses no list", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "sets nothing", "do": "POST {api}/settings", "body": { "org_name": "Mine", "item_types": ["X"], "borrow_options": [{ "label": "a", "days": 1 }] }, "status": 403 },
    { "why": "and finds no other method", "do": "PUT {api}/asset", "body": { "name": "Mine" }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Flibrary_assets/x", "body": { "name": "x", "item_type": "Tool" }, "status": 403 },
    { "why": "and reads no item there", "do": "KV.LIST t/_fdata%2Flibrary_assets/", "lacks": ["Hammer", "Handle is loose"] },
    { "why": "nor the roster", "do": "KV.LIST t/members/", "lacks": ["Ada"] },
    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/assets", "status": 200, "is": { "/anon_view": true }, "lacks": ["Ada", "Handle is loose"] },
    { "why": "and adds nothing", "as": "signed", "do": "POST {api}/asset", "body": { "name": "Mine", "item_type": "Tool" }, "status": 403 },
    { "why": "nothing a visitor tried landed", "table": "_fdata/library_assets", "has": ["Hammer", "Atlas", "\"checked_out_at\":1000"], "lacks": ["Mine"] },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/state", "is": { "/viewer/is_anon": false, "/viewer/user_name": "Viewer", "/can_edit": false, "/can_bind": false } },
    { "why": "a viewer sees who has what, and the notes", "as": "viewer", "do": "GET {api}/assets", "status": 200, "is": { "/rows/1/_row_id": "old1", "/rows/1/_created_at": 5, "/rows/1/notes": "Handle is loose", "/rows/1/checked_out_member_id": "m1", "/rows/1/checked_out_member_name": "", "/rows/1/checked_out_at": 1000, "/rows/1/borrow_days": 7, "/rows/1/needs_attention": false, "/rows/1/status": "overdue", "/rows/0/status": "available" }, "lacks": ["anon_view"] },
    { "why": "with no list chosen there is no roster", "as": "viewer", "do": "GET {api}/members", "is": { "/rows": [] } },
    { "why": "a viewer adds nothing", "as": "viewer", "do": "POST {api}/asset", "body": { "name": "Mine", "item_type": "Tool" }, "status": 403 },
    { "why": "checks nothing in", "as": "viewer", "do": "POST {api}/asset/checkin", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/asset/delete", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "chooses no list", "as": "viewer", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 403 },
    { "why": "sets nothing", "as": "viewer", "do": "POST {api}/settings", "body": { "org_name": "Mine", "item_types": ["X"], "borrow_options": [{ "label": "a", "days": 1 }] }, "status": 403 },

    { "why": "a list has a members list's name", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "Club Members" }, "status": 400 },
    { "why": "a collaborator chooses the list", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 200, "is": { "/bound": "members" } },
    { "why": "and may edit", "as": "collaborator", "do": "GET {api}/state", "is": { "/bound": "members", "/can_edit": true, "/can_bind": true, "/viewer/is_owner": false } },
    { "why": "the roster is read, name and role and nothing more", "as": "collaborator", "do": "GET {api}/members", "is": { "/rows": [{ "_row_id": "m1", "name": "Ada Lovelace", "role": "Member" }] }, "lacks": ["ada@example.com"] },
    { "why": "and names the borrower for a member", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/1/checked_out_member_name": "Ada Lovelace" } },
    { "why": "but never for a stranger", "do": "GET {api}/assets", "is": { "/anon_view": true }, "lacks": ["Ada"] },
    { "why": "who still reads no roster", "do": "GET {api}/members", "is": { "/rows": [] } },

    { "why": "an item needs a name", "as": "collaborator", "do": "POST {api}/asset", "body": { "name": "  ", "item_type": "Tool" }, "status": 400, "is": { "/error": "name required" } },
    { "why": "and a type the library has", "as": "collaborator", "do": "POST {api}/asset", "body": { "name": "Ladder", "item_type": "Game" }, "status": 400, "is": { "/error": "item_type not in allowed list" } },
    { "why": "an item is added", "as": "collaborator", "do": "POST {api}/asset", "body": { "name": " Ladder ", "item_type": "Tool" }, "status": 200, "save": { "new": "/row_id" } },
    { "why": "as a row of the space's frame data, stamped when it was made", "table": "_fdata/library_assets", "has": ["\"name\":\"Ladder\"", "\"item_type\":\"Tool\"", "\"needs_attention\":0", "\"notes\":\"\"", "_created_at", "_modified_at"] },
    { "why": "an item that is not there is not made", "as": "collaborator", "do": "POST {api}/asset", "body": { "row_id": "nope", "name": "Ghost", "item_type": "Tool" }, "status": 404, "is": { "/error": "item not found" } },
    { "why": "an item is edited", "as": "collaborator", "do": "POST {api}/asset", "body": { "row_id": "{new}", "name": "Tall ladder", "item_type": "Tool", "notes": "12 ft" }, "status": 200, "is": { "/row_id": "{new}" } },
    { "why": "a loan is as long as the library allows", "as": "collaborator", "do": "POST {api}/asset/checkout", "body": { "row_id": "{new}", "manual_name": "Pat", "borrow_days": 5 }, "status": 400, "is": { "/error": "borrow_days not in allowed list" } },
    { "why": "and is to somebody", "as": "collaborator", "do": "POST {api}/asset/checkout", "body": { "row_id": "{new}" }, "status": 400, "is": { "/error": "member_id or manual_name required" } },
    { "why": "and of something", "as": "collaborator", "do": "POST {api}/asset/checkout", "body": { "manual_name": "Pat" }, "status": 400, "is": { "/error": "row_id required" } },
    { "why": "an item is checked out by name", "as": "collaborator", "do": "POST {api}/asset/checkout", "body": { "row_id": "{new}", "manual_name": "Pat", "borrow_days": 14 }, "status": 200 },
    { "why": "over the row, which kept what it held", "table": "_fdata/library_assets", "has": ["\"name\":\"Tall ladder\"", "\"notes\":\"12 ft\"", "\"checked_out_manual_name\":\"Pat\"", "\"checked_out_member_id\":\"\"", "\"borrow_days\":14"], "lacks": ["Ghost", "\"name\":\"Ladder\""] },
    { "why": "a member sees who has it", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/2/name": "Tall ladder", "/rows/2/checked_out_manual_name": "Pat", "/rows/2/status": "checked_out", "/rows/2/notes": "12 ft" } },
    { "why": "a stranger sees only that it is out", "do": "GET {api}/assets", "is": { "/rows/2/name": "Tall ladder", "/rows/2/status": "checked_out" }, "lacks": ["Pat", "12 ft"] },
    { "why": "an item is flagged", "as": "collaborator", "do": "POST {api}/asset/attention", "body": { "row_id": "{new}", "needs_attention": true, "notes": "rung bent" }, "status": 200 },
    { "why": "and reads as needing attention, still out", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/2/status": "issue", "/rows/2/needs_attention": true, "/rows/2/notes": "rung bent", "/rows/2/checked_out_manual_name": "Pat" } },
    { "why": "the flag is cleared and the notes left alone", "as": "collaborator", "do": "POST {api}/asset/attention", "body": { "row_id": "{new}", "needs_attention": false }, "status": 200 },
    { "why": "which shows", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/2/status": "checked_out", "/rows/2/notes": "rung bent" } },
    { "why": "a member on the list borrows the atlas", "as": "collaborator", "do": "POST {api}/asset/checkout", "body": { "row_id": "old2", "member_id": "m1", "manual_name": "ignored" }, "status": 200 },
    { "why": "by the default loan, under their name", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/0/checked_out_member_name": "Ada Lovelace", "/rows/0/checked_out_manual_name": "", "/rows/0/borrow_days": 7, "/rows/0/status": "checked_out", "/rows/0/_created_at": 7 } },
    { "why": "the old loan comes back", "as": "collaborator", "do": "POST {api}/asset/checkin", "body": { "row_id": "old1" }, "status": 200 },
    { "why": "and the row written before keeps what it held", "as": "viewer", "do": "GET {api}/assets", "is": { "/rows/1/name": "Hammer", "/rows/1/status": "available", "/rows/1/notes": "Handle is loose", "/rows/1/checked_out_at": null, "/rows/1/borrow_days": null, "/rows/1/checked_out_member_id": "", "/rows/1/_created_at": 5 } },
    { "why": "an item goes", "as": "collaborator", "do": "POST {api}/asset/delete", "body": { "row_id": "{new}" }, "status": 204 },
    { "why": "and is gone", "table": "_fdata/library_assets", "has": ["Hammer", "Atlas"], "lacks": ["Tall ladder"] },
    { "why": "and cannot go twice", "as": "collaborator", "do": "POST {api}/asset/delete", "body": { "row_id": "{new}" }, "status": 404 },
    { "why": "there is no such act", "as": "collaborator", "do": "POST {api}/asset/lend", "body": { "row_id": "old1" }, "status": 404 },
    { "why": "nor such a method", "as": "collaborator", "do": "PUT {api}/asset", "body": { "name": "x" }, "status": 404 },

    { "why": "settings are the owner's, not a collaborator's", "as": "collaborator", "do": "POST {api}/settings", "body": { "org_name": "Mine", "item_types": ["X"], "borrow_options": [{ "label": "a", "days": 1 }] }, "status": 403, "is": { "/error": "only the frame owner can change settings" } },
    { "why": "nor an admin's", "as": "admin", "do": "POST {api}/settings", "body": { "org_name": "Mine", "item_types": ["X"], "borrow_options": [{ "label": "a", "days": 1 }] }, "status": 403 },
    { "why": "so they are as they were", "table": "_settings", "has": ["Tool Shed"], "lacks": ["Mine"] },

    { "why": "the owner keeps editing to themselves", "as": "owner", "do": "POST {api}/settings", "body": { "org_name": "Tool Shed", "item_types": ["Book", "Tool"], "borrow_options": [{ "label": "1 week", "days": 7 }], "default_borrow_days": 7, "owner_only_edit": true }, "status": 200, "is": { "/prefs/owner_only_edit": true, "/prefs/org_name": "Tool Shed" } },
    { "why": "in the session's own prefs row", "table": "_settings", "has": ["\\\"owner_only_edit\\\":true"] },
    { "why": "and a collaborator is told so", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": false, "/can_bind": true, "/prefs/owner_only_edit": true } },
    { "why": "and edits nothing", "as": "collaborator", "do": "POST {api}/asset", "body": { "name": "Saw", "item_type": "Tool" }, "status": 403, "is": { "/error": "editing is restricted" } },
    { "why": "nor an admin", "as": "admin", "do": "POST {api}/asset/checkin", "body": { "row_id": "old2" }, "status": 403 },
    { "why": "while a member still reads", "as": "viewer", "do": "GET {api}/assets", "status": 200, "is": { "/rows/0/name": "Atlas", "/rows/0/status": "checked_out" } }
  ]
}
