{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a milestone already in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_milestones/m1", "body": { "kind": "milestone", "title": "Beta", "target_ms": 1900000000000, "completed": 0, "completed_ms": 0, "sort_order": 0, "created_ms": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one it finished", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_milestones/m2", "body": { "kind": "milestone", "title": "Alpha", "target_ms": null, "completed": 1, "completed_ms": 8, "sort_order": 1, "created_ms": 6, "_created_at": 6, "_modified_at": 8 }, "status": 200 },
    { "why": "a task not started", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_tasks/t1", "body": { "milestone_id": "m1", "text": "Write docs", "state": 0, "sort_order": 0, "actor_id": "", "actor_name": "", "created_ms": 5, "completed_ms": 0, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a task someone claimed", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_tasks/t2", "body": { "milestone_id": "m1", "text": "Ship build", "state": 1, "sort_order": 1, "actor_id": "did:old", "actor_name": "Ana", "created_ms": 6, "completed_ms": 0, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "and the finished milestone's one task", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_tasks/t3", "body": { "milestone_id": "m2", "text": "Plan it", "state": 2, "sort_order": 0, "actor_id": "did:old", "actor_name": "Ana", "created_ms": 6, "completed_ms": 7, "_created_at": 6, "_modified_at": 7 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Roadmap", "/lib/js/framelib.js", "/dyn/frame-prefs.css"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the roadmap, oldest shape and all", "do": "GET {api}/state", "status": 200, "is": { "/milestones/0/id": "m1", "/milestones/0/title": "Beta", "/milestones/0/target_ms": 1900000000000, "/milestones/1/id": "m2", "/milestones/1/completed": 1, "/tasks/0/id": "t1", "/tasks/1/id": "t2", "/tasks/1/actor_name": "Ana", "/tasks/1/state": 1, "/tasks/2/id": "t3", "/tasks/2/completed_ms": 7 }, "absent": ["/tasks/0/actor_id", "/tasks/3", "/milestones/4"] },
    { "why": "with the two buckets shown as they will be, though nobody has written them", "do": "GET {api}/state", "is": { "/milestones/2/id": "bucket:backburner", "/milestones/2/title": "Back Burner", "/milestones/3/id": "bucket:maybelater", "/milestones/3/kind": "maybelater" } },
    { "why": "which a read did not write", "table": "_fdata/roadmap_milestones", "lacks": ["bucket:"] },
    { "why": "a collaborator names the project and gives it a link", "as": "collaborator", "do": "POST {api}/settings", "body": { "name": "Spring launch", "links": [{ "label": "Docs", "url": "https://example.com/docs" }] }, "status": 200 },
    { "why": "which a stranger is shown", "do": "GET {api}/state", "status": 200, "is": { "/meta/name": "Spring launch", "/meta/overview": "", "/meta/links/0/label": "Docs", "/meta/links/0/url": "https://example.com/docs" } },
    { "why": "a stranger renames nothing", "do": "POST {api}/settings", "body": { "name": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "adds no milestone", "do": "POST {api}/milestone/add", "body": { "title": "Sneak" }, "status": 403 },
    { "why": "completes none", "do": "POST {api}/milestone/m1", "body": { "completed": 1 }, "status": 403 },
    { "why": "deletes none", "do": "POST {api}/milestone/delete/m1", "body": {}, "status": 403 },
    { "why": "adds no task", "do": "POST {api}/task/add", "body": { "milestone_id": "m1", "text": "sneak" }, "status": 403 },
    { "why": "claims none", "do": "POST {api}/task/t1", "body": { "state": 1 }, "status": 403 },
    { "why": "reorders none", "do": "POST {api}/tasks/reorder", "body": { "milestone_id": "m1", "ids": ["t2", "t1"] }, "status": 403 },
    { "why": "deletes no task", "do": "POST {api}/task/delete/t1", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Froadmap_tasks/x", "body": { "text": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Froadmap_tasks/", "lacks": ["Write docs", "Ana"] },
    { "why": "nor writes a setting", "do": "KV.PUT t/_fdata%2Froadmap_settings/roadmap_name", "body": { "v": "\"Mine\"" }, "status": 403 },
    { "why": "the roadmap is as it was", "table": "_fdata/roadmap_tasks", "has": ["Write docs", "Ship build", "Plan it"], "lacks": ["sneak", "\"x\""] },
    { "why": "and its name", "table": "_fdata/roadmap_settings", "has": ["Spring launch"], "lacks": ["Mine"] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the roadmap", "as": "signed", "do": "GET {api}/state", "status": 200, "is": { "/tasks/0/text": "Write docs" } },
    { "why": "and changes nothing", "as": "signed", "do": "POST {api}/task/t1", "body": { "state": 2 }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the roadmap", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/meta/name": "Spring launch", "/tasks/1/text": "Ship build" } },
    { "why": "a viewer renames nothing", "as": "viewer", "do": "POST {api}/settings", "body": { "name": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "adds no milestone", "as": "viewer", "do": "POST {api}/milestone/add", "body": { "title": "Mine" }, "status": 403 },
    { "why": "dates none", "as": "viewer", "do": "POST {api}/milestone/m1", "body": { "target_ms": 5 }, "status": 403 },
    { "why": "adds no task", "as": "viewer", "do": "POST {api}/task/add", "body": { "milestone_id": "m1", "text": "mine" }, "status": 403 },
    { "why": "claims none", "as": "viewer", "do": "POST {api}/task/t1", "body": { "state": 1 }, "status": 403 },
    { "why": "deletes none", "as": "viewer", "do": "POST {api}/task/delete/t1", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Froadmap_tasks/x", "body": { "text": "x" }, "status": 403 },
    { "why": "nothing a viewer tried landed", "table": "_fdata/roadmap_tasks", "lacks": ["mine", "\"x\""] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a collaborator renames the project and sets its links, an unsafe one dropped", "as": "collaborator", "do": "POST {api}/settings", "body": { "name": "  Summer launch ", "overview": "The big one", "links": [{ "label": "Board", "url": " https://example.com/board " }, { "label": "Bad", "url": "javascript:alert(1)" }, { "label": "", "url": "https://example.com/x" }] }, "status": 200, "is": { "/meta/name": "Summer launch", "/meta/overview": "The big one", "/meta/links/0/label": "Board", "/meta/links/0/url": "https://example.com/board" }, "absent": ["/meta/links/1"] },
    { "why": "each a row of the space's roadmap_settings, its value JSON under v", "table": "_fdata/roadmap_settings", "has": ["roadmap_name", "Summer launch", "roadmap_overview", "roadmap_links", "https://example.com/board", "roadmap_updated_ms", "_created_at", "_modified_at"], "lacks": ["javascript:", "Spring launch"] },
    { "why": "which a collaborator reads at the door, as the space's frame data", "as": "collaborator", "at": "space", "do": "KV.GET t/_fdata%2Froadmap_settings/roadmap_name", "status": 200, "has": ["Summer launch"] },
    { "why": "an editor's first write made the two buckets, from the schema's defaults", "table": "_fdata/roadmap_milestones", "has": ["bucket:backburner", "bucket:maybelater", "\"kind\":\"backburner\"", "\"title\":\"Back Burner\"", "\"sort_order\":1000000", "\"completed_ms\":0", "_created_at"] },

    { "why": "a milestone is added after the real ones, ahead of the buckets", "as": "collaborator", "do": "POST {api}/milestone/add", "body": { "title": " Launch ", "target_ms": 1950000000000 }, "status": 200, "is": { "/milestones/2/title": "Launch", "/milestones/2/sort_order": 2, "/milestones/2/target_ms": 1950000000000, "/milestones/2/completed": 0, "/milestones/2/completed_ms": 0, "/milestones/3/id": "bucket:backburner" }, "save": { "launch": "/milestones/2/id" } },
    { "why": "as a row of the space's frame data", "table": "_fdata/roadmap_milestones", "has": ["\"title\":\"Launch\"", "\"kind\":\"milestone\"", "\"created_ms\":"] },
    { "why": "an untitled one is named so", "as": "collaborator", "do": "POST {api}/milestone/add", "body": { "title": "  " }, "status": 200, "is": { "/milestones/3/title": "Untitled milestone", "/milestones/3/sort_order": 3, "/milestones/3/target_ms": null }, "save": { "untitled": "/milestones/3/id" } },

    { "why": "a task is added last in its milestone", "as": "collaborator", "do": "POST {api}/task/add", "body": { "milestone_id": "m1", "text": "  Test it  " }, "status": 200, "is": { "/tasks/2/text": "Test it", "/tasks/2/milestone_id": "m1", "/tasks/2/state": 0, "/tasks/2/sort_order": 2, "/tasks/2/actor_name": "" }, "save": { "test": "/tasks/2/id" } },
    { "why": "as a row with every default the schema gives", "table": "_fdata/roadmap_tasks", "has": ["\"text\":\"Test it\"", "\"actor_id\":\"\"", "\"completed_ms\":0", "\"created_ms\":", "_created_at", "_modified_at"] },
    { "why": "an empty task is refused", "as": "collaborator", "do": "POST {api}/task/add", "body": { "milestone_id": "m1", "text": "   " }, "status": 400, "is": { "/error": "text required" } },
    { "why": "and one for no milestone", "as": "collaborator", "do": "POST {api}/task/add", "body": { "milestone_id": "ghost", "text": "Lost" }, "status": 400, "is": { "/error": "bad milestone" } },
    { "why": "a pasted list is a task a line, and reopens the finished milestone it lands in", "as": "collaborator", "do": "POST {api}/task/add", "body": { "milestone_id": "m2", "texts": ["Retro", " ", "Write up"] }, "status": 200, "is": { "/milestones/1/id": "m2", "/milestones/1/completed": 0, "/milestones/1/completed_ms": 0 } },
    { "why": "each its own row, in order after the one there", "table": "_fdata/roadmap_tasks", "has": ["\"text\":\"Retro\"", "\"text\":\"Write up\""] },

    { "why": "a milestone with open tasks will not complete", "as": "collaborator", "do": "POST {api}/milestone/m1", "body": { "completed": 1 }, "status": 409, "is": { "/error": "finish all tasks before completing this milestone", "/open": 3 } },
    { "why": "a task is claimed, credited to whoever claimed it", "as": "collaborator", "do": "POST {api}/task/t1", "body": { "state": 1 }, "status": 200, "is": { "/tasks/0/state": 1, "/tasks/0/actor_name": "Collaborator", "/tasks/0/completed_ms": 0 } },
    { "why": "by their ID in the row", "table": "_fdata/roadmap_tasks", "has": ["\"actor_id\":\"{did:collaborator}\""] },
    { "why": "a state past complete is held to complete", "as": "collaborator", "do": "POST {api}/task/t1", "body": { "state": 9 }, "status": 200, "is": { "/tasks/0/state": 2, "/tasks/0/actor_name": "Collaborator" } },
    { "why": "back to unstarted clears the credit", "as": "collaborator", "do": "POST {api}/task/t1", "body": { "state": 0 }, "status": 200, "is": { "/tasks/0/state": 0, "/tasks/0/actor_name": "", "/tasks/0/completed_ms": 0 } },
    { "why": "an old task is renamed, keeping who claimed it", "as": "collaborator", "do": "POST {api}/task/t2", "body": { "text": " Ship the build " }, "status": 200, "is": { "/tasks/1/text": "Ship the build", "/tasks/1/state": 1, "/tasks/1/actor_name": "Ana" } },
    { "why": "over the row, which kept what it held and when it was made", "table": "_fdata/roadmap_tasks", "has": ["\"actor_id\":\"did:old\"", "\"created_ms\":6", "\"_created_at\":6"], "lacks": ["\"text\":\"Ship build\""] },
    { "why": "a task there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/task/ghost", "body": { "state": 1 }, "status": 404, "is": { "/error": "not found" } },

    { "why": "every task of a milestone done", "as": "collaborator", "do": "POST {api}/task/t1", "body": { "state": 2 }, "status": 200 },
    { "why": "and the next", "as": "collaborator", "do": "POST {api}/task/t2", "body": { "state": 2 }, "status": 200 },
    { "why": "and the last", "as": "collaborator", "do": "POST {api}/task/{test}", "body": { "state": 2 }, "status": 200, "is": { "/tasks/2/state": 2 } },
    { "why": "the milestone completes", "as": "collaborator", "do": "POST {api}/milestone/m1", "body": { "completed": 1 }, "status": 200, "is": { "/milestones/0/id": "m1", "/milestones/0/completed": 1 } },
    { "why": "reopening one of its tasks reopens it", "as": "collaborator", "do": "POST {api}/task/{test}", "body": { "state": 1 }, "status": 200, "is": { "/milestones/0/completed": 0, "/milestones/0/completed_ms": 0 } },
    { "why": "it is renamed and redated", "as": "collaborator", "do": "POST {api}/milestone/m1", "body": { "title": " Beta two ", "target_ms": null }, "status": 200, "is": { "/milestones/0/title": "Beta two", "/milestones/0/target_ms": null } },
    { "why": "over the row, which kept when it was made", "table": "_fdata/roadmap_milestones", "has": ["\"title\":\"Beta two\"", "\"_created_at\":5"], "lacks": ["\"title\":\"Beta\"}"] },
    { "why": "a milestone there is no such thing as is refused", "as": "collaborator", "do": "POST {api}/milestone/ghost", "body": { "title": "x" }, "status": 404 },

    { "why": "a bucket keeps its name and takes no date", "as": "collaborator", "do": "POST {api}/milestone/bucket:backburner", "body": { "title": "Mine", "target_ms": 5, "completed": 1 }, "status": 200, "is": { "/milestones/4/id": "bucket:backburner", "/milestones/4/title": "Back Burner", "/milestones/4/target_ms": null, "/milestones/4/completed": 0 } },
    { "why": "and is never deleted", "as": "collaborator", "do": "POST {api}/milestone/delete/bucket:maybelater", "body": {}, "status": 400, "is": { "/error": "buckets can't be deleted" } },
    { "why": "a task is moved to the back burner, last there", "as": "collaborator", "do": "POST {api}/task/t2", "body": { "milestone_id": "bucket:backburner" }, "status": 200, "is": { "/tasks/0/id": "t2", "/tasks/0/milestone_id": "bucket:backburner", "/tasks/0/sort_order": 0 } },
    { "why": "and not to nowhere", "as": "collaborator", "do": "POST {api}/task/t2", "body": { "milestone_id": "ghost" }, "status": 400, "is": { "/error": "bad milestone" } },
    { "why": "a list is reordered into a milestone, an unknown id passed over", "as": "collaborator", "do": "POST {api}/tasks/reorder", "body": { "milestone_id": "m1", "ids": ["{test}", "ghost", "t2", "t1"] }, "status": 200, "is": { "/tasks/0/id": "{test}", "/tasks/0/sort_order": 0, "/tasks/1/id": "t2", "/tasks/1/milestone_id": "m1", "/tasks/1/sort_order": 2, "/tasks/2/id": "t1", "/tasks/2/sort_order": 3 } },
    { "why": "and nothing was made for it", "table": "_fdata/roadmap_tasks", "lacks": ["ghost"] },
    { "why": "into no milestone is refused", "as": "collaborator", "do": "POST {api}/tasks/reorder", "body": { "milestone_id": "ghost", "ids": ["t1"] }, "status": 400 },

    { "why": "a task is deleted", "as": "collaborator", "do": "POST {api}/task/delete/t1", "body": {}, "status": 200, "lacks": ["Write docs"] },
    { "why": "and gone from the table", "table": "_fdata/roadmap_tasks", "lacks": ["Write docs"] },
    { "why": "a task there is no such thing as is not deleted", "as": "collaborator", "do": "POST {api}/task/delete/ghost", "body": {}, "status": 404 },
    { "why": "a milestone is deleted with its tasks", "as": "collaborator", "do": "POST {api}/milestone/delete/m2", "body": {}, "status": 200, "lacks": ["Alpha", "Plan it", "Retro", "Write up"] },
    { "why": "gone from both tables", "table": "_fdata/roadmap_tasks", "lacks": ["Plan it", "Retro", "Write up"] },
    { "why": "and the milestone's", "table": "_fdata/roadmap_milestones", "lacks": ["Alpha"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/task/add", "body": { "milestone_id": "{untitled}", "text": "Pick a name" }, "status": 200, "has": ["Pick a name"] },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner claims a task, credited by their ID", "as": "owner", "do": "POST {api}/task/{test}", "body": { "state": 2 }, "status": 200 },
    { "why": "in the row", "table": "_fdata/roadmap_tasks", "has": ["\"actor_id\":\"{did:owner}\""] },
    { "why": "and deletes a milestone", "as": "owner", "do": "POST {api}/milestone/delete/{launch}", "body": {}, "status": 200, "lacks": ["\"Launch\""] },
    { "why": "a stranger sees every change", "do": "GET {api}/state", "is": { "/meta/name": "Summer launch", "/milestones/0/title": "Beta two", "/milestones/1/title": "Untitled milestone" }, "has": ["Pick a name", "Ship the build"], "lacks": ["Alpha", "Write docs", "Launch\""] }
  ]
}
