{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a sheet an installed copy left in the space", "as": "collaborator", "at": "space", "do": "PUT /files/Watercolor%20Studio/Old%20sheet/strokes.json", "body": { "strokes": [
      { "id": "s_old1", "brush": "round", "pigment": "#2f4b9b", "water": 0.52, "points": [[0.2, 0.3, 1], [0.4, 0.35, 1.1]], "seed": 12345, "created_at": 5, "created_by_user_id": "{did:collaborator}", "created_by_user_name": "Collaborator" },
      { "id": "s_old2", "brush": "wash", "pigment": "#f2dd4e", "water": 0.86, "points": [[0.6, 0.6, 1]], "seed": 777, "created_at": 6, "created_by_user_id": "did:dht:somebodyelse", "created_by_user_name": "Sam" }
    ] }, "status": 200 },
    { "why": "the session's sheet key, as installed copies kept it", "as": "collaborator", "at": "space", "do": "KV.PUT sheet f:{id}", "body": "Watercolor Studio/Old sheet", "status": 200 },
    { "why": "and its prefs key", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": { "title": "Harbour", "paper": "kraft", "guide": "koi", "aspect": "square" }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["ws-loading", "/dyn/frame-prefs.css"] },
    { "why": "and its script", "do": "GET {frame}/index.js", "status": 200, "has": ["/lib/js/framelib.js", "/api/state"], "lacks": ["__peer"] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200, "has": ["ws-root"] },

    { "why": "a stranger is shown the sheet the session kept, with its prefs", "do": "GET {api}/state", "status": 200, "is": { "/sheet": "Watercolor Studio/Old sheet", "/prefs": { "title": "Harbour", "paper": "kraft", "guide": "koi", "aspect": "square" }, "/strokes/0/id": "s_old1", "/strokes/1/id": "s_old2", "/strokes/1/created_by_user_name": "Sam", "/can_edit": false, "/is_owner": false, "/me/user_id": "", "/me/user_name": "anon" } },
    { "why": "the old prefs key moved into the session's own settings, its value JSON under v", "table": "__fc_settings", "has": ["\"v\":\"{\\\"title\\\":\\\"Harbour\\\",\\\"paper\\\":\\\"kraft\\\",\\\"guide\\\":\\\"koi\\\",\\\"aspect\\\":\\\"square\\\"}\"", "_created_at", "_modified_at"] },
    { "why": "and is gone from the door", "as": "collaborator", "at": "space", "do": "KV.GET prefs f:{id}", "status": 404 },
    { "why": "the sheet stays the session's key", "as": "collaborator", "at": "space", "do": "KV.GET sheet f:{id}", "status": 200, "has": ["Watercolor Studio/Old sheet"] },
    { "why": "a stranger reads no setting at the door", "do": "KV.GET t/__fc_settings/prefs f:{id}", "status": 403 },
    { "why": "a collaborator reads none", "as": "collaborator", "at": "space", "do": "KV.GET t/__fc_settings/prefs f:{id}", "status": 403 },
    { "why": "nor writes the owner's", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/prefs f:{id}", "body": { "v": "{\"paper\":\"dusk\"}" }, "status": 403 },
    { "why": "and a prefs key written at the door now changes nothing", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": { "title": "Mine", "paper": "dusk" }, "status": 200 },
    { "why": "the session keeps its own", "do": "GET {api}/state", "is": { "/prefs": { "title": "Harbour", "paper": "kraft", "guide": "koi", "aspect": "square" } } },
    { "why": "there is no picture yet", "do": "GET {api}/picture", "status": 404, "is": { "/error": "no picture yet" } },
    { "why": "a stranger lays down no stroke", "do": "POST {api}/stroke/add", "body": { "brush": "round", "pigment": "#123456", "water": 0.5, "points": [[0.1, 0.1, 1]], "seed": 1 }, "status": 403, "is": { "/error": "read-only" } },
    { "why": "removes none", "do": "POST {api}/stroke/delete", "body": { "ids": ["s_old1"] }, "status": 403 },
    { "why": "clears nothing", "do": "POST {api}/clear", "status": 403 },
    { "why": "sets nothing", "do": "POST {api}/settings", "body": { "title": "Mine" }, "status": 403 },
    { "why": "sends no picture", "do": "POST {api}/picture?last=s_old2", "body": "not a picture", "status": 403 },
    { "why": "an unknown route is refused as read-only too", "do": "GET {api}/nothing", "status": 403 },
    { "why": "someone signed in and on no roster watches too", "as": "signed", "do": "GET {api}/state", "status": 200, "is": { "/can_edit": false, "/is_owner": false, "/me/user_id": "{did:signed}" } },
    { "why": "and paints nothing", "as": "signed", "do": "POST {api}/stroke/add", "body": { "brush": "round", "pigment": "#123456", "points": [[0.1, 0.1, 1]] }, "status": 403 },

    { "why": "a viewer is a member who watches", "as": "viewer", "do": "GET {api}/state", "is": { "/can_edit": false, "/is_owner": false, "/strokes/0/id": "s_old1" } },
    { "why": "a viewer paints nothing", "as": "viewer", "do": "POST {api}/stroke/add", "body": { "brush": "round", "pigment": "#123456", "points": [[0.1, 0.1, 1]] }, "status": 403 },
    { "why": "undoes nothing", "as": "viewer", "do": "POST {api}/stroke/delete", "body": { "ids": ["s_old1"] }, "status": 403 },
    { "why": "clears nothing", "as": "viewer", "do": "POST {api}/clear", "status": 403 },
    { "why": "sets nothing", "as": "viewer", "do": "POST {api}/settings", "body": { "paper": "rough" }, "status": 403 },
    { "why": "sends no picture", "as": "viewer", "do": "POST {api}/picture?last=s_old2", "body": "not a picture", "status": 403 },

    { "why": "a collaborator may paint", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": true, "/is_owner": false, "/me/user_id": "{did:collaborator}" } },
    { "why": "a stroke that is not one is refused", "as": "collaborator", "do": "POST {api}/stroke/add", "body": { "brush": "sponge", "pigment": "#123456", "points": [[0.1, 0.1, 1]] }, "status": 400, "is": { "/error": "invalid stroke" } },
    { "why": "as is paint with no colour", "as": "collaborator", "do": "POST {api}/stroke/add", "body": { "brush": "round", "points": [[0.1, 0.1, 1]] }, "status": 400 },
    { "why": "a stroke lands, stamped with who painted it", "as": "collaborator", "do": "POST {api}/stroke/add", "body": { "brush": "flat", "pigment": "#1D7A6C", "water": 3, "points": [[0.1, 0.2, 1], [2, 0.4, 9]], "seed": -5 }, "status": 200, "save": { "s1": "/stroke/id" }, "is": { "/ok": true, "/stroke/brush": "flat", "/stroke/pigment": "#1d7a6c", "/stroke/water": 1, "/stroke/points": [[0.1, 0.2, 1], [1.2, 0.4, 4]], "/stroke/created_by_user_id": "{did:collaborator}", "/stroke/created_by_user_name": "Collaborator" } },
    { "why": "clean water carries no pigment", "as": "collaborator", "do": "POST {api}/stroke/add", "body": { "brush": "lift", "water": 0.5, "points": [[0.5, 0.5, 1]], "seed": 9 }, "status": 200, "save": { "lift": "/stroke/id" }, "is": { "/stroke/pigment": "#000000" } },
    { "why": "and both are on the sheet, after what was there", "do": "GET {api}/state", "is": { "/strokes/0/id": "s_old1", "/strokes/1/id": "s_old2", "/strokes/2/id": "{s1}", "/strokes/3/id": "{lift}", "/sheet": "Watercolor Studio/Old sheet" } },
    { "why": "kept as the sheet's file in the space, in the shape installed copies hold", "as": "collaborator", "at": "space", "do": "GET /files/Watercolor%20Studio/Old%20sheet/strokes.json", "status": 200, "has": ["\"id\":\"s_old1\"", "\"id\":\"{s1}\"", "\"seed\":9", "\"created_by_user_name\":\"Collaborator\""] },
    { "why": "a collaborator undoes their own stroke", "as": "collaborator", "do": "POST {api}/stroke/delete", "body": { "ids": ["{s1}", "s_old1"] }, "status": 200, "is": { "/deleted": ["s_old1", "{s1}"] } },
    { "why": "and not somebody else's", "as": "collaborator", "do": "POST {api}/stroke/delete", "body": { "ids": ["s_old2"] }, "status": 200, "is": { "/deleted": [] } },
    { "why": "a picture that is not a PNG is refused", "as": "collaborator", "do": "POST {api}/picture?last={lift}", "body": "not a picture", "status": 415 },
    { "why": "a collaborator sets nothing", "as": "collaborator", "do": "POST {api}/settings", "body": { "paper": "rough" }, "status": 403, "is": { "/error": "owner only" } },
    { "why": "clears nothing", "as": "collaborator", "do": "POST {api}/clear", "status": 403 },
    { "why": "an admin paints but is not the owner", "as": "admin", "do": "POST {api}/settings", "body": { "paper": "rough" }, "status": 403 },
    { "why": "the sheet holds what is left", "do": "GET {api}/state", "is": { "/strokes/0/id": "s_old2", "/strokes/1/id": "{lift}" }, "absent": ["/strokes/2"] },

    { "why": "the owner may set things", "as": "owner", "do": "GET {api}/state", "is": { "/can_edit": true, "/is_owner": true } },
    { "why": "the owner changes the paper and the title, and a guide there is none of stays", "as": "owner", "do": "POST {api}/settings", "body": { "title": "  Harbour at dusk ", "paper": "rough", "guide": "dragon" }, "status": 200, "is": { "/prefs": { "title": "Harbour at dusk", "paper": "rough", "guide": "koi", "aspect": "square" } } },
    { "why": "which everyone reads", "do": "GET {api}/state", "is": { "/prefs/title": "Harbour at dusk", "/prefs/paper": "rough" } },
    { "why": "kept as the session's prefs setting", "table": "__fc_settings", "has": ["Harbour at dusk", "\\\"paper\\\":\\\"rough\\\""] },
    { "why": "the owner removes anybody's stroke", "as": "owner", "do": "POST {api}/stroke/delete", "body": { "ids": ["s_old2"] }, "status": 200, "is": { "/deleted": ["s_old2"] } },
    { "why": "and clears the sheet", "as": "owner", "do": "POST {api}/clear", "status": 200 },
    { "why": "which is empty, in the folder it had", "do": "GET {api}/state", "is": { "/strokes": [], "/sheet": "Watercolor Studio/Old sheet" } },
    { "why": "its file is gone from the space", "as": "collaborator", "at": "space", "do": "GET /files/Watercolor%20Studio/Old%20sheet/strokes.json", "status": 404 },
    { "why": "a picture of a sheet with nothing on it is refused", "as": "collaborator", "do": "POST {api}/picture?last={lift}", "body": "not a picture", "status": 415 },
    { "why": "the next stroke starts the file again", "as": "collaborator", "do": "POST {api}/stroke/add", "body": { "brush": "detail", "pigment": "#262524", "points": [[0.3, 0.3, 1]] }, "status": 200, "save": { "s2": "/stroke/id" } },
    { "why": "in the same folder", "as": "collaborator", "at": "space", "do": "GET /files/Watercolor%20Studio/Old%20sheet/strokes.json", "status": 200, "has": ["{s2}"], "lacks": ["s_old2"] }
  ]
}
