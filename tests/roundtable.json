{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the owner names the roundtable", "as": "owner", "do": "POST {api}/settings", "body": { "title": "Town hall" }, "status": 200 },
    { "why": "a message already in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froundtable_messages/old1", "body": { "user_id": "{did:collaborator}", "user_name": "Collaborator", "body": "An old hello.", "created_at": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "an item already there", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froundtable_items/olditem", "body": { "kind": "positive", "user_id": "{did:collaborator}", "user_name": "Collaborator", "body": "An old idea.", "created_at": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "and its author's vote", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Froundtable_votes/olditem:{did:collaborator}", "body": { "item_id": "olditem", "user_id": "{did:collaborator}", "user_name": "Collaborator", "created_at": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["rt-loading"], "lacks": ["<form", "onSubmit"] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "a stranger follows along, named nobody", "do": "GET {api}/state", "status": 200, "is": { "/can_participate": false, "/can_edit_settings": false, "/is_member": false, "/me/user_id": "", "/me/is_owner": false, "/prefs/title": "Town hall", "/prefs/positive_label": "Positives", "/prefs/public_to_space_viewers": false, "/messages/0/id": "old1", "/messages/0/body": "An old hello.", "/positives/0/id": "olditem", "/positives/0/votes": 1, "/positives/0/i_voted": false, "/negatives": [] } },
    { "why": "a stranger says nothing", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403, "is": { "/error": "read-only access" } },
    { "why": "adds nothing", "do": "POST {api}/item-add", "body": { "kind": "positive", "body": "mine" }, "status": 403 },
    { "why": "votes for nothing", "do": "POST {api}/item-vote", "body": { "id": "olditem" }, "status": 403 },
    { "why": "deletes no item", "do": "POST {api}/item-delete", "body": { "id": "olditem" }, "status": 403 },
    { "why": "nor a message", "do": "POST {api}/delete-message", "body": { "id": "old1" }, "status": 403 },
    { "why": "names nothing", "do": "POST {api}/settings", "body": { "title": "Mine", "public_to_space_viewers": true }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Froundtable_messages/x", "body": { "body": "x" }, "status": 403 },
    { "why": "nor reads the setting that says who may take part", "do": "KV.GET t/_settings/roundtable_public_to_space_viewers f:{id}", "status": 403 },
    { "why": "a route there is none of", "do": "POST {api}/nothing", "body": {}, "status": 404 },
    { "why": "someone signed in and on no roster only reads", "as": "signed", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "and is named to themselves", "as": "signed", "do": "GET {api}/state", "is": { "/can_participate": false, "/is_member": false, "/me/user_id": "{did:signed}" } },

    { "why": "a viewer is a member who only reads, while the toggle is off", "as": "viewer", "do": "GET {api}/state", "is": { "/can_participate": false, "/is_member": true, "/can_edit_settings": false } },
    { "why": "a viewer says nothing", "as": "viewer", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "votes for nothing", "as": "viewer", "do": "POST {api}/item-vote", "body": { "id": "olditem" }, "status": 403 },
    { "why": "adds nothing", "as": "viewer", "do": "POST {api}/item-add", "body": { "kind": "negative", "body": "mine" }, "status": 403 },
    { "why": "sets nothing", "as": "viewer", "do": "POST {api}/settings", "body": { "public_to_space_viewers": true }, "status": 403 },
    { "why": "nothing was written by any of that", "table": "_fdata/roundtable_messages", "has": ["An old hello."], "lacks": ["\"hi\""] },

    { "why": "a collaborator takes part, and their old vote is theirs", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_participate": true, "/can_edit_settings": false, "/positives/0/i_voted": true, "/me/user_name": "Collaborator" } },
    { "why": "sends a message", "as": "collaborator", "do": "POST {api}/send", "body": { "body": "  Hello all.  " }, "status": 200, "is": { "/ok": true }, "save": { "msg": "/id" } },
    { "why": "but not an empty one", "as": "collaborator", "do": "POST {api}/send", "body": { "body": "   " }, "status": 400, "is": { "/error": "body required" } },
    { "why": "as a row of the space's frame data", "table": "_fdata/roundtable_messages", "has": ["\"body\":\"Hello all.\"", "\"user_name\":\"Collaborator\"", "{did:collaborator}", "_created_at", "_modified_at", "An old hello."] },
    { "why": "after the old one", "do": "GET {api}/state", "is": { "/messages/0/id": "old1", "/messages/1/id": "{msg}", "/messages/1/body": "Hello all.", "/messages/1/user_id": "{did:collaborator}" } },
    { "why": "an item needs a list", "as": "collaborator", "do": "POST {api}/item-add", "body": { "kind": "neutral", "body": "x" }, "status": 400, "is": { "/error": "invalid kind" } },
    { "why": "and words", "as": "collaborator", "do": "POST {api}/item-add", "body": { "kind": "negative", "body": "" }, "status": 400 },
    { "why": "an item is added", "as": "collaborator", "do": "POST {api}/item-add", "body": { "kind": "negative", "body": "The door sticks." }, "status": 200, "save": { "item": "/id" } },
    { "why": "as a row", "table": "_fdata/roundtable_items", "has": ["\"kind\":\"negative\"", "\"body\":\"The door sticks.\"", "_created_at", "_modified_at"] },
    { "why": "with its author's vote, one row for the two of them", "table": "_fdata/roundtable_votes", "has": ["{item}:{did:collaborator}", "\"item_id\":\"{item}\"", "\"user_name\":\"Collaborator\"", "_created_at"] },
    { "why": "which a stranger sees counted and not as their own", "do": "GET {api}/state", "is": { "/negatives/0/id": "{item}", "/negatives/0/votes": 1, "/negatives/0/i_voted": false } },

    { "why": "an admin adds a vote", "as": "admin", "do": "POST {api}/item-vote", "body": { "id": "{item}" }, "status": 200, "is": { "/votes": 2, "/i_voted": true } },
    { "why": "and takes it back", "as": "admin", "do": "POST {api}/item-vote", "body": { "id": "{item}" }, "status": 200, "is": { "/votes": 1, "/i_voted": false } },
    { "why": "leaving the author's", "table": "_fdata/roundtable_votes", "has": ["{item}:{did:collaborator}"], "lacks": ["{item}:{did:admin}"] },
    { "why": "nobody votes for what is not there", "as": "admin", "do": "POST {api}/item-vote", "body": { "id": "nope" }, "status": 404 },
    { "why": "nor with no id", "as": "admin", "do": "POST {api}/item-vote", "body": {}, "status": 400 },
    { "why": "an admin is not the owner: another's message stays", "as": "admin", "do": "POST {api}/delete-message", "body": { "id": "{msg}" }, "status": 403, "is": { "/error": "forbidden" } },
    { "why": "and another's item", "as": "admin", "do": "POST {api}/item-delete", "body": { "id": "{item}" }, "status": 403 },
    { "why": "and the settings", "as": "admin", "do": "POST {api}/settings", "body": { "title": "Mine" }, "status": 403, "is": { "/error": "owner only" } },
    { "why": "which stayed as they were", "do": "GET {api}/state", "is": { "/prefs/title": "Town hall" } },

    { "why": "the owner turns the toggle on", "as": "owner", "do": "POST {api}/settings", "body": { "title": "Town hall", "public_to_space_viewers": true }, "status": 200, "is": { "/prefs/title": "Town hall", "/prefs/public_to_space_viewers": true } },
    { "why": "in the session's own settings", "table": "_settings", "has": ["roundtable_public_to_space_viewers", "\"v\":\"true\""] },
    { "why": "which a collaborator does not write at the door", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/roundtable_public_to_space_viewers f:{id}", "body": { "v": "false" }, "status": 403 },
    { "why": "the title is the space's frame data, beside the lists", "table": "_fdata/roundtable_settings", "has": ["roundtable_title", "Town hall", "roundtable_positive_label"], "lacks": ["roundtable_public_to_space_viewers"] },
    { "why": "which a collaborator reads at the door", "as": "collaborator", "at": "space", "do": "KV.GET t/_fdata%2Froundtable_settings/roundtable_title", "status": 200, "has": ["Town hall"] },
    { "why": "lets a viewer take part", "as": "viewer", "do": "GET {api}/state", "is": { "/can_participate": true, "/prefs/public_to_space_viewers": true } },
    { "why": "a viewer votes", "as": "viewer", "do": "POST {api}/item-vote", "body": { "id": "{item}" }, "status": 200, "is": { "/votes": 2, "/i_voted": true } },
    { "why": "and speaks", "as": "viewer", "do": "POST {api}/send", "body": { "body": "From a viewer." }, "status": 200, "save": { "vmsg": "/id" } },
    { "why": "and removes their own", "as": "viewer", "do": "POST {api}/delete-message", "body": { "id": "{vmsg}" }, "status": 200 },
    { "why": "but nobody else's", "as": "viewer", "do": "POST {api}/delete-message", "body": { "id": "{msg}" }, "status": 403 },
    { "why": "a stranger still only reads", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "and so does someone on no roster", "as": "signed", "do": "POST {api}/item-vote", "body": { "id": "{item}" }, "status": 403 },

    { "why": "an author removes their item", "as": "collaborator", "do": "POST {api}/item-delete", "body": { "id": "{item}" }, "status": 200 },
    { "why": "and its votes go with it", "table": "_fdata/roundtable_votes", "has": ["olditem:{did:collaborator}"], "lacks": ["{item}"] },
    { "why": "it is gone", "as": "collaborator", "do": "POST {api}/item-delete", "body": { "id": "{item}" }, "status": 404 },
    { "why": "an old item goes the same way", "as": "collaborator", "do": "POST {api}/item-delete", "body": { "id": "olditem" }, "status": 200 },
    { "why": "with the vote that was already there", "table": "_fdata/roundtable_votes", "lacks": ["olditem"] },
    { "why": "an author removes their message", "as": "collaborator", "do": "POST {api}/delete-message", "body": { "id": "{msg}" }, "status": 200 },
    { "why": "and an old one of theirs", "as": "collaborator", "do": "POST {api}/delete-message", "body": { "id": "old1" }, "status": 200 },
    { "why": "and everyone sees the table cleared", "do": "GET {api}/state", "is": { "/messages": [], "/positives": [], "/negatives": [] } }
  ]
}
