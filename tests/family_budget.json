{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "an expense category an installed copy left behind, with an envelope", "as": "collaborator", "at": "space", "do": "KV.PUT t/budget_categories/groc", "body": { "name": "groceries", "channel": "c4", "is_income": 0, "monthly_budget": 300, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and an income one", "as": "collaborator", "at": "space", "do": "KV.PUT t/budget_categories/pay", "body": { "name": "pay", "channel": "c5", "is_income": 1, "monthly_budget": 0, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "a grocery run in August", "as": "collaborator", "at": "space", "do": "KV.PUT t/budget_transactions/tx1", "body": { "category_id": "groc", "amount": 42.5, "note": "Market", "date": "2026-08-03", "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "the month's pay", "as": "collaborator", "at": "space", "do": "KV.PUT t/budget_transactions/tx2", "body": { "category_id": "pay", "amount": 1000, "note": "", "date": "2026-08-01", "_created_at": 8, "_modified_at": 8 }, "status": 200 },
    { "why": "and a July shop", "as": "collaborator", "at": "space", "do": "KV.PUT t/budget_transactions/tx3", "body": { "category_id": "groc", "amount": 10, "note": "Corner shop", "date": "2026-07-20", "_created_at": 9, "_modified_at": 9 }, "status": 200 },
    { "why": "the currency an installed copy chose", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/budget_currency", "body": { "v": "\"€\"", "_created_at": 1, "_modified_at": 1 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Family Budget", "/lib/js/framelib.js", "/dyn/frame-prefs.css"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown August, old rows and all", "do": "GET {api}/month?month=2026-08", "status": 200, "is": { "/month": "2026-08", "/settings/currency": "€", "/categories/0/id": "groc", "/categories/0/name": "groceries", "/categories/0/channel": "c4", "/categories/0/is_income": 0, "/categories/0/monthly_budget": 300, "/categories/0/spent": 42.5, "/categories/1/id": "pay", "/categories/1/is_income": 1, "/categories/1/spent": 1000, "/transactions/0/id": "tx1", "/transactions/0/category_name": "groceries", "/transactions/0/channel": "c4", "/transactions/0/amount": 42.5, "/transactions/0/note": "Market", "/transactions/1/id": "tx2", "/transactions/1/is_income": 1, "/totals/income": 1000, "/totals/expenses": 42.5, "/totals/balance": 957.5 }, "absent": ["/categories/2", "/transactions/2"] },
    { "why": "and July on its own", "do": "GET {api}/month?month=2026-07", "status": 200, "is": { "/transactions/0/id": "tx3", "/categories/0/spent": 10, "/categories/1/spent": 0, "/totals/expenses": 10, "/totals/income": 0 }, "absent": ["/transactions/1"] },
    { "why": "a month that is not one reads as this month", "do": "GET {api}/month?month=2026-13", "status": 200, "lacks": ["\"month\":\"2026-13\""] },
    { "why": "a stranger adds no category", "do": "POST {api}/category", "body": { "name": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "renames none", "do": "POST {api}/category/groc", "body": { "name": "sneak" }, "status": 403 },
    { "why": "deletes none", "do": "POST {api}/category/groc/delete", "body": {}, "status": 403 },
    { "why": "records nothing", "do": "POST {api}/tx", "body": { "category_id": "groc", "amount": 5 }, "status": 403 },
    { "why": "changes no transaction", "do": "PUT {api}/tx/tx1", "body": { "amount": 1 }, "status": 403 },
    { "why": "deletes none", "do": "POST {api}/tx/tx1/delete", "body": {}, "status": 403 },
    { "why": "and sets no currency", "do": "POST {api}/settings", "body": { "currency": "¥" }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/budget_transactions/x", "body": { "category_id": "groc", "amount": 1 }, "status": 403 },
    { "why": "nor a setting", "do": "KV.PUT t/__fc_settings/budget_currency", "body": { "v": "\"¥\"" }, "status": 403 },
    { "why": "the categories are as they were", "table": "budget_categories", "has": ["groceries", "\"monthly_budget\":300"], "lacks": ["sneak"] },
    { "why": "and the transactions", "table": "budget_transactions", "has": ["Market", "Corner shop"], "lacks": ["\"amount\":5", "\"amount\":1,"] },
    { "why": "and the currency", "table": "__fc_settings", "has": ["budget_currency", "€"], "lacks": ["¥"] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the month", "as": "signed", "do": "GET {api}/month?month=2026-08", "status": 200, "is": { "/transactions/0/id": "tx1", "/settings/currency": "€" } },
    { "why": "and records nothing", "as": "signed", "do": "POST {api}/tx", "body": { "category_id": "groc", "amount": 5 }, "status": 403 },
    { "why": "nor adds a category", "as": "signed", "do": "POST {api}/category", "body": { "name": "sneak" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the month", "as": "viewer", "do": "GET {api}/month?month=2026-08", "status": 200, "is": { "/totals/balance": 957.5 } },
    { "why": "a viewer adds no category", "as": "viewer", "do": "POST {api}/category", "body": { "name": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "sets no envelope", "as": "viewer", "do": "POST {api}/category/groc", "body": { "monthly_budget": 1 }, "status": 403 },
    { "why": "deletes no category", "as": "viewer", "do": "POST {api}/category/pay/delete", "body": {}, "status": 403 },
    { "why": "records nothing", "as": "viewer", "do": "POST {api}/tx", "body": { "category_id": "groc", "amount": 5 }, "status": 403 },
    { "why": "changes no transaction", "as": "viewer", "do": "POST {api}/tx/tx1", "body": { "note": "mine" }, "status": 403 },
    { "why": "deletes none", "as": "viewer", "do": "POST {api}/tx/tx2/delete", "body": {}, "status": 403 },
    { "why": "sets no currency", "as": "viewer", "do": "POST {api}/settings", "body": { "currency": "¥" }, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/budget_transactions/x", "body": { "category_id": "groc", "amount": 1 }, "status": 403 },
    { "why": "nothing changed", "table": "budget_transactions", "lacks": ["mine", "\"amount\":5"] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a collaborator sets the currency, held to four characters", "as": "collaborator", "do": "POST {api}/settings", "body": { "currency": " £££££ " }, "status": 200, "is": { "/ok": true } },
    { "why": "every page is shown it", "do": "GET {api}/month?month=2026-08", "is": { "/settings/currency": "££££" } },
    { "why": "kept over the row an installed copy left, its value JSON under v", "table": "__fc_settings", "has": ["budget_currency", "\"v\":\"\\\"££££\\\"\"", "\"_created_at\":1", "_modified_at"] },
    { "why": "an empty currency is the dollar", "as": "collaborator", "do": "POST {api}/settings", "body": { "currency": "  " }, "status": 200 },
    { "why": "so shown", "do": "GET {api}/month?month=2026-08", "is": { "/settings/currency": "$" } },

    { "why": "a category needs a name", "as": "collaborator", "do": "POST {api}/category", "body": { "name": "  " }, "status": 400, "is": { "/error": "name required" } },
    { "why": "a collaborator adds an expense category, its colour the next in turn", "as": "collaborator", "do": "POST {api}/category", "body": { "name": " books " }, "status": 200, "is": { "/ok": true } },
    { "why": "drawn last, with no envelope", "do": "GET {api}/month?month=2026-08", "is": { "/categories/2/name": "books", "/categories/2/channel": "c3", "/categories/2/is_income": 0, "/categories/2/monthly_budget": 0, "/categories/2/spent": 0 }, "save": { "books": "/categories/2/id" } },
    { "why": "a row of the space in the shape installed copies hold", "table": "budget_categories", "has": ["\"name\":\"books\"", "\"channel\":\"c3\"", "\"is_income\":0", "\"monthly_budget\":0", "_created_at", "_modified_at"] },
    { "why": "an income category takes the colour it asks for", "as": "collaborator", "do": "POST {api}/category", "body": { "name": "gifts", "is_income": 1, "channel": "c11" }, "status": 200 },
    { "why": "and is income", "do": "GET {api}/month?month=2026-08", "is": { "/categories/3/name": "gifts", "/categories/3/channel": "c11", "/categories/3/is_income": 1 }, "save": { "gifts": "/categories/3/id" } },
    { "why": "an old category is renamed, recoloured and given a new envelope in one", "as": "collaborator", "do": "POST {api}/category/groc", "body": { "name": " food ", "channel": "c9", "monthly_budget": 250 }, "status": 200 },
    { "why": "and the month shows it, its transactions under the new name", "do": "GET {api}/month?month=2026-08", "is": { "/categories/0/name": "food", "/categories/0/channel": "c9", "/categories/0/monthly_budget": 250, "/categories/0/spent": 42.5, "/transactions/0/category_name": "food", "/transactions/0/channel": "c9" } },
    { "why": "over the row, which kept when it was made", "table": "budget_categories", "has": ["\"name\":\"food\"", "\"channel\":\"c9\"", "\"monthly_budget\":250", "\"_created_at\":5"], "lacks": ["groceries"] },
    { "why": "a colour that is not a channel, an empty name and a negative envelope are passed over", "as": "collaborator", "do": "POST {api}/category/groc", "body": { "name": "  ", "channel": "red", "monthly_budget": -5 }, "status": 200 },
    { "why": "so the category is as it was", "do": "GET {api}/month?month=2026-08", "is": { "/categories/0/name": "food", "/categories/0/channel": "c9", "/categories/0/monthly_budget": 250 } },
    { "why": "an income category holds no envelope", "as": "collaborator", "do": "POST {api}/category/{gifts}", "body": { "monthly_budget": 90 }, "status": 200 },
    { "why": "so it has none", "do": "GET {api}/month?month=2026-08", "is": { "/categories/3/monthly_budget": 0 } },
    { "why": "a category there is none of", "as": "collaborator", "do": "POST {api}/category/ghost", "body": { "name": "x" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "nor an act on one", "as": "collaborator", "do": "POST {api}/category/groc/nope", "body": {}, "status": 404 },

    { "why": "a transaction needs a category that is one", "as": "collaborator", "do": "POST {api}/tx", "body": { "category_id": "ghost", "amount": 5 }, "status": 400, "is": { "/error": "bad category" } },
    { "why": "and an amount", "as": "collaborator", "do": "POST {api}/tx", "body": { "category_id": "groc", "amount": 0 }, "status": 400, "is": { "/error": "amount required" } },
    { "why": "a collaborator records a purchase, its amount always positive", "as": "collaborator", "do": "POST {api}/tx", "body": { "category_id": "{books}", "amount": -12.25, "note": " paperbacks ", "date": "2026-08-05" }, "status": 200 },
    { "why": "drawn newest first, against its envelope", "do": "GET {api}/month?month=2026-08", "is": { "/transactions/0/category_id": "{books}", "/transactions/0/amount": 12.25, "/transactions/0/note": "paperbacks", "/transactions/0/date": "2026-08-05", "/transactions/0/category_name": "books", "/categories/2/spent": 12.25, "/totals/expenses": 54.75 }, "save": { "tx": "/transactions/0/id" } },
    { "why": "a row of the space in the shape installed copies hold", "table": "budget_transactions", "has": ["\"note\":\"paperbacks\"", "\"amount\":12.25", "\"date\":\"2026-08-05\"", "_created_at", "_modified_at"] },
    { "why": "a date that is not one is today", "as": "collaborator", "do": "POST {api}/tx", "body": { "category_id": "{books}", "amount": 3, "date": "soon" }, "status": 200 },
    { "why": "and lands this month", "do": "GET {api}/month", "has": ["\"amount\":3"] },
    { "why": "and not in August", "do": "GET {api}/month?month=2026-08", "absent": ["/transactions/3"] },
    { "why": "a transaction's amount, note and category are changed in one", "as": "collaborator", "do": "PUT {api}/tx/{tx}", "body": { "amount": 15, "note": "hardbacks", "category_id": "groc" }, "status": 200 },
    { "why": "and the month follows", "do": "GET {api}/month?month=2026-08", "is": { "/transactions/0/amount": 15, "/transactions/0/note": "hardbacks", "/transactions/0/category_name": "food", "/categories/0/spent": 57.5, "/categories/2/spent": 0 } },
    { "why": "an amount that is none, a category that is none and a date that is none are passed over", "as": "collaborator", "do": "POST {api}/tx/{tx}", "body": { "amount": 0, "category_id": "ghost", "date": "08/05" }, "status": 200 },
    { "why": "so it is as it was", "do": "GET {api}/month?month=2026-08", "is": { "/transactions/0/amount": 15, "/transactions/0/category_id": "groc", "/transactions/0/date": "2026-08-05" } },
    { "why": "an old transaction moved to July", "as": "collaborator", "do": "POST {api}/tx/tx1", "body": { "date": "2026-07-31" }, "status": 200 },
    { "why": "leaves August", "do": "GET {api}/month?month=2026-08", "lacks": ["\"tx1\""] },
    { "why": "and is July's, over its old row", "table": "budget_transactions", "has": ["\"date\":\"2026-07-31\"", "\"note\":\"Market\"", "\"_created_at\":7"] },
    { "why": "a transaction there is none of", "as": "collaborator", "do": "POST {api}/tx/ghost", "body": { "amount": 1 }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "a transaction is deleted", "as": "collaborator", "do": "POST {api}/tx/{tx}/delete", "body": {}, "status": 200 },
    { "why": "and gone", "table": "budget_transactions", "lacks": ["hardbacks"] },
    { "why": "deleting a category takes its transactions with it", "as": "collaborator", "do": "POST {api}/category/groc/delete", "body": {}, "status": 200 },
    { "why": "so none of its are left", "table": "budget_transactions", "lacks": ["Market", "Corner shop"], "has": ["\"category_id\":\"pay\""] },
    { "why": "nor it", "table": "budget_categories", "lacks": ["food"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/tx", "body": { "category_id": "pay", "amount": 20, "note": "bonus", "date": "2026-08-10" }, "status": 200 },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner records one", "as": "owner", "do": "POST {api}/tx", "body": { "category_id": "{books}", "amount": 8, "note": "atlas", "date": "2026-08-11" }, "status": 200 },
    { "why": "and a stranger sees every change", "do": "GET {api}/month?month=2026-08", "is": { "/transactions/0/note": "atlas", "/transactions/1/note": "bonus", "/totals/income": 1020, "/totals/expenses": 8, "/totals/balance": 1012 } },

    { "why": "the owner empties the budget", "as": "owner", "do": "POST {api}/category/pay/delete", "body": {}, "status": 200 },
    { "why": "of each category", "as": "owner", "do": "POST {api}/category/{books}/delete", "body": {}, "status": 200 },
    { "why": "to the last", "as": "owner", "do": "POST {api}/category/{gifts}/delete", "body": {}, "status": 200 },
    { "why": "a stranger's look at an empty budget seeds nothing", "do": "GET {api}/month", "status": 200, "absent": ["/categories/0"] },
    { "why": "nor a viewer's", "as": "viewer", "do": "GET {api}/month", "status": 200, "absent": ["/categories/0"] },
    { "why": "so the table is empty", "table": "budget_categories", "lacks": ["pay", "rent"] },
    { "why": "an editor's first look lands the starter categories", "as": "collaborator", "do": "GET {api}/month", "status": 200, "has": ["\"name\":\"pay\"", "\"name\":\"groceries\"", "\"name\":\"rent\"", "\"name\":\"utilities\"", "\"name\":\"fun\"", "\"name\":\"transport\"", "\"name\":\"dining out\""], "absent": ["/categories/7", "/transactions/0"] },
    { "why": "as rows of the space", "table": "budget_categories", "has": ["\"name\":\"dining out\"", "\"channel\":\"c6\"", "\"is_income\":1", "\"monthly_budget\":0", "_created_at"] },
    { "why": "and only once", "as": "owner", "do": "GET {api}/month", "status": 200, "absent": ["/categories/7"] }
  ]
}
