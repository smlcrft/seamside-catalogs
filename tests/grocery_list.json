{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "an item an installed copy left behind, in the cart", "as": "collaborator", "at": "space", "do": "KV.PUT t/grocery/old1", "body": { "item": "Bread", "quantity": "1 loaf", "category": "bakery", "checked": 1, "source": "", "added_ms": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one not yet bought, with no aisle", "as": "collaborator", "at": "space", "do": "KV.PUT t/grocery/old2", "body": { "item": "Batteries", "quantity": "", "category": "", "checked": 0, "source": "", "added_ms": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "a row a Meal Planner inserted, with its source", "as": "collaborator", "at": "space", "do": "KV.PUT t/grocery/mp1", "body": { "item": "2 onions", "quantity": "", "category": "", "checked": 0, "source": "recipe_42", "added_ms": 7, "_created_at": 7, "_modified_at": 7 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Grocery List", "/lib/js/framelib.js", "/dyn/frame-prefs.css"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the list, by aisle then when added, the planner's row as any other", "do": "GET {api}/list", "status": 200, "is": { "/items/0/id": "old2", "/items/0/category": "", "/items/1/id": "mp1", "/items/1/item": "2 onions", "/items/1/source": "recipe_42", "/items/1/checked": 0, "/items/2/id": "old1", "/items/2/item": "Bread", "/items/2/quantity": "1 loaf", "/items/2/checked": 1, "/items/2/added_ms": 5 }, "absent": ["/items/3", "/items/0/_created_at"] },
    { "why": "a stranger adds nothing", "do": "POST {api}/item", "body": { "item": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "checks nothing off", "do": "POST {api}/item/old2", "body": { "checked": 1 }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/item/old1/delete", "body": {}, "status": 403 },
    { "why": "clears nothing", "do": "POST {api}/clear_checked", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/grocery/x", "body": { "item": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/grocery/", "lacks": ["Bread", "Batteries", "onions"] },
    { "why": "the list is as it was", "table": "grocery", "has": ["Bread", "Batteries", "2 onions"], "lacks": ["sneak", "\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the list", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/items/2/item": "Bread" } },
    { "why": "and writes nothing", "as": "signed", "do": "POST {api}/item", "body": { "item": "sneak" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the list", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/items/1/source": "recipe_42" } },
    { "why": "a viewer adds nothing", "as": "viewer", "do": "POST {api}/item", "body": { "item": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "checks nothing off", "as": "viewer", "do": "POST {api}/item/old2", "body": { "checked": 1 }, "status": 403 },
    { "why": "renames nothing", "as": "viewer", "do": "PUT {api}/item/old2", "body": { "item": "mine" }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/item/mp1/delete", "body": {}, "status": 403 },
    { "why": "clears nothing", "as": "viewer", "do": "POST {api}/clear_checked", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/grocery/x", "body": { "item": "x" }, "status": 403 },
    { "why": "the list is still as it was", "table": "grocery", "has": ["\"checked\":1"], "lacks": ["mine", "sneak"] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "an empty item is refused", "as": "collaborator", "do": "POST {api}/item", "body": { "item": "   ", "quantity": "2" }, "status": 400, "is": { "/error": "item required" } },
    { "why": "a collaborator adds an item, its aisle lowered, and is answered with the list", "as": "collaborator", "do": "POST {api}/item", "body": { "item": "  Milk  ", "quantity": " 2 L ", "category": " Dairy " }, "status": 200, "is": { "/items/3/item": "Milk", "/items/3/quantity": "2 L", "/items/3/category": "dairy", "/items/3/checked": 0, "/items/3/source": "" }, "save": { "milk": "/items/3/id" } },
    { "why": "as a row of the space, in the shape installed copies hold", "table": "grocery", "has": ["\"item\":\"Milk\"", "\"quantity\":\"2 L\"", "\"category\":\"dairy\"", "\"source\":\"\"", "\"added_ms\":", "_created_at", "_modified_at"] },
    { "why": "an item with only a name starts from the contract's defaults", "as": "collaborator", "do": "POST {api}/item", "body": { "item": "Eggs" }, "status": 200, "is": { "/items/2/item": "Eggs", "/items/2/quantity": "", "/items/2/category": "", "/items/2/checked": 0, "/items/2/source": "" } },
    { "why": "the planner's row is checked off like any other", "as": "collaborator", "do": "POST {api}/item/mp1", "body": { "checked": true }, "status": 200, "is": { "/items/1/id": "mp1", "/items/1/checked": 1, "/items/1/source": "recipe_42", "/items/1/item": "2 onions" } },
    { "why": "over the row, which kept its source and when it was made", "table": "grocery", "has": ["\"source\":\"recipe_42\"", "\"_created_at\":7"] },
    { "why": "an old item is renamed, given a quantity and an aisle, in one write", "as": "collaborator", "do": "PUT {api}/item/old2", "body": { "item": " AA batteries ", "quantity": "4", "category": "Hardware" }, "status": 200, "is": { "/items/4/id": "old2", "/items/4/item": "AA batteries", "/items/4/quantity": "4", "/items/4/category": "hardware", "/items/4/checked": 0, "/items/4/added_ms": 6 } },
    { "why": "an empty name leaves the name alone", "as": "collaborator", "do": "POST {api}/item/old2", "body": { "item": "  ", "checked": 1 }, "status": 200, "is": { "/items/4/item": "AA batteries", "/items/4/checked": 1 } },
    { "why": "and unchecked again", "as": "collaborator", "do": "POST {api}/item/old2", "body": { "checked": 0 }, "status": 200, "is": { "/items/4/checked": 0 } },
    { "why": "an item there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/item/ghost", "body": { "checked": 1 }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/item/old2/nope", "body": {}, "status": 404 },
    { "why": "and nothing was made for either", "table": "grocery", "lacks": ["ghost"] },
    { "why": "an item is deleted", "as": "collaborator", "do": "POST {api}/item/{milk}/delete", "body": {}, "status": 200, "lacks": ["Milk"] },
    { "why": "and gone from the table", "table": "grocery", "lacks": ["\"Milk\""] },

    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/is_owner": true, "/user_id": "{did:owner}" } },
    { "why": "the owner adds an item", "as": "owner", "do": "POST {api}/item", "body": { "item": "Coffee", "category": "drinks" }, "status": 200, "is": { "/items/3/item": "Coffee" } },
    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/item/old2", "body": { "checked": 1 }, "status": 200, "is": { "/items/4/checked": 1 } },
    { "why": "the owner clears what is bought, the planner's row and the old one included", "as": "owner", "do": "POST {api}/clear_checked", "body": {}, "status": 200, "is": { "/items/0/item": "Eggs", "/items/1/item": "Coffee" }, "absent": ["/items/2"] },
    { "why": "and they are gone from the table", "table": "grocery", "has": ["Eggs", "Coffee"], "lacks": ["Bread", "onions", "batteries"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "is": { "/items/0/item": "Eggs", "/items/1/item": "Coffee", "/items/1/category": "drinks" }, "absent": ["/items/2"] }
  ]
}
