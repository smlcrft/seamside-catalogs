{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a group an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_groups/g1", "body": { "name": "Tech", "sort": 0, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a feed in it, fetched long ago", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_feeds/f1", "body": { "url": "http://127.0.0.1:9/feed.xml", "site_url": "http://127.0.0.1:9/", "title": "Old Feed", "group_id": "g1", "added_by": "{did:collaborator}", "last_fetched": 5, "last_error": null, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one nobody will touch, for the timer to find", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_feeds/f2", "body": { "url": "http://127.0.0.1:9/quiet.xml", "site_url": "http://127.0.0.1:9/quiet.xml", "title": "Quiet Feed", "group_id": null, "added_by": "{did:collaborator}", "last_fetched": 5, "last_error": null, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "two items of the first, under the random ids old copies gave", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_items/i1", "body": { "feed_id": "f1", "guid": "g-1", "title": "Old item one", "link": "https://example.com/1", "author": "Ann", "content": "<p>Hello <b>there</b></p>", "published_at": 1000, "fetched_at": 1000, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_items/i2", "body": { "feed_id": "f1", "guid": "g-2", "title": "Old item two", "link": "https://example.com/2", "author": "", "content": "second", "published_at": 2000, "fetched_at": 1000, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a boost", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_boosts/b1", "body": { "item_id": "i1", "user_id": "{did:collaborator}", "user_name": "Collaborator", "created_at": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a comment and a reply to it", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_comments/c1", "body": { "item_id": "i1", "parent_id": null, "user_id": "{did:collaborator}", "user_name": "Collaborator", "body": "First!", "created_at": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_comments/c2", "body": { "item_id": "i1", "parent_id": "c1", "user_id": "{did:viewer}", "user_name": "Viewer", "body": "A reply", "created_at": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "the viewer's read mark on the first item", "as": "collaborator", "at": "space", "do": "KV.PUT t/rss_reads/r1", "body": { "item_id": "i1", "user_id": "{did:viewer}", "read_at": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["RSS Reader", "/lib/js/framelib.js"], "lacks": ["busSend", "frame.api("] },

    { "why": "a stranger is told the room is for members", "do": "GET {api}/bootstrap", "status": 200, "is": { "/isMember": false }, "absent": ["/feeds", "/groups", "/counts"], "lacks": ["Old Feed"] },
    { "why": "and reads no items", "do": "GET {api}/items?view=all", "status": 403, "lacks": ["Old item"] },
    { "why": "nor one item", "do": "GET {api}/items/i1", "status": 403, "lacks": ["Hello"] },
    { "why": "a stranger adds no feed", "do": "POST {api}/feeds", "body": { "url": "http://127.0.0.1:9/x.xml" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "refreshes nothing", "do": "POST {api}/refresh", "body": {}, "status": 403 },
    { "why": "makes no group", "do": "POST {api}/groups", "body": { "name": "Mine" }, "status": 403 },
    { "why": "renames no feed", "do": "PUT {api}/feeds/f1", "body": { "title": "Mine" }, "status": 403 },
    { "why": "removes no feed", "do": "DELETE {api}/feeds/f1", "status": 403 },
    { "why": "boosts nothing", "do": "POST {api}/items/i1/boost", "body": { "on": true }, "status": 403, "is": { "/error": "members only" } },
    { "why": "marks nothing read", "do": "POST {api}/items/i2/read", "body": { "read": true }, "status": 403 },
    { "why": "says nothing", "do": "POST {api}/items/i1/comments", "body": { "body": "spam" }, "status": 403 },
    { "why": "deletes no comment", "do": "DELETE {api}/comments/c1", "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/rss_comments/x", "body": { "body": "spam" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/rss_items/", "lacks": ["Old item"] },
    { "why": "nothing a stranger tried landed", "table": "rss_comments", "lacks": ["spam"] },
    { "why": "someone signed in and on no roster is a stranger here too", "as": "signed", "do": "GET {api}/bootstrap", "is": { "/isMember": false }, "lacks": ["Old Feed"] },
    { "why": "and boosts nothing", "as": "signed", "do": "POST {api}/items/i1/boost", "body": { "on": true }, "status": 403 },

    { "why": "a viewer is a member who may not edit, and reads the old rows", "as": "viewer", "do": "GET {api}/bootstrap", "status": 200, "is": { "/isMember": true, "/isEditor": false, "/userId": "{did:viewer}", "/groups/0": { "id": "g1", "name": "Tech", "sort": 0 }, "/feeds/0/id": "f1", "/feeds/0/title": "Old Feed", "/feeds/0/group_id": "g1", "/feeds/0/unread": 1, "/counts": { "all": 2, "unread": 1, "boosted": 1 } } },
    { "why": "newest first, with its own read mark and everyone's counts", "as": "viewer", "do": "GET {api}/items?view=all", "status": 200, "is": { "/items/0/id": "i2", "/items/0/read": false, "/items/1/id": "i1", "/items/1/read": true, "/items/1/boost_count": 1, "/items/1/comment_count": 2, "/items/1/feed_title": "Old Feed", "/items/1/boosted": false } },
    { "why": "unread is what they have not read", "as": "viewer", "do": "GET {api}/items?view=unread", "is": { "/items/0/id": "i2" }, "absent": ["/items/1"] },
    { "why": "boosted is what anyone boosted", "as": "viewer", "do": "GET {api}/items?view=boosted", "is": { "/items/0/id": "i1" }, "absent": ["/items/1"] },
    { "why": "search reads an item's words", "as": "viewer", "do": "GET {api}/items?view=all&q=hello", "is": { "/items/0/id": "i1" }, "absent": ["/items/1"] },
    { "why": "a group holds its feeds' items", "as": "viewer", "do": "GET {api}/items?view=all&group=g1", "is": { "/items/0/id": "i2", "/items/1/id": "i1" } },
    { "why": "an item opens with its thread", "as": "viewer", "do": "GET {api}/items/i1", "status": 200, "is": { "/item/title": "Old item one", "/item/content": "<p>Hello <b>there</b></p>", "/read": true, "/boosts/0/user_name": "Collaborator", "/comments/0/body": "First!", "/comments/1/parent_id": "c1" } },
    { "why": "an item that is not there", "as": "viewer", "do": "GET {api}/items/nope", "status": 404 },

    { "why": "a viewer marks an item read", "as": "viewer", "do": "POST {api}/items/i2/read", "body": { "read": true }, "status": 200, "is": { "/read": true } },
    { "why": "as a row of their own, keyed by them and the item", "table": "rss_reads", "has": ["\"item_id\":\"i2\"", "\"read_at\":", "_created_at", "_modified_at"] },
    { "why": "and the count follows", "as": "viewer", "do": "GET {api}/bootstrap", "is": { "/counts/unread": 0 } },
    { "why": "and unmarks it", "as": "viewer", "do": "POST {api}/items/i2/read", "body": { "read": false }, "status": 200 },
    { "why": "which takes the row away", "table": "rss_reads", "lacks": ["\"item_id\":\"i2\""] },
    { "why": "a viewer boosts", "as": "viewer", "do": "POST {api}/items/i2/boost", "body": { "on": true }, "status": 200, "is": { "/on": true } },
    { "why": "under their own name", "table": "rss_boosts", "has": ["\"item_id\":\"i2\"", "\"user_name\":\"Viewer\"", "\"created_at\":", "_created_at"] },
    { "why": "and takes it back", "as": "viewer", "do": "POST {api}/items/i2/boost", "body": { "on": false }, "status": 200 },
    { "why": "", "table": "rss_boosts", "lacks": ["\"item_id\":\"i2\""] },
    { "why": "a viewer comments", "as": "viewer", "do": "POST {api}/items/i2/comments", "body": { "body": " Nice read " }, "status": 200, "save": { "mine": "/id" } },
    { "why": "as a row of the space, in the old shape", "table": "rss_comments", "has": ["\"body\":\"Nice read\"", "\"parent_id\":null", "\"user_name\":\"Viewer\"", "_created_at", "_modified_at"] },
    { "why": "but says nothing empty", "as": "viewer", "do": "POST {api}/items/i2/comments", "body": { "body": "  " }, "status": 400 },
    { "why": "deletes no one else's comment", "as": "viewer", "do": "DELETE {api}/comments/c1", "status": 403, "is": { "/error": "not yours" } },
    { "why": "and their own", "as": "viewer", "do": "DELETE {api}/comments/{mine}", "status": 200, "is": { "/deleted": 1 } },
    { "why": "a viewer adds no feed", "as": "viewer", "do": "POST {api}/feeds", "body": { "url": "http://127.0.0.1:9/x.xml" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "refreshes nothing", "as": "viewer", "do": "POST {api}/refresh", "body": {}, "status": 403 },
    { "why": "makes no group", "as": "viewer", "do": "POST {api}/groups", "body": { "name": "Mine" }, "status": 403 },
    { "why": "renames no feed", "as": "viewer", "do": "PUT {api}/feeds/f1", "body": { "title": "Mine" }, "status": 403 },
    { "why": "removes no group", "as": "viewer", "do": "DELETE {api}/groups/g1", "status": 403 },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/bootstrap", "is": { "/isEditor": true } },
    { "why": "a collaborator takes out a comment with its replies", "as": "collaborator", "do": "DELETE {api}/comments/c1", "status": 200, "is": { "/deleted": 2 } },
    { "why": "", "table": "rss_comments", "lacks": ["First!", "A reply"] },
    { "why": "makes a group", "as": "collaborator", "do": "POST {api}/groups", "body": { "name": " News " }, "status": 200, "is": { "/name": "News" }, "save": { "news": "/id" } },
    { "why": "which starts from the schema's sort", "table": "rss_groups", "has": ["\"name\":\"News\",\"sort\":0"] },
    { "why": "but not one with no name", "as": "collaborator", "do": "POST {api}/groups", "body": { "name": " " }, "status": 400 },
    { "why": "moves a feed into it and renames it", "as": "collaborator", "do": "PUT {api}/feeds/f1", "body": { "title": "Renamed", "group_id": "{news}" }, "status": 200 },
    { "why": "the feed kept what it held", "table": "rss_feeds", "has": ["\"title\":\"Renamed\"", "http://127.0.0.1:9/feed.xml", "\"added_by\":\"{did:collaborator}\""] },
    { "why": "a group taken out leaves its feeds", "as": "collaborator", "do": "DELETE {api}/groups/{news}", "status": 200 },
    { "why": "ungrouped", "as": "viewer", "do": "GET {api}/bootstrap", "is": { "/feeds/0/title": "Renamed", "/feeds/0/group_id": null, "/groups/0/id": "g1" }, "absent": ["/groups/1"] },
    { "why": "an address that is not the web is refused in words", "as": "collaborator", "do": "POST {api}/feeds", "body": { "url": "ftp://example.com/feed" }, "status": 200, "is": { "/error": "only http and https addresses can be fetched" } },
    { "why": "and no address at all", "as": "collaborator", "do": "POST {api}/feeds", "body": { "url": " " }, "status": 400, "is": { "/error": "a url is required" } },
    { "why": "a site that does not answer is said so, and nothing is added", "as": "collaborator", "do": "POST {api}/feeds", "body": { "url": "http://127.0.0.1:9/down.xml" }, "status": 200, "has": ["\"error\""] },
    { "why": "", "table": "rss_feeds", "lacks": ["down.xml"] },

    { "why": "the owner is an editor too", "as": "owner", "do": "GET {api}/bootstrap", "is": { "/isMember": true, "/isEditor": true, "/userId": "{did:owner}" } },
    { "why": "the owner refreshes one feed, whose site cannot be reached", "as": "owner", "do": "POST {api}/refresh", "body": { "feed_id": "f1" }, "status": 200, "is": { "/refreshed": 1, "/inserted": 0 } },
    { "why": "its error is kept in words, and the other feed is left alone", "table": "rss_feeds", "has": ["\"last_error\":\"Fetch failed: ", "\"last_error\":null,\"last_fetched\":5,\"site_url\":\"http://127.0.0.1:9/quiet.xml\""] },
    { "why": "and its items stay", "as": "viewer", "do": "GET {api}/bootstrap", "is": { "/counts/all": 2, "/feeds/0/id": "f1" } },
    { "why": "the owner removes the feed", "as": "owner", "do": "DELETE {api}/feeds/f1", "status": 200 },
    { "why": "its items go", "table": "rss_items", "lacks": ["Old item"] },
    { "why": "and the boosts and marks on them", "table": "rss_boosts", "lacks": ["\"item_id\":\"i1\""] },
    { "why": "", "table": "rss_reads", "lacks": ["\"item_id\":\"i1\""] },
    { "why": "the feed nobody touched is still there", "table": "rss_feeds", "has": ["quiet.xml"], "lacks": ["Renamed"] },

    { "why": "with nobody looking, the stale feed is fetched again and its error kept", "table": "rss_feeds", "tries": 900, "has": ["quiet.xml", "\"last_error\":\""], "lacks": ["\"last_fetched\":5"] }
  ]
}
