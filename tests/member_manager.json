{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a member already on the list", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/old1", "body": { "name": "Old Pat", "email": "old@example.com", "phone": "555-0100", "role": "Member", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and another, of a role that sorts first", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/old2", "body": { "name": "Ann", "email": "ann@example.com", "phone": "", "role": "Admin", "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "a second list of the space", "as": "collaborator", "at": "space", "do": "KV.PUT t/club.members/c1", "body": { "name": "Club Carl", "email": "carl@example.com", "phone": "", "role": "Member", "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "a collaborator chooses the members list", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 200, "is": { "/bound": "members" } },
    { "why": "and the owner names the organization and its roles", "as": "owner", "do": "POST {api}/settings", "body": { "org_name": "The Club", "roles": ["Admin", "Member"], "owner_only_edit": false }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["id=\"root\""] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "and the module beside it", "do": "GET {frame}/members_list.js", "status": 200, "has": ["chooseList"] },

    { "why": "a stranger is told who they are and what the roster is called", "do": "GET {api}/state", "status": 200, "is": { "/viewer": { "user_name": "anon", "is_owner": false, "is_anon": true }, "/can_edit": false, "/can_bind": false, "/bound": "members", "/has_phone": true, "/prefs": { "org_name": "The Club", "roles": ["Admin", "Member"], "owner_only_edit": false } } },
    { "why": "the preferences are the session's own settings row", "table": "_settings", "has": ["\"id\":\"prefs\"", "The Club", "owner_only_edit"] },
    { "why": "a stranger reads no settings row at the door", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["The Club"] },
    { "why": "nor a collaborator", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["The Club"] },
    { "why": "who writes none there either", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"org_name\":\"Hijack\",\"roles\":[\"Boss\"],\"owner_only_edit\":false}" }, "status": 403 },
    { "why": "nor a key of the session's own", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": { "org_name": "Hijack", "roles": ["Boss"], "owner_only_edit": false }, "status": 403 },
    { "why": "the preferences are as they were", "do": "GET {api}/state", "is": { "/prefs/org_name": "The Club", "/prefs/roles": ["Admin", "Member"] }, "lacks": ["Hijack"] },
    { "why": "a stranger is shown names and roles, by role and then name, and no contact details", "do": "GET {api}/members", "status": 200, "is": { "/anon_view": true, "/rows/0": { "_row_id": "old2", "name": "Ann", "role": "Admin" }, "/rows/1": { "_row_id": "old1", "name": "Old Pat", "role": "Member" } }, "lacks": ["old@example.com", "ann@example.com", "555-0100", "_created_at", "Club Carl"] },
    { "why": "a stranger adds nobody", "do": "POST {api}/member", "body": { "name": "X", "email": "x@example.com", "role": "Member" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "changes nobody", "do": "POST {api}/member", "body": { "row_id": "old1", "name": "X", "email": "x@example.com", "role": "Member" }, "status": 403 },
    { "why": "removes nobody", "do": "POST {api}/member/delete", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "changes no settings", "do": "POST {api}/settings", "body": { "org_name": "Mine", "roles": ["Boss"] }, "status": 403 },
    { "why": "chooses no list", "do": "POST {api}/bind", "body": { "list": "club.members" }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/members/x", "body": { "name": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/members/", "lacks": ["old@example.com"] },
    { "why": "nothing a stranger tried landed", "table": "members", "lacks": ["x@example.com"] },
    { "why": "someone signed in and on no roster is shown what a stranger is", "as": "signed", "do": "GET {api}/members", "status": 200, "is": { "/anon_view": true, "/rows/1/name": "Old Pat" }, "lacks": ["old@example.com", "555-0100"] },
    { "why": "and adds nobody", "as": "signed", "do": "POST {api}/member", "body": { "name": "X", "email": "x@example.com", "role": "Member" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/state", "is": { "/viewer": { "user_name": "Viewer", "is_owner": false, "is_anon": false }, "/can_edit": false, "/can_bind": false } },
    { "why": "a viewer reads the roster with its contact details, old rows as they were kept", "as": "viewer", "do": "GET {api}/members", "status": 200, "is": { "/rows/0/email": "ann@example.com", "/rows/1/_row_id": "old1", "/rows/1/email": "old@example.com", "/rows/1/phone": "555-0100", "/rows/1/_created_at": 5 }, "lacks": ["anon_view"] },
    { "why": "a viewer adds nobody", "as": "viewer", "do": "POST {api}/member", "body": { "name": "X", "email": "x@example.com", "role": "Member" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "removes nobody", "as": "viewer", "do": "POST {api}/member/delete", "body": { "row_id": "old1" }, "status": 403 },
    { "why": "chooses no list", "as": "viewer", "do": "POST {api}/bind", "body": { "list": "club.members" }, "status": 403 },
    { "why": "changes no settings", "as": "viewer", "do": "POST {api}/settings", "body": { "org_name": "Mine", "roles": ["Boss"] }, "status": 403 },

    { "why": "a collaborator may edit and choose the list", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": true, "/can_bind": true, "/viewer/is_owner": false } },
    { "why": "a member needs a name", "as": "collaborator", "do": "POST {api}/member", "body": { "name": " ", "email": "new@example.com", "role": "Member" }, "status": 400, "is": { "/error": "name required" } },
    { "why": "an email", "as": "collaborator", "do": "POST {api}/member", "body": { "name": "New Nell", "email": "", "role": "Member" }, "status": 400, "is": { "/error": "email required" } },
    { "why": "and a role there is", "as": "collaborator", "do": "POST {api}/member", "body": { "name": "New Nell", "email": "new@example.com", "role": "Guest" }, "status": 400, "is": { "/error": "role not in allowed list" } },
    { "why": "an id that names nobody makes nobody", "as": "collaborator", "do": "POST {api}/member", "body": { "row_id": "nobody", "name": "New Nell", "email": "new@example.com", "role": "Member" }, "status": 404 },
    { "why": "a collaborator adds a member", "as": "collaborator", "do": "POST {api}/member", "body": { "name": "New Nell", "email": "new@example.com", "phone": "555-0199", "role": "Member" }, "status": 200, "save": { "new": "/row_id" } },
    { "why": "as a row of the list, stamped when it was made", "table": "members", "has": ["\"name\":\"New Nell\"", "\"email\":\"new@example.com\"", "\"phone\":\"555-0199\"", "\"role\":\"Member\"", "_created_at", "_modified_at"], "lacks": ["nobody"] },
    { "why": "a collaborator changes a role", "as": "collaborator", "do": "POST {api}/member", "body": { "row_id": "old1", "name": "Old Pat", "email": "old@example.com", "phone": "555-0100", "role": "Admin" }, "status": 200, "is": { "/row_id": "old1" } },
    { "why": "which landed over the row, made when it was made", "as": "viewer", "do": "GET {api}/members", "is": { "/rows/0/name": "Ann", "/rows/1/_row_id": "old1", "/rows/1/role": "Admin", "/rows/1/_created_at": 5, "/rows/2/_row_id": "{new}", "/rows/2/phone": "555-0199" } },
    { "why": "settings are the owner's, not a collaborator's", "as": "collaborator", "do": "POST {api}/settings", "body": { "org_name": "Mine", "roles": ["Boss"] }, "status": 403, "is": { "/error": "only the frame owner can change settings" } },
    { "why": "nor an admin's", "as": "admin", "do": "POST {api}/settings", "body": { "org_name": "Mine", "roles": ["Boss"] }, "status": 403 },
    { "why": "the owner's are kept", "as": "owner", "do": "POST {api}/settings", "body": { "org_name": " The Rowing Club ", "roles": ["Admin", "Member", "Member", " "], "owner_only_edit": false }, "status": 200, "is": { "/prefs": { "org_name": "The Rowing Club", "roles": ["Admin", "Member"], "owner_only_edit": false } } },
    { "why": "in the settings row", "table": "_settings", "has": ["The Rowing Club"], "lacks": ["Hijack"] },
    { "why": "and read by everyone", "do": "GET {api}/state", "is": { "/prefs/org_name": "The Rowing Club" } },
    { "why": "a collaborator removes a member", "as": "collaborator", "do": "POST {api}/member/delete", "body": { "row_id": "{new}" }, "status": 204 },
    { "why": "who is gone", "table": "members", "has": ["Old Pat"], "lacks": ["New Nell"] },
    { "why": "removing needs an id", "as": "collaborator", "do": "POST {api}/member/delete", "body": {}, "status": 400 },

    { "why": "a list is named members or <name>.members", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "help_desk_submissions" }, "status": 400 },
    { "why": "a collaborator chooses another list", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "club.members" }, "status": 200, "is": { "/bound": "club.members" } },
    { "why": "which a viewer now reads", "as": "viewer", "do": "GET {api}/members", "is": { "/rows/0/email": "carl@example.com" }, "lacks": ["Old Pat"] },
    { "why": "and a stranger by name and role", "do": "GET {api}/members", "is": { "/rows/0": { "_row_id": "c1", "name": "Club Carl", "role": "Member" } }, "lacks": ["carl@example.com"] },
    { "why": "a member added lands in the list chosen", "as": "collaborator", "do": "POST {api}/member", "body": { "name": "Dee", "email": "dee@example.com", "role": "Member" }, "status": 200 },
    { "why": "there", "table": "club.members", "has": ["dee@example.com"] },
    { "why": "and not in the other", "table": "members", "lacks": ["dee@example.com"] },

    { "why": "the owner keeps editing to themselves", "as": "owner", "do": "POST {api}/settings", "body": { "org_name": "The Club", "roles": ["Admin", "Member"], "owner_only_edit": true }, "status": 200 },
    { "why": "a collaborator is told they may not edit", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": false, "/can_bind": true, "/prefs/owner_only_edit": true } },
    { "why": "and adds nobody", "as": "collaborator", "do": "POST {api}/member", "body": { "name": "Eve", "email": "eve@example.com", "role": "Member" }, "status": 403, "is": { "/error": "editing is restricted to the frame owner" } },
    { "why": "nor an admin", "as": "admin", "do": "POST {api}/member/delete", "body": { "row_id": "c1" }, "status": 403 },
    { "why": "nothing moved", "table": "club.members", "has": ["Club Carl"], "lacks": ["eve@example.com"] },
    { "why": "the owner still edits", "as": "owner", "do": "GET {api}/state", "is": { "/viewer/is_owner": true, "/can_edit": true } },
    { "why": "no route, no answer", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404 }
  ]
}
