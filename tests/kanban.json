{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Kanban Board", "/lib/js/framelib.js"], "lacks": ["<form", "busSend", "__peer"] },

    { "why": "a stranger is named nobody and edits nothing", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger's look at an empty board seeds nothing", "do": "GET {api}/board", "status": 200, "is": { "/columns": [] } },
    { "why": "a stranger adds no column", "do": "POST {api}/column", "body": { "title": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "someone signed in and on no roster is named to themselves", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "and adds no column either", "as": "signed", "do": "POST {api}/column", "body": { "title": "Mine" }, "status": 403 },
    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false } },
    { "why": "a viewer's look seeds nothing", "as": "viewer", "do": "GET {api}/board", "is": { "/columns": [] } },
    { "why": "a viewer adds no column", "as": "viewer", "do": "POST {api}/column", "body": { "title": "Mine" }, "status": 403 },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/is_owner": false } },
    { "why": "whose first look lands the three classic columns", "as": "collaborator", "do": "GET {api}/board", "status": 200, "is": { "/columns/0/title": "To do", "/columns/0/channel": "c2", "/columns/0/sort_order": 0, "/columns/0/cards": [], "/columns/1/title": "In progress", "/columns/1/channel": "c4", "/columns/2/title": "Done", "/columns/2/channel": "c5", "/columns/2/sort_order": 2 }, "absent": ["/columns/3"], "save": { "todo": "/columns/0/id", "doing": "/columns/1/id", "done": "/columns/2/id" } },
    { "why": "as rows of the space, stamped", "table": "_fdata/kanban_columns", "has": ["\"title\":\"To do\"", "\"channel\":\"c4\"", "\"sort_order\":2", "_created_at", "_modified_at"] },
    { "why": "and only once", "as": "collaborator", "do": "GET {api}/board", "absent": ["/columns/3"] },

    { "why": "a column already kept in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fkanban_columns/oldcol", "body": { "title": "Backlog", "channel": "c7", "sort_order": 5, "_created_at": 1, "_modified_at": 1 }, "status": 200 },
    { "why": "and a card in it", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fkanban_cards/oldcard", "body": { "column_id": "oldcol", "title": "Old task", "description": "From before", "label": "legacy", "sort_order": 0, "created_ms": 1, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a stranger reads the whole board, the old rows included", "do": "GET {api}/board", "status": 200, "is": { "/columns/3/id": "oldcol", "/columns/3/title": "Backlog", "/columns/3/channel": "c7", "/columns/3/cards/0/id": "oldcard", "/columns/3/cards/0/title": "Old task", "/columns/3/cards/0/description": "From before", "/columns/3/cards/0/label": "legacy" } },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fkanban_cards/x", "body": { "column_id": "oldcol", "title": "x" }, "status": 403 },
    { "why": "nor does a viewer", "as": "viewer", "do": "KV.PUT t/_fdata%2Fkanban_cards/x", "body": { "column_id": "oldcol", "title": "x" }, "status": 403 },
    { "why": "a stranger deletes no card", "do": "POST {api}/card/oldcard/delete", "body": {}, "status": 403 },
    { "why": "moves none", "do": "POST {api}/card/oldcard/move", "body": { "column_id": "{todo}", "ids": ["oldcard"] }, "status": 403 },
    { "why": "a viewer renames no card", "as": "viewer", "do": "POST {api}/card/oldcard", "body": { "title": "Mine" }, "status": 403 },
    { "why": "adds none", "as": "viewer", "do": "POST {api}/card", "body": { "column_id": "oldcol", "title": "Mine" }, "status": 403 },
    { "why": "moves none", "as": "viewer", "do": "POST {api}/card/oldcard/move", "body": { "column_id": "{todo}", "ids": ["oldcard"] }, "status": 403 },
    { "why": "reorders no column", "as": "viewer", "do": "POST {api}/columns/reorder", "body": { "ids": ["oldcol"] }, "status": 403 },
    { "why": "recolours none", "as": "viewer", "do": "PUT {api}/column/oldcol", "body": { "channel": "c1" }, "status": 403 },
    { "why": "deletes none", "as": "viewer", "do": "POST {api}/column/oldcol/delete", "body": {}, "status": 403 },
    { "why": "nothing was written by any of that", "table": "_fdata/kanban_cards", "has": ["\"title\":\"Old task\"", "\"column_id\":\"oldcol\""], "lacks": ["Mine"] },

    { "why": "a card needs a title", "as": "collaborator", "do": "POST {api}/card", "body": { "column_id": "{todo}", "title": "  " }, "status": 400, "is": { "/error": "title required" } },
    { "why": "and a column that is there", "as": "collaborator", "do": "POST {api}/card", "body": { "column_id": "nope", "title": "x" }, "status": 400, "is": { "/error": "bad column" } },
    { "why": "a card is added at the bottom", "as": "collaborator", "do": "POST {api}/card", "body": { "column_id": "{todo}", "title": " First " }, "status": 200, "is": { "/columns/0/cards/0/title": "First", "/columns/0/cards/0/description": "", "/columns/0/cards/0/label": "" }, "save": { "first": "/columns/0/cards/0/id" } },
    { "why": "another at the top", "as": "collaborator", "do": "POST {api}/card", "body": { "column_id": "{todo}", "title": "Zeroth", "position": "top" }, "status": 200, "is": { "/columns/0/cards/0/title": "Zeroth", "/columns/0/cards/0/sort_order": -1, "/columns/0/cards/1/title": "First" }, "save": { "zeroth": "/columns/0/cards/0/id" } },
    { "why": "as rows of the space's frame data, in the shape the others hold", "table": "_fdata/kanban_cards", "has": ["\"title\":\"First\"", "\"column_id\":\"{todo}\"", "\"description\":\"\"", "\"label\":\"\"", "\"sort_order\":-1", "created_ms", "_created_at", "_modified_at"] },
    { "why": "a card's label and details are set", "as": "collaborator", "do": "PUT {api}/card/{first}", "body": { "label": "urgent", "description": "Details here." }, "status": 200, "is": { "/columns/0/cards/1/title": "First", "/columns/0/cards/1/label": "urgent", "/columns/0/cards/1/description": "Details here." } },
    { "why": "an old card is renamed", "as": "collaborator", "do": "POST {api}/card/oldcard", "body": { "title": "Old task, renamed" }, "status": 200 },
    { "why": "over the row as it was", "table": "_fdata/kanban_cards", "has": ["\"title\":\"Old task, renamed\"", "\"description\":\"From before\"", "\"label\":\"legacy\"", "\"created_ms\":1", "\"_created_at\":5"] },
    { "why": "and moved to another column", "as": "collaborator", "do": "POST {api}/card/oldcard/move", "body": { "column_id": "{doing}", "ids": ["oldcard"] }, "status": 200, "is": { "/columns/1/cards/0/id": "oldcard", "/columns/1/cards/0/title": "Old task, renamed", "/columns/3/cards": [] } },
    { "why": "not to one there is none of", "as": "collaborator", "do": "POST {api}/card/oldcard/move", "body": { "column_id": "nope", "ids": [] }, "status": 400 },
    { "why": "a card there is none of", "as": "collaborator", "do": "POST {api}/card/nope", "body": { "title": "x" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/card/{first}/fly", "body": {}, "status": 404 },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404 },

    { "why": "a column is renamed and recoloured", "as": "collaborator", "do": "POST {api}/column/{doing}", "body": { "title": "Doing", "channel": "c9" }, "status": 200, "is": { "/columns/1/title": "Doing", "/columns/1/channel": "c9", "/columns/1/cards/0/id": "oldcard" } },
    { "why": "not to a colour there is none of", "as": "collaborator", "do": "POST {api}/column/{doing}", "body": { "channel": "c13" }, "status": 200, "is": { "/columns/1/channel": "c9" } },
    { "why": "a column is added after the last, coloured by count", "as": "collaborator", "do": "POST {api}/column", "body": { "title": "Review" }, "status": 200, "is": { "/columns/4/title": "Review", "/columns/4/channel": "c5", "/columns/4/sort_order": 6 }, "save": { "review": "/columns/4/id" } },
    { "why": "the columns are reordered", "as": "collaborator", "do": "POST {api}/columns/reorder", "body": { "ids": ["oldcol", "{review}", "{todo}", "{doing}", "{done}", "nope"] }, "status": 200, "is": { "/columns/0/id": "oldcol", "/columns/1/id": "{review}", "/columns/2/id": "{todo}", "/columns/3/id": "{doing}", "/columns/4/id": "{done}" }, "absent": ["/columns/5"] },
    { "why": "the old column kept what it held", "table": "_fdata/kanban_columns", "has": ["\"title\":\"Backlog\"", "\"channel\":\"c7\"", "\"_created_at\":1"], "lacks": ["nope"] },

    { "why": "a column goes", "as": "collaborator", "do": "POST {api}/column/{todo}/delete", "body": {}, "status": 200, "absent": ["/columns/4"] },
    { "why": "with its cards", "table": "_fdata/kanban_cards", "lacks": ["Zeroth", "\"title\":\"First\""], "has": ["Old task, renamed"] },

    { "why": "an admin edits", "as": "admin", "do": "POST {api}/card", "body": { "column_id": "{review}", "title": "From an admin" }, "status": 200, "is": { "/columns/1/cards/0/title": "From an admin" }, "save": { "admincard": "/columns/1/cards/0/id" } },
    { "why": "the owner is named the owner", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_owner": true, "/is_sfi_editor": true, "/is_sfi_member": true } },
    { "why": "and deletes a card", "as": "owner", "do": "POST {api}/card/{admincard}/delete", "body": {}, "status": 200, "is": { "/columns/1/cards": [] } },
    { "why": "a stranger sees the board as it now stands", "do": "GET {api}/board", "is": { "/columns/0/title": "Backlog", "/columns/1/title": "Review", "/columns/2/title": "Doing", "/columns/2/cards/0/title": "Old task, renamed", "/columns/3/title": "Done" }, "absent": ["/columns/4"] }
  ]
}
