{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a photo's bytes an installed copy left in the space", "as": "collaborator", "at": "space", "do": "PUT /files/Picture%20Frame/oldphoto01/old.gif", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 200 },
    { "why": "and its row, in the shape that copy wrote, with no thumbnail", "as": "collaborator", "at": "space", "do": "KV.PUT t/picture_frame_photos/oldphoto01", "body": { "name": "old.gif", "mime": "image/gif", "size": 29, "w": 1, "h": 1, "sort_order": 0, "added_ms": 5, "added_by": "Kay", "path": "Picture Frame/oldphoto01/old.gif", "thumb_path": "", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "the wall that copy was showing, in the session's own keys", "as": "collaborator", "at": "space", "do": "KV.PUT display/mode f:{id}", "body": "\"single\"", "status": 200 },
    { "why": "on that photo", "as": "collaborator", "at": "space", "do": "KV.PUT display/current_photo_id f:{id}", "body": "\"oldphoto01\"", "status": 200 },
    { "why": "filling the frame", "as": "collaborator", "at": "space", "do": "KV.PUT display/fit f:{id}", "body": "\"cover\"", "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["<title>Picture Frame</title>"] },
    { "why": "and its clock", "do": "GET {frame}/slideshow-clock.js", "status": 200, "has": ["export function photoAtTime"] },
    { "why": "a stranger is shown the wall as it was left, and may not edit", "do": "GET {api}/state", "status": 200, "is": { "/can_edit": false, "/me/is_anon": true, "/me/is_sfi_member": false, "/display/mode": "single", "/display/current_photo_id": "oldphoto01", "/display/fit": "cover", "/display/slideshow_on": false, "/display/slideshow_secs": 15, "/photos/0/id": "oldphoto01", "/photos/0/name": "old.gif", "/photos/0/mime": "image/gif", "/photos/0/size": 29, "/photos/0/added_by": "Kay" }, "absent": ["/photos/1", "/photos/0/path"] },
    { "why": "a stranger is handed the photo's bytes as they are", "do": "GET {api}/photo/oldphoto01", "status": 200, "has": ["GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;"] },
    { "why": "and the grid falls back to the photo where there is no thumbnail", "do": "GET {api}/thumb/oldphoto01", "status": 200, "has": ["GIF89a"] },
    { "why": "a photo there is not is not found", "do": "GET {api}/photo/nosuchphoto", "status": 404 },
    { "why": "an id that is not one is refused", "do": "GET {api}/photo/x", "status": 400 },
    { "why": "an unknown route is not found", "do": "GET {api}/nothing", "status": 404 },
    { "why": "a stranger moves no wall", "do": "POST {api}/display", "body": { "mode": "grid" }, "status": 403 },
    { "why": "changes no setting", "do": "POST {api}/settings", "body": { "slideshow_on": true }, "status": 403 },
    { "why": "adds no photo", "do": "POST {api}/upload?name=a.gif&mime=image/gif&w=1&h=1", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 403 },
    { "why": "no thumbnail", "do": "POST {api}/upload/oldphoto01/thumb", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/delete/oldphoto01", "status": 403 },
    { "why": "writes no row at the door", "do": "KV.PUT t/picture_frame_photos/strangerrow1", "body": { "name": "x" }, "status": 403 },
    { "why": "and the wall is as it was", "do": "GET {api}/state", "is": { "/display/mode": "single", "/display/current_photo_id": "oldphoto01", "/photos/0/id": "oldphoto01" }, "absent": ["/photos/1"] },
    { "why": "the table holds only what was put there", "table": "picture_frame_photos", "lacks": ["strangerrow1"] },

    { "why": "someone signed in and on no roster browses, and may not edit", "as": "signed", "do": "GET {api}/state", "is": { "/can_edit": false, "/me/is_anon": true } },
    { "why": "and moves no wall", "as": "signed", "do": "POST {api}/display", "body": { "mode": "grid" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/state", "is": { "/can_edit": false, "/me/is_anon": false, "/me/is_sfi_member": true, "/me/is_sfi_editor": false, "/me/user_name": "Viewer" } },
    { "why": "a viewer adds no photo", "as": "viewer", "do": "POST {api}/upload?name=a.gif&mime=image/gif&w=1&h=1", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 403 },
    { "why": "moves no wall", "as": "viewer", "do": "POST {api}/display", "body": { "mode": "grid" }, "status": 403 },
    { "why": "starts no slideshow", "as": "viewer", "do": "POST {api}/settings", "body": { "slideshow_on": true }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/delete/oldphoto01", "status": 403 },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": true, "/me/is_sfi_editor": true } },
    { "why": "a type the frame does not keep is refused", "as": "collaborator", "do": "POST {api}/upload?name=a.bmp&mime=image/bmp", "body": "BMxxxxxxxxxxxxxxxx", "status": 400, "is": { "/error": "unsupported image type" } },
    { "why": "an empty upload is refused", "as": "collaborator", "do": "POST {api}/upload?name=a.gif&mime=image/gif", "status": 400, "is": { "/error": "empty upload" } },
    { "why": "and what is not a picture", "as": "collaborator", "do": "POST {api}/upload?name=a.png&mime=image/png", "body": "hello, this is not a picture", "status": 415, "is": { "/error": "file is not an image" } },
    { "why": "nothing refused left a row", "table": "picture_frame_photos", "lacks": ["a.bmp", "a.png"] },
    { "why": "a collaborator adds a photo, its bytes the body", "as": "collaborator", "do": "POST {api}/upload?name=new.gif&mime=image/gif&w=1&h=1", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 200, "save": { "new": "/photo_id" } },
    { "why": "as a row after the last, from the schema's defaults, stamped, under their name", "table": "picture_frame_photos", "has": ["\"id\":\"{new}\"", "\"name\":\"new.gif\"", "\"sort_order\":1", "\"size\":29", "\"added_by\":\"Collaborator\"", "\"path\":\"Picture Frame/{new}/new.gif\"", "\"thumb_path\":\"\"", "_created_at", "_modified_at"] },
    { "why": "and a file of the space", "as": "collaborator", "at": "space", "do": "GET /files/Picture%20Frame/{new}/new.gif", "status": 200, "has": ["GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;"] },
    { "why": "its thumbnail goes beside it", "as": "collaborator", "do": "POST {api}/upload/{new}/thumb", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 200 },
    { "why": "named on the row, which kept what it held", "table": "picture_frame_photos", "has": ["\"thumb_path\":\"Picture Frame/{new}/thumbnail.gif\"", "\"path\":\"Picture Frame/{new}/new.gif\"", "\"added_by\":\"Collaborator\""] },
    { "why": "a thumbnail for no photo is not found", "as": "collaborator", "do": "POST {api}/upload/nosuchphoto/thumb", "body": "GIF89a\u0001\u0000\u0001\u0000\u0000\u0000\u0000,\u0000\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0002\u0002D\u0001\u0000;", "status": 404 },
    { "why": "a stranger sees both photos, in upload order, and the thumbnail", "do": "GET {api}/state", "is": { "/photos/0/id": "oldphoto01", "/photos/1/id": "{new}", "/photos/1/w": 1 } },
    { "why": "and is handed the thumbnail", "do": "GET {api}/thumb/{new}", "status": 200, "has": ["GIF89a"] },

    { "why": "a collaborator puts a photo up", "as": "collaborator", "do": "POST {api}/display", "body": { "mode": "single", "photo_id": "{new}" }, "status": 200, "is": { "/display/current_photo_id": "{new}", "/display/mode": "single" } },
    { "why": "but not one there is not", "as": "collaborator", "do": "POST {api}/display", "body": { "photo_id": "nosuchphoto" }, "status": 404 },
    { "why": "starts the show from what is up", "as": "collaborator", "do": "POST {api}/settings", "body": { "slideshow_on": true, "current_photo_id": "{new}" }, "status": 200, "is": { "/display/slideshow_on": true, "/display/anchor_photo_id": "{new}" } },
    { "why": "an interval too short is held to the least", "as": "collaborator", "do": "POST {api}/settings", "body": { "slideshow_secs": 1, "current_photo_id": "oldphoto01" }, "status": 200, "is": { "/display/slideshow_secs": 3, "/display/anchor_photo_id": "oldphoto01" } },
    { "why": "stopping keeps the photo that was showing", "as": "collaborator", "do": "POST {api}/settings", "body": { "slideshow_on": false, "current_photo_id": "oldphoto01", "fit": "contain" }, "status": 200, "is": { "/display/slideshow_on": false, "/display/current_photo_id": "oldphoto01", "/display/fit": "contain" } },
    { "why": "kept in the session's own keys, as before", "as": "collaborator", "at": "space", "do": "KV.GET display/slideshow_secs f:{id}", "status": 200, "has": ["3"] },
    { "why": "every one of them", "as": "collaborator", "at": "space", "do": "KV.GET display/current_photo_id f:{id}", "status": 200, "has": ["oldphoto01"] },
    { "why": "and a stranger sees the wall the collaborator set", "do": "GET {api}/state", "is": { "/display/current_photo_id": "oldphoto01", "/display/slideshow_secs": 3, "/display/fit": "contain" } },

    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/state", "is": { "/can_edit": true } },
    { "why": "the owner deletes the photo that is up, and the wall moves on", "as": "owner", "do": "POST {api}/delete/oldphoto01", "status": 200, "is": { "/photos/0/id": "{new}", "/display/current_photo_id": "{new}" }, "absent": ["/photos/1"] },
    { "why": "its row goes", "table": "picture_frame_photos", "lacks": ["oldphoto01"] },
    { "why": "and its file", "as": "collaborator", "at": "space", "do": "GET /files/Picture%20Frame/oldphoto01/old.gif", "status": 404 },
    { "why": "and it is served no more", "do": "GET {api}/photo/oldphoto01", "status": 404 },
    { "why": "a photo gone is not deleted twice", "as": "owner", "do": "POST {api}/delete/oldphoto01", "status": 404 },
    { "why": "the last photo goes and the wall rests on the grid", "as": "collaborator", "do": "POST {api}/delete/{new}", "status": 200, "is": { "/photos": [], "/display/mode": "grid", "/display/current_photo_id": "" } },
    { "why": "with its thumbnail", "as": "collaborator", "at": "space", "do": "GET /files/Picture%20Frame/{new}/thumbnail.gif", "status": 404 }
  ]
}
