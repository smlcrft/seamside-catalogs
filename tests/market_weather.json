{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a collaborator sets a market up, one event with no id and one that is not an event", "as": "collaborator", "do": "POST {api}/save", "body": { "location": "", "events": [{ "id": "ev_old", "name": "Baking Day", "day_of_week": 6, "start_hh": 9, "start_mm": 30, "end_hh": 13, "end_mm": 0 }, { "name": "Night market", "day_of_week": 5, "start_hh": 18, "start_mm": 0, "end_hh": 22, "end_mm": 0 }, 7] }, "status": 200, "is": { "/prefs/events/0/id": "ev_old" }, "absent": ["/prefs/events/2"] },

    { "why": "the page is served, stamped with nobody", "do": "GET {frame}/index.html", "status": 200, "has": ["Market Weather", "/dyn/frame-prefs.css"], "lacks": ["__peer", "<form"] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "and its script", "do": "GET {frame}/index.js", "status": 200, "has": ["/lib/js/framelib.js"], "lacks": ["busSend", "__peer"] },

    { "why": "a stranger is shown no market", "do": "GET {api}/state", "status": 403, "is": { "/error": "private frame" }, "lacks": ["Baking Day"] },
    { "why": "and changes none", "do": "POST {api}/save", "body": { "location": "Mine", "events": [] }, "status": 403, "is": { "/error": "private frame" } },
    { "why": "a stranger writes no key at the door", "do": "KV.PUT prefs f:{id}", "body": "{\"location\":\"Mine\",\"events\":[]}", "status": 403 },
    { "why": "nor reads the settings row", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Baking Day"] },
    { "why": "nor lists it", "do": "KV.LIST t/_settings/ f:{id}", "status": 403, "lacks": ["Baking Day"] },
    { "why": "nor writes it", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"location\":\"Mine\",\"events\":[]}" }, "status": 403 },
    { "why": "someone signed in and on no roster is shown nothing either", "as": "signed", "do": "GET {api}/state", "status": 403, "is": { "/error": "private frame" }, "lacks": ["Baking Day"] },
    { "why": "and changes nothing", "as": "signed", "do": "POST {api}/save", "body": { "location": "Mine", "events": [] }, "status": 403 },

    { "why": "a viewer reads the market", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/you": { "member": true, "editor": false }, "/is_owner": false, "/prefs/location": "", "/prefs/events/0/id": "ev_old", "/prefs/events/0/name": "Baking Day", "/prefs/events/0/start_mm": 30, "/prefs/events/1/name": "Night market", "/weather": null, "/readings": [], "/weights/precip": 2.2 }, "absent": ["/prefs/events/2"] },
    { "why": "and changes nothing", "as": "viewer", "do": "POST {api}/save", "body": { "location": "Mine", "events": [] }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "the market is kept as the session's own settings row, and nothing else was written", "table": "_settings", "has": ["\"id\":\"prefs\"", "Baking Day", "Night market", "ev_old", "_created_at", "_modified_at"], "lacks": ["Mine"] },
    { "why": "a viewer neither reads the settings row at the door", "as": "viewer", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Baking Day"] },
    { "why": "a collaborator neither reads the settings row at the door", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Baking Day"] },
    { "why": "nor writes it", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"location\":\"Mine\",\"events\":[]}" }, "status": 403 },
    { "why": "nor writes a key of the session's own", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"location\":\"Mine\",\"events\":[]}", "status": 403 },
    { "why": "the market is as it was", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/prefs/events/0/name": "Baking Day" }, "lacks": ["Mine"] },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/state", "status": 200, "is": { "/you": { "member": true, "editor": true } } },
    { "why": "a save that is not JSON is refused", "as": "collaborator", "do": "POST {api}/save", "body": "not json", "status": 400, "is": { "/error": "invalid JSON" } },
    { "why": "a collaborator saves the market, what is not an event dropped and the rest held in range", "as": "collaborator", "do": "POST {api}/save", "body": { "location": "  Portland, Oregon  ", "events": [{ "id": "ev_old", "name": " Baking Day ", "day_of_week": 9, "start_hh": 9, "start_mm": 30, "end_hh": 30, "end_mm": 0 }, "junk"] }, "status": 200, "is": { "/prefs/location": "Portland, Oregon", "/prefs/events/0": { "id": "ev_old", "name": "Baking Day", "day_of_week": 6, "start_hh": 9, "start_mm": 30, "end_hh": 23, "end_mm": 0 } }, "absent": ["/prefs/events/1"] },
    { "why": "kept as the session's settings row", "table": "_settings", "has": ["Portland, Oregon", "ev_old", "\\\"day_of_week\\\":6"], "lacks": ["Night market", "junk"] },
    { "why": "an event with no id is given one", "as": "collaborator", "do": "POST {api}/save", "body": { "location": "", "events": [{ "name": "Pop-up", "day_of_week": 0, "start_hh": 11, "start_mm": 0, "end_hh": 15, "end_mm": 0 }] }, "status": 200, "is": { "/prefs/location": "", "/prefs/events/0/name": "Pop-up" }, "save": { "ev": "/prefs/events/0/id" } },
    { "why": "and keeps it", "as": "viewer", "do": "GET {api}/state", "is": { "/prefs/events/0/id": "{ev}", "/prefs/events/0/name": "Pop-up" }, "absent": ["/prefs/events/1"] },
    { "why": "no more than 32 events are kept", "as": "admin", "do": "POST {api}/save", "body": { "location": "", "events": [{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}] }, "status": 200, "is": { "/prefs/events/31/day_of_week": 0 }, "absent": ["/prefs/events/32"] },

    { "why": "the keeper's own browser is an editor too", "as": "owner", "do": "GET {api}/state", "status": 200, "is": { "/you": { "member": true, "editor": true } } },
    { "why": "and saves the market", "as": "owner", "do": "POST {api}/save", "body": { "location": "", "events": [{ "id": "ev_k", "name": "Keeper's day", "day_of_week": 3, "start_hh": 8, "start_mm": 0, "end_hh": 12, "end_mm": 0 }] }, "status": 200, "is": { "/prefs/events/0/id": "ev_k" } },
    { "why": "which a viewer reads", "as": "viewer", "do": "GET {api}/state", "is": { "/prefs/events/0/name": "Keeper's day" }, "absent": ["/prefs/events/1"] },

    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404 },
    { "why": "a stranger is refused there too", "do": "POST {api}/nothing", "body": {}, "status": 403 }
  ]
}
