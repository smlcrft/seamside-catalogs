{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a roster Member Manager left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/m1", "body": { "name": "Ann", "email": "ann@example.com", "role": "Parent", "phone": "555-0101", "_created_at": 1, "_modified_at": 1 }, "status": 200 },
    { "why": "one of them with no phone", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/m2", "body": { "name": "Bob", "email": "bob@example.com", "role": "Parent", "phone": "", "_created_at": 1, "_modified_at": 1 }, "status": 200 },
    { "why": "and a coach", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/m3", "body": { "name": "Cy", "email": "cy@example.com", "role": "Coach", "phone": "555-0103", "_created_at": 1, "_modified_at": 1 }, "status": 200 },
    { "why": "a send an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/reachout_sent/old1", "body": { "list": "members", "sent_by": "did:old:olive", "sent_by_name": "Olive", "sent_at_ms": 5, "to_all": false, "roles": ["Parent"], "method": "email", "subject": "Picnic", "message": "Old parent note", "recipient_count": 2, "attempted_count": 2, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "one that went to everyone", "as": "collaborator", "at": "space", "do": "KV.PUT t/reachout_sent/old2", "body": { "list": "members", "sent_by": "did:old:olive", "sent_by_name": "Olive", "sent_at_ms": 6, "to_all": true, "roles": [], "method": "text", "subject": "", "message": "Old everyone note", "recipient_count": 3, "attempted_count": 2, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "one that went to another list", "as": "collaborator", "at": "space", "do": "KV.PUT t/reachout_sent/old3", "body": { "list": "club.members", "sent_by": "did:old:olive", "sent_by_name": "Olive", "sent_at_ms": 7, "to_all": false, "roles": ["Parent"], "method": "email", "subject": "", "message": "Other list note", "recipient_count": 1, "attempted_count": 1, "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "the settings an installed copy kept in the session", "as": "collaborator", "at": "space", "do": "KV.PUT settings f:{id}", "body": "{\"title\":\"Club news\",\"public_roles\":[\"Parent\"]}", "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["id=\"root\""] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "and its module", "do": "GET {frame}/members_list.js", "status": 200, "has": ["chooseList"] },

    { "why": "with no list chosen a stranger is shown the title and nothing else", "do": "GET {api}/state", "status": 200, "is": { "/bound": null, "/settings/title": "Club news", "/roles": [], "/can_edit": false, "/can_bind": false, "/viewer/is_sfi_member": false, "/viewer/is_anon": true } },
    { "why": "the settings an installed copy kept are moved into the session's own settings row", "table": "__fc_settings", "has": ["\"id\":\"settings\"", "Club news", "public_roles"] },
    { "why": "and are gone from the door", "as": "collaborator", "at": "space", "do": "KV.GET settings f:{id}", "status": 404 },
    { "why": "a stranger reads no settings row at the door", "do": "KV.GET t/__fc_settings/settings f:{id}", "status": 403, "lacks": ["Club news"] },
    { "why": "a collaborator writes none there", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/settings f:{id}", "body": { "v": "{\"title\":\"Hijack\",\"public_roles\":[\"Coach\"]}" }, "status": 403 },
    { "why": "and a session key written at the door is no setting any more", "as": "collaborator", "at": "space", "do": "KV.PUT settings f:{id}", "body": "{\"title\":\"Hijack\",\"public_roles\":[\"Coach\"]}", "status": 200 },
    { "why": "the settings are as they were", "do": "GET {api}/state", "is": { "/settings": { "title": "Club news", "public_roles": ["Parent"] } }, "lacks": ["Hijack"] },
    { "why": "and no send", "do": "GET {api}/log", "status": 200, "is": { "/entries": [], "/anon_view": true } },
    { "why": "nothing is logged before a list is chosen", "as": "collaborator", "do": "POST {api}/log", "body": { "to_all": true, "message": "Too soon" }, "status": 409 },

    { "why": "a stranger chooses no list", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 403 },
    { "why": "nor a viewer", "as": "viewer", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 403 },
    { "why": "a list has a members name", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "reachout_sent" }, "status": 400 },
    { "why": "a list an installed copy had chosen is read", "as": "collaborator", "at": "space", "do": "KV.PUT bound/members f:{id}", "body": "club.members", "status": 200 },
    { "why": "as the list in use", "do": "GET {api}/state", "is": { "/bound": "club.members" } },
    { "why": "whose sends are the ones shown", "as": "viewer", "do": "GET {api}/log", "is": { "/entries/0/message": "Other list note", "/entries/0/id": "old3" }, "lacks": ["Old parent note"] },
    { "why": "a collaborator chooses the list", "as": "collaborator", "do": "POST {api}/bind", "body": { "list": "members" }, "status": 200, "is": { "/bound": "members" } },

    { "why": "a stranger learns nothing of the roster", "do": "GET {api}/state", "status": 200, "is": { "/bound": "members", "/roles": [], "/can_edit": false }, "lacks": ["Coach", "count", "example.com"] },
    { "why": "a stranger reads what went to the roles made public, and not who sent it", "do": "GET {api}/log", "status": 200, "is": { "/anon_view": true, "/entries/0/id": "old1", "/entries/0/message": "Old parent note", "/entries/0/subject": "Picnic", "/entries/0/roles": ["Parent"], "/entries/0/recipient_count": 2 }, "lacks": ["Old everyone note", "Other list note", "Olive", "did:old", "sent_by", "attempted_count", "example.com"] },
    { "why": "a stranger is handed no addresses", "do": "GET {api}/resolve?to_all=1", "status": 403, "lacks": ["example.com"] },
    { "why": "by either way in", "do": "POST {api}/resolve", "body": { "to_all": true }, "status": 403, "lacks": ["example.com"] },
    { "why": "a stranger logs nothing", "do": "POST {api}/log", "body": { "to_all": true, "message": "Spam" }, "status": 403 },
    { "why": "removes nothing", "do": "POST {api}/log/delete", "body": { "id": "old1" }, "status": 403 },
    { "why": "sets nothing", "do": "POST {api}/settings", "body": { "title": "Mine", "public_roles": ["Coach"] }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/reachout_sent/x", "body": { "list": "members", "message": "Spam" }, "status": 403 },
    { "why": "and reads no roster there", "do": "KV.LIST t/members/", "lacks": ["example.com"] },
    { "why": "nor the log", "do": "KV.LIST t/reachout_sent/", "lacks": ["Old everyone note"] },
    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/log", "status": 200, "is": { "/anon_view": true }, "lacks": ["Old everyone note", "Olive"] },
    { "why": "and is handed no addresses", "as": "signed", "do": "GET {api}/resolve?to_all=1", "status": 403 },
    { "why": "and logs nothing", "as": "signed", "do": "POST {api}/log", "body": { "to_all": true, "message": "Spam" }, "status": 403 },

    { "why": "a viewer is a member who may not edit, and sees the roster's roles", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/can_edit": false, "/can_bind": false, "/viewer/is_sfi_member": true, "/viewer/is_sfi_editor": false, "/viewer/is_owner": false, "/roles": [{ "role": "Coach", "count": 1, "all_have_phone": true }, { "role": "Parent", "count": 2, "all_have_phone": false }] }, "lacks": ["example.com"] },
    { "why": "a viewer reads every send to this list, newest first, in the shape installed copies hold", "as": "viewer", "do": "GET {api}/log", "status": 200, "is": { "/can_edit": false, "/entries/0/id": "old2", "/entries/0/to_all": true, "/entries/0/method": "text", "/entries/0/attempted_count": 2, "/entries/1/id": "old1", "/entries/1/sent_by_name": "Olive", "/entries/1/sent_by": "did:old:olive", "/entries/1/roles": ["Parent"] }, "lacks": ["Other list note"] },
    { "why": "a viewer is handed no addresses", "as": "viewer", "do": "GET {api}/resolve?to_all=1", "status": 403, "lacks": ["example.com"] },
    { "why": "logs nothing", "as": "viewer", "do": "POST {api}/log", "body": { "to_all": true, "message": "Hello" }, "status": 403 },
    { "why": "removes nothing", "as": "viewer", "do": "POST {api}/log/delete", "body": { "id": "old1" }, "status": 403 },
    { "why": "sets nothing", "as": "viewer", "do": "POST {api}/settings", "body": { "title": "Mine" }, "status": 403 },
    { "why": "and nothing was written", "table": "reachout_sent", "lacks": ["Spam", "Hello", "Too soon"] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_edit": true, "/can_bind": true, "/viewer/is_sfi_editor": true, "/viewer/user_name": "Collaborator" } },
    { "why": "and is handed everyone, by name, each once", "as": "collaborator", "do": "GET {api}/resolve?to_all=1", "status": 200, "is": { "/all_have_phone": false, "/recipients": [{ "name": "Ann", "email": "ann@example.com", "phone": "555-0101" }, { "name": "Bob", "email": "bob@example.com", "phone": "" }, { "name": "Cy", "email": "cy@example.com", "phone": "555-0103" }] } },
    { "why": "or a role", "as": "collaborator", "do": "GET {api}/resolve?to_all=0&roles=%5B%22Coach%22%5D", "status": 200, "is": { "/all_have_phone": true, "/recipients": [{ "name": "Cy", "email": "cy@example.com", "phone": "555-0103" }] } },
    { "why": "the audience as a body is read too", "as": "collaborator", "do": "POST {api}/resolve", "body": { "to_all": false, "roles": ["Parent"] }, "status": 200, "is": { "/recipients/0/name": "Ann", "/recipients/1/name": "Bob", "/all_have_phone": false } },
    { "why": "no audience is refused", "as": "collaborator", "do": "GET {api}/resolve?to_all=0", "status": 400, "is": { "/error": "pick an audience" } },
    { "why": "a send with no message is refused", "as": "collaborator", "do": "POST {api}/log", "body": { "to_all": true, "message": "  " }, "status": 400, "is": { "/error": "message required" } },
    { "why": "and one with no audience", "as": "collaborator", "do": "POST {api}/log", "body": { "roles": [], "message": "Hello" }, "status": 400, "is": { "/error": "audience required" } },
    { "why": "an email is logged under the sender's own name", "as": "collaborator", "do": "POST {api}/log", "body": { "to_all": false, "roles": ["Parent"], "method": "email", "subject": " Bake sale ", "message": "Bring cakes.", "recipient_count": 2 }, "status": 200, "is": { "/entry/list": "members", "/entry/sent_by": "{did:collaborator}", "/entry/sent_by_name": "Collaborator", "/entry/subject": "Bake sale", "/entry/roles": ["Parent"], "/entry/recipient_count": 2, "/entry/attempted_count": 2 }, "save": { "new": "/entry/id" } },
    { "why": "a run of texts is logged with how many were tapped, never more than there were", "as": "collaborator", "do": "POST {api}/log", "body": { "to_all": false, "roles": ["Coach"], "method": "text", "subject": "dropped", "message": "Practice moved.", "recipient_count": 1, "attempted_count": 9 }, "status": 200, "is": { "/entry/method": "text", "/entry/subject": "", "/entry/attempted_count": 1 }, "save": { "text": "/entry/id" } },
    { "why": "as rows of the space, in the shape installed copies hold", "table": "reachout_sent", "has": ["\"message\":\"Bring cakes.\"", "\"subject\":\"Bake sale\"", "\"list\":\"members\"", "\"sent_by_name\":\"Collaborator\"", "\"roles\":[\"Parent\"]", "\"to_all\":false", "\"method\":\"text\"", "_created_at", "_modified_at"] },
    { "why": "a stranger reads the one that went to a public role, and not the other", "do": "GET {api}/log", "is": { "/entries/0/id": "{new}", "/entries/0/message": "Bring cakes.", "/entries/1/id": "old1" }, "lacks": ["Practice moved.", "Collaborator", "{did:collaborator}"] },
    { "why": "a member reads both", "as": "viewer", "do": "GET {api}/log", "is": { "/entries/0/id": "{text}", "/entries/1/id": "{new}", "/entries/1/sent_by_name": "Collaborator" } },

    { "why": "settings are the owner's, not a collaborator's", "as": "collaborator", "do": "POST {api}/settings", "body": { "title": "Mine", "public_roles": ["Coach"] }, "status": 403 },
    { "why": "nor an admin's", "as": "admin", "do": "POST {api}/settings", "body": { "title": "Mine", "public_roles": ["Coach"] }, "status": 403 },
    { "why": "and stayed as they were", "do": "GET {api}/state", "is": { "/settings": { "title": "Club news", "public_roles": ["Parent"] } } },
    { "why": "the owner's are kept", "as": "owner", "do": "POST {api}/settings", "body": { "title": " Team news ", "public_roles": ["Parent", "Coach", "Coach"] }, "status": 200, "is": { "/settings": { "title": "Team news", "public_roles": ["Parent", "Coach"] } } },
    { "why": "in the settings row", "table": "__fc_settings", "has": ["Team news"], "lacks": ["Hijack", "Club news"] },
    { "why": "so a stranger now reads what went to the coaches too", "do": "GET {api}/log", "is": { "/entries/0/id": "{text}", "/entries/0/message": "Practice moved.", "/entries/1/id": "{new}", "/anon_view": true }, "lacks": ["Old everyone note", "Collaborator"] },

    { "why": "a send to another list is not this session's to remove", "as": "collaborator", "do": "POST {api}/log/delete", "body": { "id": "old3" }, "status": 404 },
    { "why": "nor one there is no such thing as", "as": "collaborator", "do": "POST {api}/log/delete", "body": { "id": "nope" }, "status": 404 },
    { "why": "nor one unnamed", "as": "collaborator", "do": "POST {api}/log/delete", "body": {}, "status": 400 },
    { "why": "a send is removed from the log", "as": "collaborator", "do": "POST {api}/log/delete", "body": { "id": "{new}" }, "status": 204 },
    { "why": "and is gone, the rest kept", "table": "reachout_sent", "has": ["Practice moved.", "Old parent note", "Other list note"], "lacks": ["Bring cakes."] },
    { "why": "an unknown route changes nothing", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404 }
  ]
}
