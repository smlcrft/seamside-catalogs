{
  "tier": "members",
  "publish": "open",
  "steps": [
    {"why": "a plot an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/garden_plots/old1", "body": {"name": "North bed", "pos_json": "{\"x\":1,\"y\":2,\"w\":3,\"h\":2}", "assigned_member_id": "m1", "assigned_manual_name": "", "plant_types_json": "[{\"plant_type\":\"tomatoes\",\"planted_at\":1000,\"planted_stage\":\"seed\"}]", "shade_pct": 50, "notes": "secret note", "_created_at": 5, "_modified_at": 5}, "status": 200},
    {"why": "a roster Member Manager keeps", "as": "collaborator", "at": "space", "do": "KV.PUT t/members/m1", "body": {"name": "Ada Grower", "role": "grower", "_created_at": 1, "_modified_at": 1}, "status": 200},
    {"why": "the list an installed copy was bound to", "as": "collaborator", "at": "space", "do": "KV.PUT bound/members f:{id}", "body": "members", "status": 200},
    {"why": "and the settings it kept in the session", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"org_name\": \"Old Garden\", \"location\": \"\", \"grid_cols\": 24, \"grid_rows\": 16, \"grid_px\": 32, \"owner_only_edit\": false, \"allow_public_viewing\": false}", "status": 200},
    {"why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["id=\"canvas\""]},
    {"why": "and its script", "do": "GET {frame}/index.js", "status": 200, "has": ["garden_planner"]},
    {"why": "and the list chooser", "do": "GET {frame}/members_list.js", "status": 200},
    {"why": "and its style", "do": "GET {frame}/index.css", "status": 200},
    {"why": "a stranger is told the garden's name and that they may change nothing", "do": "GET {api}/state", "status": 200, "is": {"/viewer": {"user_name": "anon", "is_owner": false, "is_anon": true}, "/can_edit": false, "/can_bind": false, "/prefs/org_name": "Old Garden", "/prefs/grid_cols": 24, "/weather": null}},
    {"why": "the settings an installed copy kept are moved into the session's own settings row", "table": "__fc_settings", "has": ["\"id\":\"prefs\"", "Old Garden", "allow_public_viewing"]},
    {"why": "and are gone from the door", "as": "collaborator", "at": "space", "do": "KV.GET prefs f:{id}", "status": 404},
    {"why": "a stranger reads no settings row at the door", "do": "KV.GET t/__fc_settings/prefs f:{id}", "status": 403, "lacks": ["Old Garden"]},
    {"why": "a collaborator writes none there", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/prefs f:{id}", "body": {"v": "{\"allow_public_viewing\": true}"}, "status": 403},
    {"why": "and a session key written at the door is no setting any more", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"org_name\": \"Hijack\", \"allow_public_viewing\": true}", "status": 200},
    {"why": "the garden is still closed to a stranger", "do": "GET {api}/plots", "status": 200, "is": {"/rows": [], "/public_disabled": true}, "lacks": ["North bed"]},
    {"why": "and named as it was", "do": "GET {api}/state", "is": {"/prefs/org_name": "Old Garden", "/prefs/allow_public_viewing": false}},
    {"why": "and is shown no plot while public viewing is off", "do": "GET {api}/plots", "status": 200, "is": {"/rows": [], "/public_disabled": true}, "lacks": ["North bed", "Ada", "secret note"]},
    {"why": "nor the roster", "do": "GET {api}/members", "status": 200, "is": {"/rows": []}, "lacks": ["Ada"]},
    {"why": "a stranger adds no plot", "do": "POST {api}/plot", "body": {"name": "Mine", "pos_x": 0, "pos_y": 0, "width": 1, "height": 1}, "status": 403},
    {"why": "moves none", "do": "POST {api}/plot/move", "body": {"row_id": "old1", "pos_x": 0, "pos_y": 0, "width": 1, "height": 1}, "status": 403},
    {"why": "deletes none", "do": "POST {api}/plot/delete", "body": {"row_id": "old1"}, "status": 403},
    {"why": "changes no setting", "do": "POST {api}/settings", "body": {"allow_public_viewing": true}, "status": 403},
    {"why": "binds no list", "do": "POST {api}/bind", "body": {"list": "members"}, "status": 403},
    {"why": "a stranger writes no row at the door", "do": "KV.PUT t/garden_plots/x", "body": {"name": "x"}, "status": 403},
    {"why": "and reads no plot there", "do": "KV.LIST t/garden_plots/", "lacks": ["North bed", "secret note"]},
    {"why": "nor the roster", "do": "KV.LIST t/members/", "lacks": ["Ada"]},
    {"why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/plots", "status": 200, "is": {"/rows": [], "/public_disabled": true}},
    {"why": "and writes nothing", "as": "signed", "do": "POST {api}/plot", "body": {"name": "Mine"}, "status": 403},
    {"why": "the old plot is untouched", "table": "garden_plots", "has": ["North bed", "secret note"], "lacks": ["Mine"]},
    {"why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": {"/viewer": {"user_name": "Viewer", "is_owner": false, "is_anon": false}, "/can_edit": false, "/can_bind": false, "/bound": "members"}},
    {"why": "a viewer reads the plot an installed copy left, names and notes with it", "as": "viewer", "do": "GET {api}/plots", "status": 200, "is": {"/rows/0/_row_id": "old1", "/rows/0/name": "North bed", "/rows/0/pos_x": 1, "/rows/0/pos_y": 2, "/rows/0/width": 3, "/rows/0/height": 2, "/rows/0/shade_pct": 50, "/rows/0/assigned_member_id": "m1", "/rows/0/assigned_label": "Ada Grower", "/rows/0/notes": "secret note", "/rows/0/per_plant/0/label": "Tomatoes", "/rows/0/per_plant/0/current_stage": "adult", "/rows/0/stress_known": false, "/anon_view": false, "/weather_available": false}},
    {"why": "and the roster", "as": "viewer", "do": "GET {api}/members", "status": 200, "is": {"/rows": [{"_row_id": "m1", "name": "Ada Grower", "role": "grower"}]}},
    {"why": "a viewer adds no plot", "as": "viewer", "do": "POST {api}/plot", "body": {"name": "Mine"}, "status": 403, "is": {"/error": "editing is restricted"}},
    {"why": "moves none", "as": "viewer", "do": "POST {api}/plot/move", "body": {"row_id": "old1", "pos_x": 0, "pos_y": 0, "width": 1, "height": 1}, "status": 403},
    {"why": "deletes none", "as": "viewer", "do": "POST {api}/plot/delete", "body": {"row_id": "old1"}, "status": 403},
    {"why": "binds no list", "as": "viewer", "do": "POST {api}/bind", "body": {"list": "members"}, "status": 403, "is": {"/error": "editors only"}},
    {"why": "changes no setting", "as": "viewer", "do": "POST {api}/settings", "body": {"org_name": "Mine"}, "status": 403},
    {"why": "a collaborator may edit and bind", "as": "collaborator", "do": "GET {api}/state", "is": {"/can_edit": true, "/can_bind": true, "/viewer/is_owner": false}},
    {"why": "a collaborator adds a plot", "as": "collaborator", "do": "POST {api}/plot", "body": {"name": " South bed ", "pos_x": 5, "pos_y": 1, "width": 2, "height": 2, "assigned_member_id": "", "assigned_manual_name": "Anna's friend", "plants": [{"plant_type": "herbs", "planted_at": 2000, "planted_stage": "sprout"}, {"plant_type": "herbs"}, {"plant_type": "triffids"}], "notes": "by the gate"}, "status": 200, "save": {"new": "/row_id"}},
    {"why": "as a row of the space, in the shape installed copies hold", "table": "garden_plots", "has": ["\"name\":\"South bed\"", "{\\\"x\\\":5,\\\"y\\\":1,\\\"w\\\":2,\\\"h\\\":2}", "\"assigned_manual_name\":\"Anna's friend\"", "[{\\\"plant_type\\\":\\\"herbs\\\",\\\"planted_at\\\":2000,\\\"planted_stage\\\":\\\"sprout\\\"}]", "\"shade_pct\":100", "\"notes\":\"by the gate\"", "_created_at", "_modified_at"], "lacks": ["triffids"]},
    {"why": "a plot with nothing said is a plot", "as": "collaborator", "do": "POST {api}/plot", "body": {}, "status": 200, "save": {"bare": "/row_id"}},
    {"why": "a body that is no JSON is refused", "as": "collaborator", "do": "POST {api}/plot", "body": "nope", "status": 400},
    {"why": "a move with no plot named is refused", "as": "collaborator", "do": "POST {api}/plot/move", "body": {"pos_x": 1}, "status": 400, "is": {"/error": "row_id required"}},
    {"why": "a plot is moved, held inside the grid", "as": "collaborator", "do": "POST {api}/plot/move", "body": {"row_id": "old1", "pos_x": 22, "pos_y": 3, "width": 9, "height": 1}, "status": 200},
    {"why": "over the row, which kept what it held", "as": "viewer", "do": "GET {api}/plots", "is": {"/rows/0/_row_id": "old1", "/rows/0/pos_x": 22, "/rows/0/pos_y": 3, "/rows/0/width": 2, "/rows/0/notes": "secret note", "/rows/0/assigned_label": "Ada Grower", "/rows/0/shade_pct": 50, "/rows/1/_row_id": "{new}", "/rows/1/assigned_label": "Anna's friend", "/rows/1/per_plant/0/current_stage": "adult", "/rows/2/_row_id": "{bare}", "/rows/2/shade_pct": 100}},
    {"why": "and when it was made", "table": "garden_plots", "has": ["\"_created_at\":5"]},
    {"why": "a plot is edited", "as": "collaborator", "do": "POST {api}/plot", "body": {"row_id": "{new}", "name": "South bed", "pos_x": 5, "pos_y": 1, "width": 2, "height": 2, "shade_pct": 10, "assigned_member_id": "m1", "assigned_manual_name": "dropped", "plants": []}, "status": 200, "is": {"/row_id": "{new}"}},
    {"why": "a member's name stands where a typed one did", "as": "viewer", "do": "GET {api}/plots", "is": {"/rows/1/assigned_label": "Ada Grower", "/rows/1/assigned_manual_name": "", "/rows/1/shade_pct": 0, "/rows/1/per_plant": [], "/rows/1/notes": ""}},
    {"why": "a list that is not a members list is refused", "as": "collaborator", "do": "POST {api}/bind", "body": {"list": "garden_plots"}, "status": 400},
    {"why": "another list is bound", "as": "collaborator", "do": "POST {api}/bind", "body": {"list": "club.members"}, "status": 200, "is": {"/bound": "club.members"}},
    {"why": "and its people, none yet, are the roster", "as": "viewer", "do": "GET {api}/members", "is": {"/rows": []}},
    {"why": "so a plot names nobody from the old one", "as": "viewer", "do": "GET {api}/plots", "is": {"/rows/0/assigned_label": "", "/rows/0/assigned_member_id": "m1"}, "lacks": ["Ada"]},
    {"why": "the first list again", "as": "collaborator", "do": "POST {api}/bind", "body": {"list": "members"}, "status": 200},
    {"why": "the settings are the owner's alone", "as": "admin", "do": "POST {api}/settings", "body": {"org_name": "Mine", "allow_public_viewing": true}, "status": 403, "is": {"/error": "only the frame owner can change settings"}},
    {"why": "and unchanged", "do": "GET {api}/state", "is": {"/prefs/org_name": "Old Garden", "/prefs/allow_public_viewing": false}},
    {"why": "the owner opens the garden and keeps editing to themselves", "as": "owner", "do": "POST {api}/settings", "body": {"org_name": " Creek Garden ", "location": "", "grid_cols": 20, "grid_rows": 10, "grid_px": 99, "owner_only_edit": true, "allow_public_viewing": true}, "status": 200, "is": {"/prefs/org_name": "Creek Garden", "/prefs/grid_px": 80}},
    {"why": "in the settings row", "table": "__fc_settings", "has": ["Creek Garden"], "lacks": ["Hijack", "Old Garden"]},
    {"why": "they are read", "do": "GET {api}/state", "is": {"/prefs/org_name": "Creek Garden", "/prefs/grid_cols": 20, "/prefs/grid_rows": 10, "/prefs/allow_public_viewing": true, "/prefs/owner_only_edit": true}},
    {"why": "a stranger is shown the layout now, and no name or note", "do": "GET {api}/plots", "status": 200, "is": {"/anon_view": true, "/rows/0/_row_id": "old1", "/rows/0/name": "North bed", "/rows/0/pos_x": 19, "/rows/0/width": 1, "/rows/0/assigned_label": "", "/rows/0/per_plant/0/label": "Tomatoes", "/rows/1/assigned_label": ""}, "lacks": ["Ada", "secret note", "assigned_member_id", "assigned_manual_name", "notes", "public_disabled"]},
    {"why": "and still no roster", "do": "GET {api}/members", "is": {"/rows": []}},
    {"why": "nor may they write", "do": "POST {api}/plot/delete", "body": {"row_id": "old1"}, "status": 403},
    {"why": "a collaborator no longer edits", "as": "collaborator", "do": "GET {api}/state", "is": {"/can_edit": false, "/can_bind": true}},
    {"why": "and is refused", "as": "collaborator", "do": "POST {api}/plot/delete", "body": {"row_id": "old1"}, "status": 403, "is": {"/error": "editing is restricted"}},
    {"why": "nor an admin", "as": "admin", "do": "POST {api}/plot", "body": {"name": "Mine"}, "status": 403},
    {"why": "the owner still edits", "as": "owner", "do": "GET {api}/state", "is": {"/viewer/is_owner": true, "/can_edit": true}},
    {"why": "and gives editing back", "as": "owner", "do": "POST {api}/settings", "body": {"org_name": "Creek Garden", "location": "", "grid_cols": 20, "grid_rows": 10, "grid_px": 32, "owner_only_edit": false, "allow_public_viewing": true}, "status": 200},
    {"why": "a plot is taken out", "as": "collaborator", "do": "POST {api}/plot/delete", "body": {"row_id": "{bare}"}, "status": 200},
    {"why": "a delete with no plot named is refused", "as": "collaborator", "do": "POST {api}/plot/delete", "body": {}, "status": 400},
    {"why": "and is gone", "do": "GET {api}/plots", "is": {"/rows/0/_row_id": "old1", "/rows/1/_row_id": "{new}"}, "lacks": ["{bare}"]},
    {"why": "an unknown write is not found", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404}
  ]
}
