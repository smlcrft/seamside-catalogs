{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a link already in the table", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fbookmarks/old1", "body": { "url": "https://example.com/old-guide", "title": "Old guide", "domain": "example.com", "note": "from before", "tags": "docs,old", "added_ms": 5, "added_by": "Ana", "_created_at": 5, "_modified_at": 5 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["id=\"app\"", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["<form", "busSend", "frame.api"] },
    { "why": "a stranger is told who they are", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "and reads the links, the old one in the shape it was left", "do": "GET {api}/list", "status": 200, "is": { "/bookmarks/0/id": "old1", "/bookmarks/0/url": "https://example.com/old-guide", "/bookmarks/0/title": "Old guide", "/bookmarks/0/domain": "example.com", "/bookmarks/0/note": "from before", "/bookmarks/0/tags": ["docs", "old"], "/bookmarks/0/added_ms": 5, "/bookmarks/0/added_by": "Ana" }, "absent": ["/bookmarks/1"] },
    { "why": "a stranger saves nothing", "do": "POST {api}/bookmark", "body": { "url": "https://sneak.example.org/" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "renames nothing", "do": "POST {api}/bookmark/old1", "body": { "title": "mine" }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/bookmark/old1/delete", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fbookmarks/x", "body": { "url": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fbookmarks/", "lacks": ["old-guide", "from before"] },

    { "why": "someone signed in and on no roster is named to themselves", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "reads the links", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/bookmarks/0/id": "old1" } },
    { "why": "and saves nothing", "as": "signed", "do": "POST {api}/bookmark", "body": { "url": "https://sneak.example.org/" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the links", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/bookmarks/0/title": "Old guide" } },
    { "why": "a viewer saves nothing", "as": "viewer", "do": "POST {api}/bookmark", "body": { "url": "https://mine.example.org/" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "retags nothing", "as": "viewer", "do": "PUT {api}/bookmark/old1", "body": { "tags": "mine" }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/bookmark/old1/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Fbookmarks/x", "body": { "url": "x" }, "status": 403 },
    { "why": "nothing was written by any of that", "table": "_fdata/bookmarks", "has": ["Old guide"], "lacks": ["sneak", "mine", "\"x\""] },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_editor": true, "/is_owner": false, "/user_id": "{did:collaborator}" } },
    { "why": "what is not a web address is refused", "as": "collaborator", "do": "POST {api}/bookmark", "body": { "url": "javascript:alert(1)" }, "status": 400, "is": { "/error": "that doesn't look like a web address" } },
    { "why": "nor a bare word", "as": "collaborator", "do": "POST {api}/bookmark", "body": { "url": "localhost" }, "status": 400 },
    { "why": "a collaborator saves a link, its name read off the address", "as": "collaborator", "do": "POST {api}/bookmark", "body": { "url": "www.example.org/posts/how-to_brew-coffee.html", "tags": "#Coffee, how-to coffee" }, "status": 200, "is": { "/ok": true, "/title": "How to brew coffee", "/domain": "example.org" }, "absent": ["/duplicate"], "save": { "brew": "/id" } },
    { "why": "as a row of the space, in the table's shape", "table": "_fdata/bookmarks", "has": ["\"url\":\"https://www.example.org/posts/how-to_brew-coffee.html\"", "\"title\":\"How to brew coffee\"", "\"domain\":\"example.org\"", "\"note\":\"\"", "\"tags\":\"coffee,how-to\"", "\"added_by\":\"Collaborator\"", "added_ms", "_created_at", "_modified_at"] },
    { "why": "newest first", "as": "collaborator", "do": "GET {api}/list", "is": { "/bookmarks/0/id": "{brew}", "/bookmarks/0/tags": ["coffee", "how-to"], "/bookmarks/1/id": "old1" } },
    { "why": "the same link twice is the one already saved", "as": "collaborator", "do": "POST {api}/bookmark", "body": { "url": "https://www.example.org/posts/how-to_brew-coffee.html" }, "status": 200, "is": { "/duplicate": true, "/id": "{brew}" } },
    { "why": "and no second row", "as": "viewer", "do": "GET {api}/list", "absent": ["/bookmarks/2"] },
    { "why": "a link with a numeric slug is named for its site", "as": "collaborator", "do": "POST {api}/bookmark", "body": { "url": "https://news.example.net/item/12345", "title": "" }, "status": 200, "is": { "/title": "news.example.net" }, "save": { "news": "/id" } },
    { "why": "a link there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/bookmark/ghost", "body": { "title": "x" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an action there is none of", "as": "collaborator", "do": "POST {api}/bookmark/old1/nope", "body": {}, "status": 404 },
    { "why": "the old link is renamed", "as": "collaborator", "do": "POST {api}/bookmark/old1", "body": { "title": "  The old guide  " }, "status": 200, "is": { "/ok": true } },
    { "why": "an empty name leaves the name alone", "as": "collaborator", "do": "PUT {api}/bookmark/old1", "body": { "title": "   ", "note": "  kept for later " }, "status": 200 },
    { "why": "and retagged", "as": "collaborator", "do": "POST {api}/bookmark/old1", "body": { "tags": "Docs  reference docs" }, "status": 200 },
    { "why": "over the row, which kept what it held and when it was made", "table": "_fdata/bookmarks", "has": ["\"title\":\"The old guide\"", "\"note\":\"kept for later\"", "\"tags\":\"docs,reference\"", "\"added_by\":\"Ana\"", "\"added_ms\":5", "\"_created_at\":5", "\"url\":\"https://example.com/old-guide\""], "lacks": ["ghost", "Old guide", "from before"] },
    { "why": "a link is deleted", "as": "collaborator", "do": "POST {api}/bookmark/{news}/delete", "body": {}, "status": 200 },
    { "why": "and gone from the table", "table": "_fdata/bookmarks", "lacks": ["news.example.net"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin saves too", "as": "admin", "do": "POST {api}/bookmark", "body": { "url": "https://admin.example.com/" }, "status": 200, "is": { "/title": "admin.example.com" } },
    { "why": "the owner is told they are the owner", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner saves a link", "as": "owner", "do": "POST {api}/bookmark", "body": { "url": "https://owner.example.com/reading-list", "note": "mine" }, "status": 200, "is": { "/title": "Reading list" }, "save": { "own": "/id" } },
    { "why": "and deletes it", "as": "owner", "do": "POST {api}/bookmark/{own}/delete", "body": {}, "status": 200 },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "is": { "/bookmarks/0/domain": "admin.example.com", "/bookmarks/1/id": "{brew}", "/bookmarks/2/title": "The old guide", "/bookmarks/2/tags": ["docs", "reference"] }, "absent": ["/bookmarks/3"], "lacks": ["Reading list"] }
  ]
}
