{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the grid starts empty, and says what today is", "do": "GET {api}/list", "status": 200, "is": { "/window_days": 120 }, "absent": ["/habits/0"], "save": { "today": "/today" } },

    { "why": "a habit an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/habits/old1", "body": { "name": "Read", "sort_order": 1, "created_ms": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one ahead of it", "as": "collaborator", "at": "space", "do": "KV.PUT t/habits/old2", "body": { "name": "Stretch", "sort_order": 0, "created_ms": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "a mark for today", "as": "collaborator", "at": "space", "do": "KV.PUT t/habit_marks/m1", "body": { "habit_id": "old1", "day": "{today}", "made_ms": 7, "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "and one long past the window", "as": "collaborator", "at": "space", "do": "KV.PUT t/habit_marks/m2", "body": { "habit_id": "old1", "day": "2020-01-01", "made_ms": 8, "_created_at": 8, "_modified_at": 8 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Habit Tracker", "/lib/js/framelib.js", "/dyn/frame-prefs.css"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the grid, old rows in order, the window's marks only", "do": "GET {api}/list", "status": 200, "is": { "/today": "{today}", "/habits/0/id": "old2", "/habits/0/name": "Stretch", "/habits/0/sort_order": 0, "/habits/1/id": "old1", "/habits/1/name": "Read", "/habits/1/sort_order": 1, "/habits/1/days/0": "{today}" }, "absent": ["/habits/0/days/0", "/habits/1/days/1", "/habits/2", "/habits/0/created_ms"] },
    { "why": "a stranger adds nothing", "do": "POST {api}/habit", "body": { "name": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "marks nothing", "do": "POST {api}/mark", "body": { "habit_id": "old2", "day": "{today}", "done": 1 }, "status": 403 },
    { "why": "renames nothing", "do": "POST {api}/habit/old1", "body": { "name": "sneak" }, "status": 403 },
    { "why": "removes nothing", "do": "POST {api}/habit/old1/delete", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/habits/x", "body": { "name": "x" }, "status": 403 },
    { "why": "nor a mark", "do": "KV.PUT t/habit_marks/x", "body": { "habit_id": "old2", "day": "{today}" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/habits/", "lacks": ["Stretch", "Read"] },
    { "why": "the habits are as they were", "table": "habits", "has": ["\"name\":\"Read\"", "\"name\":\"Stretch\""], "lacks": ["sneak", "\"x\""] },
    { "why": "and the marks", "table": "habit_marks", "has": ["\"m1\"", "\"m2\""], "lacks": ["\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the grid", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/habits/1/id": "old1", "/habits/1/days/0": "{today}" } },
    { "why": "and marks nothing", "as": "signed", "do": "POST {api}/mark", "body": { "habit_id": "old2", "day": "{today}", "done": 1 }, "status": 403 },
    { "why": "nor adds", "as": "signed", "do": "POST {api}/habit", "body": { "name": "sneak" }, "status": 403 },

    { "why": "a viewer is a member who may not mark", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the grid", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/habits/0/name": "Stretch" } },
    { "why": "a viewer adds nothing", "as": "viewer", "do": "POST {api}/habit", "body": { "name": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "marks nothing", "as": "viewer", "do": "POST {api}/mark", "body": { "habit_id": "old2", "day": "{today}", "done": 1 }, "status": 403 },
    { "why": "unmarks nothing", "as": "viewer", "do": "POST {api}/mark", "body": { "habit_id": "old1", "day": "{today}", "done": 0 }, "status": 403 },
    { "why": "renames nothing", "as": "viewer", "do": "POST {api}/habit/old1", "body": { "name": "mine" }, "status": 403 },
    { "why": "removes nothing", "as": "viewer", "do": "POST {api}/habit/old1/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/habit_marks/x", "body": { "habit_id": "old2", "day": "{today}" }, "status": 403 },
    { "why": "so the marks are as they were", "table": "habit_marks", "has": ["\"m1\""], "lacks": ["\"x\"", "\"habit_id\":\"old2\""] },

    { "why": "a collaborator may mark", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a habit with no name is refused", "as": "collaborator", "do": "POST {api}/habit", "body": { "name": "   " }, "status": 400, "is": { "/error": "name required" } },
    { "why": "a collaborator adds a habit, last, and is answered with the grid", "as": "collaborator", "do": "POST {api}/habit", "body": { "name": "  Meditate  " }, "status": 200, "is": { "/habits/2/name": "Meditate", "/habits/2/sort_order": 2, "/today": "{today}" }, "absent": ["/habits/2/days/0"], "save": { "med": "/habits/2/id" } },
    { "why": "as a row of the space, in the shape installed copies hold", "table": "habits", "has": ["\"name\":\"Meditate\"", "\"sort_order\":2", "\"created_ms\":", "_created_at", "_modified_at"] },
    { "why": "today is marked done", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "{today}", "done": 1 }, "status": 200, "is": { "/habits/2/days/0": "{today}" } },
    { "why": "as a mark row that names its habit and its day", "table": "habit_marks", "has": ["\"habit_id\":\"{med}\"", "\"day\":\"{today}\"", "\"made_ms\":", "_created_at", "_modified_at"] },
    { "why": "marking it again makes no second mark", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "{today}", "done": true }, "status": 200, "is": { "/habits/2/days/0": "{today}" }, "absent": ["/habits/2/days/1"] },
    { "why": "a day in the future is refused", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "2999-01-01", "done": 1 }, "status": 400, "is": { "/error": "bad day" } },
    { "why": "a day that is not on the calendar is refused", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "2026-02-31", "done": 1 }, "status": 400, "is": { "/error": "bad day" } },
    { "why": "a day past the window is refused", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "2020-01-01", "done": 1 }, "status": 400, "is": { "/error": "bad day" } },
    { "why": "so is something that is not a day", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "{med}", "day": "yesterday", "done": 1 }, "status": 400, "is": { "/error": "bad day" } },
    { "why": "a habit there is no such thing as is refused", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "ghost", "day": "{today}", "done": 1 }, "status": 400, "is": { "/error": "bad habit" } },
    { "why": "and nothing was made for any of them", "table": "habit_marks", "lacks": ["2999-01-01", "2026-02-31", "ghost", "yesterday"] },
    { "why": "an old habit's mark is taken back", "as": "collaborator", "do": "POST {api}/mark", "body": { "habit_id": "old1", "day": "{today}", "done": 0 }, "status": 200, "is": { "/habits/1/id": "old1" }, "absent": ["/habits/1/days/0"] },
    { "why": "its row is gone, the old one past the window kept", "table": "habit_marks", "lacks": ["\"m1\""], "has": ["\"m2\""] },
    { "why": "an old habit is renamed", "as": "collaborator", "do": "PUT {api}/habit/old1", "body": { "name": " Read a chapter " }, "status": 200, "is": { "/habits/1/name": "Read a chapter", "/habits/1/sort_order": 1 } },
    { "why": "over the row, which kept what it held and when it was made", "table": "habits", "has": ["\"name\":\"Read a chapter\"", "\"created_ms\":5", "\"_created_at\":5"], "lacks": ["\"name\":\"Read\""] },
    { "why": "an empty name leaves it as it was", "as": "collaborator", "do": "POST {api}/habit/old1", "body": { "name": "  " }, "status": 200, "is": { "/habits/1/name": "Read a chapter" } },
    { "why": "a habit there is no such thing as is not renamed, never made", "as": "collaborator", "do": "POST {api}/habit/ghost", "body": { "name": "Ghost" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/habit/old1/nope", "body": {}, "status": 404 },
    { "why": "nothing was made for either", "table": "habits", "lacks": ["ghost", "Ghost"] },
    { "why": "a habit is removed", "as": "collaborator", "do": "POST {api}/habit/old1/delete", "body": {}, "status": 200, "is": { "/habits/0/id": "old2", "/habits/1/id": "{med}" }, "absent": ["/habits/2"], "lacks": ["Read a chapter"] },
    { "why": "gone from the table", "table": "habits", "lacks": ["Read a chapter"] },
    { "why": "and its marks with it, even the ones the grid never showed", "table": "habit_marks", "lacks": ["\"m2\"", "old1"], "has": ["\"habit_id\":\"{med}\""] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin marks too", "as": "admin", "do": "POST {api}/mark", "body": { "habit_id": "old2", "day": "{today}", "done": 1 }, "status": 200, "is": { "/habits/0/days/0": "{today}" } },
    { "why": "and adds", "as": "admin", "do": "POST {api}/habit", "body": { "name": "Walk" }, "status": 200, "is": { "/habits/2/name": "Walk", "/habits/2/sort_order": 3 } },
    { "why": "the owner may mark", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner adds a habit", "as": "owner", "do": "POST {api}/habit", "body": { "name": "Sleep early" }, "status": 200, "is": { "/habits/3/name": "Sleep early", "/habits/3/sort_order": 4 }, "save": { "sleep": "/habits/3/id" } },
    { "why": "marks it", "as": "owner", "do": "POST {api}/mark", "body": { "habit_id": "{sleep}", "day": "{today}", "done": 1 }, "status": 200, "is": { "/habits/3/days/0": "{today}" } },
    { "why": "and removes it", "as": "owner", "do": "POST {api}/habit/{sleep}/delete", "body": {}, "status": 200, "lacks": ["Sleep early"] },
    { "why": "its mark went with it", "table": "habit_marks", "lacks": ["{sleep}"] },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "is": { "/habits/0/name": "Stretch", "/habits/0/days/0": "{today}", "/habits/1/name": "Meditate", "/habits/1/days/0": "{today}", "/habits/2/name": "Walk" }, "absent": ["/habits/3", "/habits/2/days/0"] }
  ]
}
