{
  "tier": "members",
  "publish": "open",
  "steps": [
    {"why": "a title an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/camjam.title", "body": {"v": "\"Workbench\"", "_created_at": 1, "_modified_at": 1}, "status": 200},
    {"why": "and the rung it chose", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/camjam.interval_ms", "body": {"v": "5000", "_created_at": 1, "_modified_at": 1}, "status": 200},
    {"why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["share my camera", "/lib/js/framelib.js"], "lacks": ["<form", "busSend", "requestMediaAccess"]},
    {"why": "a stranger watches, named nobody, and is shown the old title and rung", "do": "GET {api}/state", "status": 200, "is": {"/is_sfi_member": false, "/is_owner": false, "/can_share": false, "/user_id": "", "/title": "Workbench", "/interval_ms": 5000, "/still_w": 480, "/live": null}, "absent": ["/steps"]},
    {"why": "a stranger shares no camera", "do": "POST {api}/claim", "body": {}, "status": 403},
    {"why": "sends no still", "do": "POST {api}/still", "body": {"jpeg": "abc"}, "status": 403},
    {"why": "renames nothing", "do": "POST {api}/title", "body": {"title": "Mine"}, "status": 403},
    {"why": "sets no rung", "do": "POST {api}/settings", "body": {"interval_ms": 500}, "status": 403},
    {"why": "a route there is none of", "do": "POST {api}/nothing", "body": {}, "status": 404},
    {"why": "a stranger writes no setting at the door", "do": "KV.PUT t/__fc_settings/camjam.title", "body": {"v": "\"x\""}, "status": 403},
    {"why": "someone signed in and on no roster watches too", "as": "signed", "do": "GET {api}/state", "is": {"/is_sfi_member": false, "/can_share": false, "/user_id": "{did:signed}"}, "absent": ["/steps"]},
    {"why": "and shares nothing", "as": "signed", "do": "POST {api}/claim", "body": {}, "status": 403},
    {"why": "nor renames", "as": "signed", "do": "POST {api}/title", "body": {"title": "Mine"}, "status": 403},
    {"why": "nothing was written by any of that", "table": "__fc_settings", "has": ["Workbench"], "lacks": ["Mine"]},
    {"why": "the owner is shown the ladder", "as": "owner", "do": "GET {api}/state", "is": {"/is_owner": true, "/is_sfi_member": true, "/can_share": true, "/steps/0": {"ms": 500, "w": 100}, "/steps/8": {"ms": 60000, "w": 1920}}},
    {"why": "an admin is no owner: no ladder", "as": "admin", "do": "GET {api}/state", "is": {"/is_owner": false, "/can_share": true}, "absent": ["/steps"]},
    {"why": "nor sets the rung", "as": "admin", "do": "POST {api}/settings", "body": {"interval_ms": 500}, "status": 403},
    {"why": "a collaborator sets no rung", "as": "collaborator", "do": "POST {api}/settings", "body": {"interval_ms": 500}, "status": 403},
    {"why": "the owner moves to the fastest rung", "as": "owner", "do": "POST {api}/settings", "body": {"interval_ms": 500}, "status": 200},
    {"why": "and everyone reads it", "do": "GET {api}/state", "is": {"/interval_ms": 500, "/still_w": 100}},
    {"why": "over the row an installed copy left", "table": "__fc_settings", "has": ["camjam.interval_ms", "\"v\":\"500\"", "\"_created_at\":1", "_modified_at"]},
    {"why": "a rung off the ladder falls back to the default", "as": "owner", "do": "POST {api}/settings", "body": {"interval_ms": 1234}, "status": 200},
    {"why": "never between rungs", "do": "GET {api}/state", "is": {"/interval_ms": 2000, "/still_w": 240}},
    {"why": "back to the fastest", "as": "owner", "do": "POST {api}/settings", "body": {"interval_ms": 500}, "status": 200},
    {"why": "a viewer is a member, and may share", "as": "viewer", "do": "GET {api}/state", "is": {"/is_sfi_member": true, "/can_share": true, "/is_owner": false, "/live": null}},
    {"why": "a still before claiming is refused", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": "abc"}, "status": 409},
    {"why": "the viewer claims the camera", "as": "viewer", "do": "POST {api}/claim", "body": {}, "status": 200},
    {"why": "and is warming up", "as": "viewer", "do": "GET {api}/state", "is": {"/live/user_name": "Viewer", "/live/is_me": true, "/live/jpeg": "", "/live/seq": 1}},
    {"why": "sends a still", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": "c3RpbGwx"}, "status": 200},
    {"why": "an empty one is refused", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": ""}, "status": 400},
    {"why": "and one over the rung's cap", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": ""}, "status": 413},
    {"why": "a stranger sees the still, and whose it is", "do": "GET {api}/state", "is": {"/live/user_name": "Viewer", "/live/is_me": false, "/live/jpeg": "c3RpbGwx", "/live/seq": 2}},
    {"why": "the still is kept nowhere", "table": "__fc_settings", "lacks": ["c3RpbGwx"]},
    {"why": "a wider rung lets a bigger still through at once", "as": "owner", "do": "POST {api}/settings", "body": {"interval_ms": 1000}, "status": 200},
    {"why": "the viewer's live limits follow", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": ""}, "status": 200},
    {"why": "another member does not send for the holder", "as": "collaborator", "do": "POST {api}/still", "body": {"jpeg": "bm9wZQ"}, "status": 409},
    {"why": "nor stops their feed", "as": "collaborator", "do": "POST {api}/stop", "body": {}, "status": 403},
    {"why": "a collaborator renames the feed", "as": "collaborator", "do": "POST {api}/title", "body": {"title": "  Bench cam  "}, "status": 200},
    {"why": "and every watcher reads it", "do": "GET {api}/state", "is": {"/title": "Bench cam", "/live/user_name": "Viewer"}},
    {"why": "kept where installed copies keep it", "table": "__fc_settings", "has": ["camjam.title", "\"v\":\"\\\"Bench cam\\\"\""]},
    {"why": "a collaborator takes over", "as": "collaborator", "do": "POST {api}/claim", "body": {}, "status": 200},
    {"why": "the viewer's page learns it is no longer the sharer", "as": "viewer", "do": "GET {api}/state", "is": {"/live/user_name": "Collaborator", "/live/is_me": false, "/live/jpeg": ""}},
    {"why": "and its stills are refused", "as": "viewer", "do": "POST {api}/still", "body": {"jpeg": "c3RpbGwy"}, "status": 409},
    {"why": "the owner cuts the feed", "as": "owner", "do": "POST {api}/stop", "body": {}, "status": 200},
    {"why": "and nobody is sharing", "do": "GET {api}/state", "is": {"/live": null}},
    {"why": "a viewer shares again, and stops their own", "as": "viewer", "do": "POST {api}/claim", "body": {}, "status": 200},
    {"why": "their own stop", "as": "viewer", "do": "POST {api}/stop", "body": {}, "status": 200},
    {"why": "ends it", "do": "GET {api}/state", "is": {"/live": null}},
    {"why": "a blank title reads as the default", "as": "viewer", "do": "POST {api}/title", "body": {"title": "   "}, "status": 200},
    {"why": "for everyone", "do": "GET {api}/state", "is": {"/title": "My CamJam Feed"}}
  ]
}
