{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a course an installed copy left behind", "as": "collaborator", "at": "space", "do": "KV.PUT t/assignments_courses/c1", "body": { "name": "Biology", "credits": 4, "sort_order": 0, "_created_at": 11, "_modified_at": 11 }, "status": 200 },
    { "why": "and a second", "as": "collaborator", "at": "space", "do": "KV.PUT t/assignments_courses/c2", "body": { "name": "History", "credits": 3, "sort_order": 1, "_created_at": 12, "_modified_at": 12 }, "status": 200 },
    { "why": "a marked, finished piece of work", "as": "collaborator", "at": "space", "do": "KV.PUT t/assignments/w1", "body": { "course_id": "c1", "title": "Lab report", "due": "2026-10-05", "weight": 30, "size": 3, "earned": 45, "possible": 50, "done": 1, "added_ms": 5, "_created_at": 21, "_modified_at": 21 }, "status": 200 },
    { "why": "one not marked, with no date", "as": "collaborator", "at": "space", "do": "KV.PUT t/assignments/w2", "body": { "course_id": "c1", "title": "Midterm", "due": "", "weight": 40, "size": 2, "earned": -1, "possible": 100, "done": 0, "added_ms": 6, "_created_at": 22, "_modified_at": 22 }, "status": 200 },
    { "why": "and one for the other course", "as": "collaborator", "at": "space", "do": "KV.PUT t/assignments/w3", "body": { "course_id": "c2", "title": "Essay", "due": "2026-09-01", "weight": 50, "size": 2, "earned": 80, "possible": 100, "done": 1, "added_ms": 7, "_created_at": 23, "_modified_at": 23 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Assignments", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["<form", "busSend", "frame.api"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger sees the board, old rows and all, graded by the worker", "do": "GET {api}/list", "status": 200, "is": { "/courses/0/id": "c1", "/courses/0/name": "Biology", "/courses/0/credits": 4, "/courses/0/pct": 90, "/courses/0/letter": "A-", "/courses/0/points": 3.7, "/courses/0/graded_weight": 30, "/courses/0/assigned_weight": 70, "/courses/1/id": "c2", "/courses/1/pct": 80, "/courses/1/letter": "B-", "/gpa": 3.27, "/graded_credits": 7, "/work/0/id": "w1", "/work/0/title": "Lab report", "/work/0/done": true, "/work/0/size": 3, "/work/0/earned": 45, "/work/1/id": "w2", "/work/1/earned": -1, "/work/1/done": false, "/work/1/due": "", "/work/2/course_id": "c2" }, "absent": ["/courses/2", "/work/3", "/work/0/_created_at"] },
    { "why": "a stranger adds no course", "do": "POST {api}/course", "body": { "name": "Sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "renames none", "do": "PUT {api}/course/c1", "body": { "name": "Sneak" }, "status": 403 },
    { "why": "removes none", "do": "POST {api}/course/c1/delete", "body": {}, "status": 403 },
    { "why": "adds no work", "do": "POST {api}/work", "body": { "title": "Sneak", "course_id": "c1" }, "status": 403 },
    { "why": "ticks nothing off", "do": "POST {api}/work/w2/done", "body": { "done": 1 }, "status": 403 },
    { "why": "scores nothing", "do": "POST {api}/work/w2/grade", "body": { "earned": "100" }, "status": 403 },
    { "why": "edits nothing", "do": "PUT {api}/work/w2", "body": { "title": "Sneak" }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/work/w1/delete", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/assignments/x", "body": { "title": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/assignments/", "lacks": ["Lab report", "Midterm"] },
    { "why": "nor the courses", "do": "KV.LIST t/assignments_courses/", "lacks": ["Biology"] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who sees the board", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/courses/0/name": "Biology", "/gpa": 3.27 } },
    { "why": "and changes nothing", "as": "signed", "do": "POST {api}/work/w2/grade", "body": { "earned": "100" }, "status": 403 },
    { "why": "nor adds a course", "as": "signed", "do": "POST {api}/course", "body": { "name": "Sneak" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer sees the board", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/work/2/title": "Essay" } },
    { "why": "a viewer adds no course", "as": "viewer", "do": "POST {api}/course", "body": { "name": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "adds no work", "as": "viewer", "do": "POST {api}/work", "body": { "title": "Mine", "course_id": "c1" }, "status": 403 },
    { "why": "ticks nothing off", "as": "viewer", "do": "POST {api}/work/w2/done", "body": { "done": 1 }, "status": 403 },
    { "why": "scores nothing", "as": "viewer", "do": "POST {api}/work/w2/grade", "body": { "earned": "90" }, "status": 403 },
    { "why": "removes no course", "as": "viewer", "do": "POST {api}/course/c2/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/assignments/x", "body": { "title": "x" }, "status": 403 },
    { "why": "nothing was written by any of that", "table": "assignments", "has": ["Lab report", "Midterm", "Essay"], "lacks": ["Sneak", "Mine", "\"x\""] },
    { "why": "nor to the courses", "table": "assignments_courses", "has": ["Biology", "History"], "lacks": ["Sneak", "Mine"] },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a course needs a name", "as": "collaborator", "do": "POST {api}/course", "body": { "name": "   " }, "status": 400, "is": { "/error": "name required" } },
    { "why": "a course is added last, its credits held to twenty", "as": "collaborator", "do": "POST {api}/course", "body": { "name": " Chemistry ", "credits": 99 }, "status": 200, "is": { "/ok": true } },
    { "why": "and shown ungraded", "as": "collaborator", "do": "GET {api}/list", "is": { "/courses/2/name": "Chemistry", "/courses/2/credits": 20, "/courses/2/sort_order": 2, "/courses/2/pct": null, "/courses/2/letter": null, "/courses/2/assigned_weight": 0 }, "save": { "chem": "/courses/2/id" } },
    { "why": "as a row of the space in the shape installed copies hold", "table": "assignments_courses", "has": ["\"name\":\"Chemistry\"", "\"credits\":20", "\"sort_order\":2", "\"id\":\"{chem}\"", "_created_at", "_modified_at"] },
    { "why": "a course given no credits is worth three", "as": "collaborator", "do": "POST {api}/course", "body": { "name": "Physics" }, "status": 200 },
    { "why": "after the others", "as": "collaborator", "do": "GET {api}/list", "is": { "/courses/3/name": "Physics", "/courses/3/credits": 3, "/courses/3/sort_order": 3 } },
    { "why": "a course is renamed and re-weighed", "as": "collaborator", "do": "PUT {api}/course/{chem}", "body": { "name": "Organic chemistry", "credits": 5 }, "status": 200 },
    { "why": "an old course is renamed", "as": "collaborator", "do": "PUT {api}/course/c1", "body": { "name": "Biology 101" }, "status": 200 },
    { "why": "each change landing over what the row held", "as": "collaborator", "do": "GET {api}/list", "is": { "/courses/0/name": "Biology 101", "/courses/0/credits": 4, "/courses/0/sort_order": 0, "/courses/2/name": "Organic chemistry", "/courses/2/credits": 5 } },
    { "why": "the old row kept when it was made", "table": "assignments_courses", "has": ["\"_created_at\":11", "Biology 101"], "lacks": ["\"Biology\""] },
    { "why": "a course there is none of is refused", "as": "collaborator", "do": "PUT {api}/course/ghost", "body": { "name": "Ghost" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "and an act there is none of", "as": "collaborator", "do": "POST {api}/course/c1/nope", "body": {}, "status": 404 },
    { "why": "nothing was made for either", "table": "assignments_courses", "lacks": ["ghost", "Ghost"] },

    { "why": "work needs a title", "as": "collaborator", "do": "POST {api}/work", "body": { "title": " ", "course_id": "c1" }, "status": 400, "is": { "/error": "title required" } },
    { "why": "and a course that exists", "as": "collaborator", "do": "POST {api}/work", "body": { "title": "Lost", "course_id": "ghost" }, "status": 400, "is": { "/error": "pick a course" } },
    { "why": "and a course at all", "as": "collaborator", "do": "POST {api}/work", "body": { "title": "Lost" }, "status": 400, "is": { "/error": "pick a course" } },
    { "why": "work is added, a date that is no date dropped and the numbers held in range", "as": "collaborator", "do": "POST {api}/work", "body": { "title": " Problem set ", "course_id": "{chem}", "due": "2026-02-31", "weight": 150, "size": 7, "possible": 20 }, "status": 200, "is": { "/ok": true } },
    { "why": "and read back unmarked", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/0/title": "Problem set", "/work/0/course_id": "{chem}", "/work/0/due": "", "/work/0/weight": 100, "/work/0/size": 3, "/work/0/earned": -1, "/work/0/possible": 20, "/work/0/done": false }, "save": { "ps": "/work/0/id" } },
    { "why": "work given only a title and a date takes the defaults", "as": "collaborator", "do": "POST {api}/work", "body": { "title": "Quiz", "course_id": "c2", "due": "2026-10-01" }, "status": 200 },
    { "why": "a middling size, no weight, out of a hundred", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/1/title": "Quiz", "/work/1/due": "2026-10-01", "/work/1/size": 2, "/work/1/weight": 0, "/work/1/possible": 100, "/work/1/earned": -1 }, "save": { "quiz": "/work/1/id" } },
    { "why": "as rows of the space in the shape installed copies hold", "table": "assignments", "has": ["\"title\":\"Problem set\"", "\"title\":\"Quiz\"", "\"earned\":-1", "\"done\":0", "\"added_ms\":", "_created_at", "_modified_at"] },

    { "why": "a score that is no number is refused", "as": "collaborator", "do": "POST {api}/work/{ps}/grade", "body": { "earned": "lots" }, "status": 400, "is": { "/error": "bad score" } },
    { "why": "nor a negative one", "as": "collaborator", "do": "POST {api}/work/{ps}/grade", "body": { "earned": "-3" }, "status": 400, "is": { "/error": "bad score" } },
    { "why": "a score marks it and finishes it", "as": "collaborator", "do": "POST {api}/work/{ps}/grade", "body": { "earned": "18" }, "status": 200 },
    { "why": "and the course and the GPA are graded from it", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/0/earned": 18, "/work/0/done": true, "/work/0/title": "Problem set", "/courses/2/pct": 90, "/courses/2/letter": "A-", "/courses/2/graded_weight": 100, "/gpa": 3.45, "/graded_credits": 12 } },
    { "why": "an empty score un-marks it, and it stays finished", "as": "collaborator", "do": "POST {api}/work/{ps}/grade", "body": { "earned": "" }, "status": 200 },
    { "why": "the course is ungraded again", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/0/earned": -1, "/work/0/done": true, "/courses/2/pct": null, "/gpa": 3.27, "/graded_credits": 7 } },

    { "why": "old work is ticked off", "as": "collaborator", "do": "POST {api}/work/w2/done", "body": { "done": 1 }, "status": 200 },
    { "why": "and is finished, the rest of it as it was", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/3/id": "w2", "/work/3/done": true, "/work/3/title": "Midterm", "/work/3/weight": 40, "/work/3/added_ms": 6 } },
    { "why": "over the row, which kept when it was made", "table": "assignments", "has": ["\"_created_at\":22"] },
    { "why": "and put back", "as": "collaborator", "do": "POST {api}/work/w2/done", "body": { "done": 0 }, "status": 200 },
    { "why": "old work is edited, moved to the other course", "as": "collaborator", "do": "PUT {api}/work/w2", "body": { "title": "Final exam", "due": "2026-12-10", "weight": "45", "size": 1, "course_id": "c2" }, "status": 200 },
    { "why": "a course there is none of is passed over", "as": "collaborator", "do": "PUT {api}/work/w2", "body": { "course_id": "ghost" }, "status": 200 },
    { "why": "and the edit is read back", "as": "collaborator", "do": "GET {api}/list", "is": { "/work/3/title": "Final exam", "/work/3/due": "2026-12-10", "/work/3/weight": 45, "/work/3/size": 1, "/work/3/course_id": "c2", "/work/3/done": false, "/work/3/added_ms": 6 } },
    { "why": "work there is none of is refused", "as": "collaborator", "do": "POST {api}/work/ghost/done", "body": { "done": 1 }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "and an act there is none of", "as": "collaborator", "do": "POST {api}/work/w2/nope", "body": {}, "status": 404 },
    { "why": "work is deleted", "as": "collaborator", "do": "POST {api}/work/{quiz}/delete", "body": {}, "status": 200 },
    { "why": "and gone from the board", "as": "collaborator", "do": "GET {api}/list", "lacks": ["Quiz"], "absent": ["/work/4"] },
    { "why": "a course is removed with its work", "as": "collaborator", "do": "POST {api}/course/c2/delete", "body": {}, "status": 200 },
    { "why": "and the board holds what is left", "as": "collaborator", "do": "GET {api}/list", "is": { "/courses/0/name": "Biology 101", "/courses/1/name": "Organic chemistry", "/courses/2/name": "Physics", "/work/0/id": "{ps}", "/work/1/id": "w1", "/gpa": 3.7, "/graded_credits": 4 }, "absent": ["/courses/3", "/work/2"] },
    { "why": "the course's rows are gone from the tables", "table": "assignments", "lacks": ["Essay", "Final exam", "Quiz"] },
    { "why": "and the course", "table": "assignments_courses", "lacks": ["History"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/course", "body": { "name": "Art", "credits": 2 }, "status": 200 },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner adds work", "as": "owner", "do": "POST {api}/work", "body": { "title": "Sketchbook", "course_id": "c1", "due": "2026-11-02", "weight": 20 }, "status": 200 },
    { "why": "and scores the lab report again", "as": "owner", "do": "POST {api}/work/w1/grade", "body": { "earned": "40", "possible": "50" }, "status": 200 },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "has": ["Sketchbook"], "is": { "/courses/3/name": "Art", "/courses/0/pct": 80, "/courses/0/letter": "B-", "/work/2/id": "w1", "/work/2/earned": 40 } }
  ]
