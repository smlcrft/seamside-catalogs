{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a collaborator sets a garden up, with a plant there is no such thing as dropped", "as": "collaborator", "do": "POST {api}/save", "body": { "location": "Portland, Oregon", "soil": "silty", "plants": ["tomatoes", "weeds", "herbs"] }, "status": 200, "is": { "/prefs": { "location": "Portland, Oregon", "soil": "silty", "plants": ["tomatoes", "herbs"] } } },

    { "why": "the page is served, stamped with nobody", "do": "GET {frame}/index.html", "status": 200, "has": ["Garden Gnome", "/dyn/frame-prefs.css", "settings-btn"], "lacks": ["__peer", "<form"] },
    { "why": "and at the root", "do": "GET {frame}/", "status": 200, "has": ["settings-btn"] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "and its script", "do": "GET {frame}/index.js", "status": 200, "has": ["/lib/js/framelib.js"], "lacks": ["busSend", "__peer", "frame.api"] },
    { "why": "the worker's own code is not a page", "do": "GET {frame}/frame.ts", "status": 404, "lacks": ["PLANT_PROFILES"] },

    { "why": "a stranger reads the board, the town withheld whether or not its weather could be looked up", "do": "GET {api}/state", "status": 200, "is": { "/prefs/location": "", "/prefs/soil": "silty", "/prefs/plants": ["tomatoes", "herbs"], "/has_location": true, "/can_edit": false, "/is_owner": false, "/soil_types/3/key": "clay", "/plant_types/0/key": "seedlings_cold_hardy" }, "lacks": ["Portland", "Oregon"] },
    { "why": "and changes nothing", "do": "POST {api}/save", "body": { "location": "Mine", "soil": "clay", "plants": [] }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "the garden is kept as the session's own settings row", "table": "_settings", "has": ["\"id\":\"prefs\"", "Portland, Oregon", "silty", "_created_at", "_modified_at"], "lacks": ["weeds"] },
    { "why": "which the door hands no stranger", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Portland"] },
    { "why": "nor lists", "do": "KV.LIST t/_settings/ f:{id}", "status": 403, "lacks": ["Portland"] },
    { "why": "nor takes a stranger's write to", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"location\":\"Mine\",\"soil\":\"clay\",\"plants\":[]}" }, "status": 403 },
    { "why": "someone signed in and on no roster is a stranger too", "as": "signed", "do": "GET {api}/state", "status": 200, "is": { "/prefs/location": "", "/has_location": true, "/can_edit": false }, "lacks": ["Portland", "Oregon"] },
    { "why": "and changes nothing", "as": "signed", "do": "POST {api}/save", "body": { "location": "Mine", "soil": "clay", "plants": [] }, "status": 403 },

    { "why": "a viewer is a member, and reads the town", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/prefs/location": "Portland, Oregon", "/prefs/soil": "silty", "/prefs/plants": ["tomatoes", "herbs"], "/can_edit": false } },
    { "why": "and changes nothing", "as": "viewer", "do": "POST {api}/save", "body": { "location": "Mine", "soil": "clay", "plants": [] }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "nor reads the settings row at the door", "as": "viewer", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Portland"] },
    { "why": "nor writes it", "as": "viewer", "at": "space", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"location\":\"Mine\",\"soil\":\"clay\",\"plants\":[]}" }, "status": 403 },
    { "why": "nothing was written by any of that", "table": "_settings", "has": ["Portland, Oregon", "silty"], "lacks": ["Mine"] },
    { "why": "a collaborator neither reads the settings row at the door", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/prefs f:{id}", "status": 403, "lacks": ["Portland"] },
    { "why": "nor writes it past the worker", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/prefs f:{id}", "body": { "v": "{\"location\":\"Mine\",\"soil\":\"clay\",\"plants\":[]}" }, "status": 403 },
    { "why": "nor writes a key of the session's own", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"location\":\"Mine\",\"soil\":\"clay\",\"plants\":[]}", "status": 403 },
    { "why": "the garden is as it was", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/prefs/location": "Portland, Oregon", "/prefs/soil": "silty" }, "lacks": ["Mine"] },

    { "why": "a collaborator is an editor", "as": "collaborator", "do": "GET {api}/state", "status": 200, "is": { "/can_edit": true, "/prefs/location": "Portland, Oregon" } },
    { "why": "a save that is not JSON is refused", "as": "collaborator", "do": "POST {api}/save", "body": "not json", "status": 400, "is": { "/error": "invalid JSON" } },
    { "why": "a collaborator saves the garden: the town trimmed, a soil there is none of made loamy, a plant twice kept once, one there is none of dropped", "as": "collaborator", "do": "POST {api}/save", "body": { "location": "  Salem, Oregon ", "soil": "mud", "plants": ["beans", "beans", "weeds", "corn"] }, "status": 200, "is": { "/prefs": { "location": "Salem, Oregon", "soil": "loamy", "plants": ["beans", "corn"] } } },
    { "why": "kept as the session's settings row", "table": "_settings", "has": ["{\\\"location\\\":\\\"Salem, Oregon\\\",\\\"soil\\\":\\\"loamy\\\",\\\"plants\\\":[\\\"beans\\\",\\\"corn\\\"]}"], "lacks": ["weeds", "Portland"] },
    { "why": "which a viewer reads", "as": "viewer", "do": "GET {api}/state", "is": { "/prefs/location": "Salem, Oregon", "/prefs/plants": ["beans", "corn"] } },
    { "why": "and a stranger reads without the town, in the weather's place name too", "do": "GET {api}/state", "is": { "/prefs/location": "", "/prefs/plants": ["beans", "corn"], "/has_location": true }, "lacks": ["Salem"] },

    { "why": "the keeper's own browser is an editor too", "as": "owner", "do": "GET {api}/state", "status": 200, "is": { "/can_edit": true, "/prefs/location": "Salem, Oregon" } },
    { "why": "and clears the town", "as": "owner", "do": "POST {api}/save", "body": { "location": "", "soil": "chalky", "plants": ["lavender"] }, "status": 200, "is": { "/prefs": { "location": "", "soil": "chalky", "plants": ["lavender"] } } },
    { "why": "a garden with no town is not set up, and fetches nothing", "do": "GET {api}/state", "is": { "/has_location": false, "/weather": null, "/statuses": [], "/prefs/soil": "chalky" } },
    { "why": "an admin is an editor", "as": "admin", "do": "POST {api}/save", "body": { "location": "", "soil": "clay", "plants": [] }, "status": 200, "is": { "/prefs/soil": "clay" } },

    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nothing", "body": {}, "status": 404, "is": { "/code": "NOT_FOUND" } },
    { "why": "nor anything that is not GET", "as": "collaborator", "do": "DELETE {api}/state", "status": 404 },
    { "why": "a stranger is told the same", "do": "POST {api}/nothing", "body": {}, "status": 404 }
  ]
}
