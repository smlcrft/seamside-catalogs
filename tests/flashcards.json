{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a deck already in the table, second in order", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_decks/d1", "body": { "name": "Spanish", "sort_order": 1, "_created_at": 11, "_modified_at": 11 }, "status": 200 },
    { "why": "and one first in order", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_decks/d0", "body": { "name": "French", "sort_order": 0, "_created_at": 10, "_modified_at": 10 }, "status": 200 },
    { "why": "a card in the second", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards/c1", "body": { "deck_id": "d1", "front": "hola", "back": "hello", "added_ms": 21, "_created_at": 21, "_modified_at": 21 }, "status": 200 },
    { "why": "another", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards/c2", "body": { "deck_id": "d1", "front": "gato", "back": "cat", "added_ms": 22, "_created_at": 22, "_modified_at": 22 }, "status": 200 },
    { "why": "and one in the first", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards/c3", "body": { "deck_id": "d0", "front": "chat", "back": "cat", "added_ms": 23, "_created_at": 23, "_modified_at": 23 }, "status": 200 },
    { "why": "the viewer's schedule on the first card, not due for a long while", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_reviews/r1", "body": { "card_id": "c1", "user_id": "{did:viewer}", "reps": 2, "ef": 2.5, "ivl": 6, "due": "2999-01-01", "seen_ms": 111, "_created_at": 31, "_modified_at": 31 }, "status": 200 },
    { "why": "somebody else's on the second", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_reviews/r2", "body": { "card_id": "c2", "user_id": "did:old", "reps": 5, "ef": 2.2, "ivl": 40, "due": "2999-02-02", "seen_ms": 222, "_created_at": 32, "_modified_at": 32 }, "status": 200 },
    { "why": "and the collaborator's own on the first", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_reviews/r3", "body": { "card_id": "c1", "user_id": "{did:collaborator}", "reps": 1, "ef": 2.5, "ivl": 1, "due": "2000-01-01", "seen_ms": 333, "_created_at": 33, "_modified_at": 33 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Flashcards", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["busSend", "frame.api"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the decks as they were put in, in order, every card new", "do": "GET {api}/list", "status": 200, "is": { "/decks/0/id": "d0", "/decks/0/name": "French", "/decks/0/total": 1, "/decks/1/id": "d1", "/decks/1/name": "Spanish", "/decks/1/total": 2, "/decks/1/due": 2, "/decks/1/fresh": 2, "/cards/0/id": "c1", "/cards/0/front": "hola", "/cards/0/is_new": true, "/cards/0/reps": 0, "/next_due": "", "/can_study": false }, "absent": ["/decks/2", "/cards/3"], "lacks": ["2999-01-01", "2999-02-02", "did:"] },
    { "why": "a stranger studies nothing", "do": "POST {api}/review", "body": { "card_id": "c3", "quality": 4 }, "status": 403, "is": { "/error": "members only" } },
    { "why": "makes no deck", "do": "POST {api}/deck", "body": { "name": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "renames none", "do": "POST {api}/deck/d0", "body": { "name": "sneak" }, "status": 403 },
    { "why": "removes none", "do": "POST {api}/deck/d1/delete", "body": {}, "status": 403 },
    { "why": "adds no card", "do": "POST {api}/card", "body": { "front": "sneak", "back": "sneak", "deck_id": "d0" }, "status": 403 },
    { "why": "edits none", "do": "PUT {api}/card/c1", "body": { "front": "sneak" }, "status": 403 },
    { "why": "removes none", "do": "POST {api}/card/c1/delete", "body": {}, "status": 403 },
    { "why": "resets none", "do": "POST {api}/card/c1/reset", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fflashcards_reviews/x", "body": { "card_id": "c1", "user_id": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fflashcards/", "lacks": ["hola", "gato"] },
    { "why": "nor anyone's schedule", "do": "KV.LIST t/_fdata%2Fflashcards_reviews/", "lacks": ["2999-01-01", "did:old"] },
    { "why": "the decks are as they were", "table": "_fdata/flashcards_decks", "has": ["French", "Spanish"], "lacks": ["sneak"] },
    { "why": "and the cards", "table": "_fdata/flashcards", "has": ["hola", "gato", "chat"], "lacks": ["sneak"] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/user_id": "{did:signed}" } },
    { "why": "who sees the decks and may not study", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/decks/0/name": "French", "/can_study": false } },
    { "why": "and studies nothing", "as": "signed", "do": "POST {api}/review", "body": { "card_id": "c3", "quality": 4 }, "status": 403, "is": { "/error": "members only" } },
    { "why": "nor makes a deck", "as": "signed", "do": "POST {api}/deck", "body": { "name": "sneak" }, "status": 403 },
    { "why": "their schedule was never written", "table": "_fdata/flashcards_reviews", "lacks": ["{did:signed}"] },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/user_name": "Viewer", "/user_id": "{did:viewer}" } },
    { "why": "a viewer sees their own schedule folded in, and nobody else's", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/can_study": true, "/cards/0/id": "c1", "/cards/0/is_new": false, "/cards/0/due_now": false, "/cards/0/reps": 2, "/cards/0/ivl": 6, "/cards/0/due": "2999-01-01", "/cards/0/preview": { "again": 1, "hard": 14, "good": 15, "easy": 16 }, "/cards/1/id": "c2", "/cards/1/is_new": true, "/cards/1/due": "", "/next_due": "2999-01-01", "/decks/1/due": 1, "/decks/1/fresh": 1 }, "lacks": ["2999-02-02"] },
    { "why": "a new card's answers read tomorrow, tomorrow, tomorrow and four days", "as": "viewer", "do": "GET {api}/list", "is": { "/cards/1/preview": { "again": 1, "hard": 1, "good": 1, "easy": 4 } } },
    { "why": "a viewer studies a new card", "as": "viewer", "do": "POST {api}/review", "body": { "card_id": "c2", "quality": 4 }, "status": 200, "is": { "/ok": true, "/reps": 1, "/ivl": 1, "/ef": 2.5 } },
    { "why": "as a row of their own, from the schema's defaults, stamped", "table": "_fdata/flashcards_reviews", "has": ["\"card_id\":\"c2\"", "\"user_id\":\"{did:viewer}\"", "\"reps\":1", "_created_at", "_modified_at"] },
    { "why": "and answers easy on one they know", "as": "viewer", "do": "POST {api}/review", "body": { "card_id": "c1", "quality": 5 }, "status": 200, "is": { "/reps": 3, "/ef": 2.6, "/ivl": 16 } },
    { "why": "over the row they had, which kept when it was made", "table": "_fdata/flashcards_reviews", "has": ["\"ivl\":16", "\"_created_at\":31"], "lacks": ["\"seen_ms\":111", "2999-01-01"] },
    { "why": "and nobody else's schedule moved", "table": "_fdata/flashcards_reviews", "has": ["\"seen_ms\":222", "\"seen_ms\":333", "2999-02-02"] },
    { "why": "a card there is no such thing as is refused", "as": "viewer", "do": "POST {api}/review", "body": { "card_id": "ghost", "quality": 4 }, "status": 400, "is": { "/error": "bad card" } },
    { "why": "and an answer past five", "as": "viewer", "do": "POST {api}/review", "body": { "card_id": "c3", "quality": 9 }, "status": 400, "is": { "/error": "bad quality" } },
    { "why": "a viewer makes no deck", "as": "viewer", "do": "POST {api}/deck", "body": { "name": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "adds no card", "as": "viewer", "do": "POST {api}/card", "body": { "front": "mine", "back": "mine", "deck_id": "d0" }, "status": 403 },
    { "why": "edits none", "as": "viewer", "do": "PUT {api}/card/c3", "body": { "back": "mine" }, "status": 403 },
    { "why": "resets nothing", "as": "viewer", "do": "POST {api}/card/c1/reset", "body": {}, "status": 403 },
    { "why": "removes no deck", "as": "viewer", "do": "POST {api}/deck/d0/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Fflashcards_reviews/x", "body": { "card_id": "c1", "user_id": "x" }, "status": 403 },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a deck with no name is refused", "as": "collaborator", "do": "POST {api}/deck", "body": { "name": "   " }, "status": 400, "is": { "/error": "name required" } },
    { "why": "a collaborator makes a deck, last", "as": "collaborator", "do": "POST {api}/deck", "body": { "name": " German " }, "status": 200, "is": { "/ok": true }, "save": { "german": "/id" } },
    { "why": "as a row of the space, in the table's shape", "table": "_fdata/flashcards_decks", "has": ["\"name\":\"German\"", "\"sort_order\":2", "_created_at", "_modified_at"] },
    { "why": "and it lists after the others", "as": "collaborator", "do": "GET {api}/list", "is": { "/decks/2/id": "{german}", "/decks/2/name": "German", "/decks/2/total": 0 } },
    { "why": "a card with one side is refused", "as": "collaborator", "do": "POST {api}/card", "body": { "front": "Hund", "back": " ", "deck_id": "{german}" }, "status": 400, "is": { "/error": "both sides are needed" } },
    { "why": "and one for a deck there is none of", "as": "collaborator", "do": "POST {api}/card", "body": { "front": "Hund", "back": "dog", "deck_id": "ghost" }, "status": 400, "is": { "/error": "pick a deck" } },
    { "why": "a card is added", "as": "collaborator", "do": "POST {api}/card", "body": { "front": " Hund ", "back": "dog", "deck_id": "{german}" }, "status": 200, "is": { "/ok": true } },
    { "why": "as a row of the space, stamped", "table": "_fdata/flashcards", "has": ["\"front\":\"Hund\"", "\"back\":\"dog\"", "\"deck_id\":\"{german}\"", "\"added_ms\":"] },
    { "why": "a card is edited", "as": "collaborator", "do": "PUT {api}/card/c3", "body": { "back": " the cat " }, "status": 200 },
    { "why": "over the row, which kept what it held", "table": "_fdata/flashcards", "has": ["\"back\":\"the cat\"", "\"front\":\"chat\"", "\"added_ms\":23", "\"_created_at\":23"] },
    { "why": "a card moved to a deck there is none of stays put", "as": "collaborator", "do": "PUT {api}/card/c3", "body": { "deck_id": "ghost" }, "status": 200 },
    { "why": "and so it did", "as": "collaborator", "do": "GET {api}/list", "is": { "/decks/0/total": 1 } },
    { "why": "a deck is renamed", "as": "collaborator", "do": "POST {api}/deck/d0", "body": { "name": "Français" }, "status": 200 },
    { "why": "over its row", "table": "_fdata/flashcards_decks", "has": ["\"name\":\"Français\"", "\"_created_at\":10"], "lacks": ["\"name\":\"French\""] },
    { "why": "an id there is none of is refused, never made", "as": "collaborator", "do": "PUT {api}/card/ghost", "body": { "front": "x" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/deck/d0/nope", "body": {}, "status": 404 },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },
    { "why": "nothing was made for them", "table": "_fdata/flashcards", "lacks": ["ghost", "\"front\":\"x\""] },

    { "why": "a collaborator forgets their own progress on a card", "as": "collaborator", "do": "POST {api}/card/c1/reset", "body": {}, "status": 200 },
    { "why": "and only theirs", "table": "_fdata/flashcards_reviews", "has": ["\"ivl\":16"], "lacks": ["\"seen_ms\":333"] },
    { "why": "a card is removed, with everybody's progress on it", "as": "collaborator", "do": "POST {api}/card/c2/delete", "body": {}, "status": 200 },
    { "why": "the card is gone", "table": "_fdata/flashcards", "lacks": ["gato"] },
    { "why": "and every schedule on it", "table": "_fdata/flashcards_reviews", "has": ["\"card_id\":\"c1\""], "lacks": ["\"card_id\":\"c2\"", "did:old"] },
    { "why": "a deck is removed", "as": "collaborator", "do": "POST {api}/deck/d1/delete", "body": {}, "status": 200 },
    { "why": "and gone", "table": "_fdata/flashcards_decks", "lacks": ["Spanish"] },
    { "why": "with its cards", "table": "_fdata/flashcards", "lacks": ["hola"] },
    { "why": "and the progress on them", "table": "_fdata/flashcards_reviews", "lacks": ["\"card_id\":\"c1\""] },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/card", "body": { "front": "Katze", "back": "cat", "deck_id": "{german}" }, "status": 200 },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner makes a deck", "as": "owner", "do": "POST {api}/deck", "body": { "name": "Italian" }, "status": 200, "save": { "italian": "/id" } },
    { "why": "and studies", "as": "owner", "do": "POST {api}/review", "body": { "card_id": "c3", "quality": 3 }, "status": 200, "is": { "/reps": 1, "/ivl": 1, "/ef": 2.36 } },
    { "why": "on a schedule of their own", "table": "_fdata/flashcards_reviews", "has": ["\"user_id\":\"{did:owner}\""] },
    { "why": "and removes the deck", "as": "owner", "do": "POST {api}/deck/{italian}/delete", "body": {}, "status": 200 },
    { "why": "a stranger sees every change and no schedule", "do": "GET {api}/list", "is": { "/decks/0/name": "Français", "/decks/1/name": "German", "/decks/1/total": 2, "/cards/0/is_new": true, "/next_due": "" }, "absent": ["/decks/2"], "lacks": ["Spanish", "Italian"] }
  ]
}
