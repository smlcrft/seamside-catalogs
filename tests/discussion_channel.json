{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the owner names the channel", "as": "owner", "do": "POST {api}/settings", "body": { "title": "Town square" }, "status": 200 },
    { "why": "a message already in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fdiscussion_messages/old1", "body": { "user_id": "did:old", "user_name": "Ana", "body": "Hello from before", "created_at": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and a reaction to it", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fdiscussion_reactions/old1:did:old:heart", "body": { "message_id": "old1", "user_id": "did:old", "user_name": "Ana", "icon": "heart", "created_at": 6, "_created_at": 6, "_modified_at": 6 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["dc-loading"], "lacks": ["<form"] },
    { "why": "and its style", "do": "GET {frame}/index.css", "status": 200 },
    { "why": "a stranger reads the channel, and may not write", "do": "GET {api}/state", "status": 200, "is": { "/prefs": { "title": "Town square", "public_to_space_viewers": false }, "/messages/0/id": "old1", "/messages/0/body": "Hello from before", "/messages/0/user_name": "Ana", "/messages/0/created_at": 5, "/messages/0/reactions": [{ "user_id": "did:old", "user_name": "Ana", "icon": "heart" }], "/can_participate": false, "/can_edit_settings": false, "/me": { "user_id": "", "user_name": "", "is_owner": false } } },
    { "why": "a stranger sends nothing", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403, "is": { "/error": "read-only access" } },
    { "why": "reacts to nothing", "do": "POST {api}/react", "body": { "message_id": "old1", "icon": "fire" }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/delete", "body": { "id": "old1" }, "status": 403 },
    { "why": "names nothing", "do": "POST {api}/settings", "body": { "title": "Mine", "public_to_space_viewers": true }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fdiscussion_messages/x", "body": { "body": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fdiscussion_messages/", "lacks": ["Hello from before"] },
    { "why": "nor the setting that says who may post", "do": "KV.GET t/_settings/discussion_viewers_participate f:{id}", "status": 403 },
    { "why": "nor the channel's name, nor writes it", "do": "KV.PUT t/_settings/discussion_title f:{id}", "body": { "v": "\"Mine\"" }, "status": 403 },
    { "why": "someone signed in and on no roster reads", "as": "signed", "do": "GET {api}/state", "status": 200, "is": { "/can_participate": false, "/me/user_id": "{did:signed}", "/messages/0/body": "Hello from before" } },
    { "why": "and sends nothing", "as": "signed", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "nothing of that landed", "table": "_fdata/discussion_messages", "has": ["Hello from before"], "lacks": ["\"hi\"", "\"x\""] },

    { "why": "a viewer reads, and may not write while the toggle is off", "as": "viewer", "do": "GET {api}/state", "status": 200, "is": { "/can_participate": false, "/can_edit_settings": false, "/messages/0/body": "Hello from before" } },
    { "why": "a viewer sends nothing", "as": "viewer", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "reacts to nothing", "as": "viewer", "do": "POST {api}/react", "body": { "message_id": "old1", "icon": "fire" }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/delete", "body": { "id": "old1" }, "status": 403 },

    { "why": "a collaborator may write, and changes no settings", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_participate": true, "/can_edit_settings": false, "/me/user_name": "Collaborator" } },
    { "why": "an empty message is refused", "as": "collaborator", "do": "POST {api}/send", "body": { "body": "   " }, "status": 400, "is": { "/error": "body required" } },
    { "why": "a message is taken", "as": "collaborator", "do": "POST {api}/send", "body": { "body": " The door sticks. " }, "status": 200, "is": { "/ok": true }, "save": { "new": "/id" } },
    { "why": "as a row of the space's frame data", "table": "_fdata/discussion_messages", "has": ["\"body\":\"The door sticks.\"", "\"user_name\":\"Collaborator\"", "{did:collaborator}", "\"created_at\":", "_created_at", "_modified_at"] },
    { "why": "and read after the older one", "do": "GET {api}/state", "is": { "/messages/0/id": "old1", "/messages/1/id": "{new}", "/messages/1/body": "The door sticks.", "/messages/1/user_id": "{did:collaborator}", "/messages/1/reactions": [] } },
    { "why": "an icon that is not offered is refused", "as": "collaborator", "do": "POST {api}/react", "body": { "message_id": "{new}", "icon": "skull" }, "status": 400 },
    { "why": "a message that is not there takes no reaction", "as": "collaborator", "do": "POST {api}/react", "body": { "message_id": "nope", "icon": "fire" }, "status": 404 },
    { "why": "a reaction is taken", "as": "collaborator", "do": "POST {api}/react", "body": { "message_id": "old1", "icon": "fire" }, "status": 200 },
    { "why": "as a row keyed by message, person and icon", "table": "_fdata/discussion_reactions", "has": ["old1:{did:collaborator}:fire", "\"icon\":\"fire\"", "\"message_id\":\"old1\"", "\"user_name\":\"Collaborator\"", "_created_at", "_modified_at"] },
    { "why": "and shown after the older one", "do": "GET {api}/state", "is": { "/messages/0/reactions/0/icon": "heart", "/messages/0/reactions/1": { "user_id": "{did:collaborator}", "user_name": "Collaborator", "icon": "fire" } } },
    { "why": "the same reaction again takes it back", "as": "collaborator", "do": "POST {api}/react", "body": { "message_id": "old1", "icon": "fire" }, "status": 200 },
    { "why": "and the row is gone", "table": "_fdata/discussion_reactions", "has": ["heart"], "lacks": ["fire"] },
    { "why": "a collaborator changes no settings", "as": "collaborator", "do": "POST {api}/settings", "body": { "title": "Mine" }, "status": 403, "is": { "/error": "owner only" } },
    { "why": "nor lets viewers post by writing the toggle at the door", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/discussion_viewers_participate f:{id}", "body": { "v": "true" }, "status": 403 },
    { "why": "nor renames the channel at the door", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/discussion_title f:{id}", "body": { "v": "\"Mine\"" }, "status": 403 },
    { "why": "nor reads the owner's settings there", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/discussion_title f:{id}", "status": 403 },
    { "why": "nor an admin", "as": "admin", "do": "POST {api}/settings", "body": { "public_to_space_viewers": true }, "status": 403 },
    { "why": "a collaborator deletes nobody else's message", "as": "collaborator", "do": "POST {api}/delete", "body": { "id": "old1" }, "status": 403, "is": { "/error": "forbidden" } },
    { "why": "nor an admin", "as": "admin", "do": "POST {api}/delete", "body": { "id": "{new}" }, "status": 403 },
    { "why": "a delete names a message", "as": "collaborator", "do": "POST {api}/delete", "body": {}, "status": 400 },
    { "why": "one that is there", "as": "collaborator", "do": "POST {api}/delete", "body": { "id": "nope" }, "status": 404 },
    { "why": "there is no other write", "as": "collaborator", "do": "POST {api}/clear", "body": {}, "status": 404 },

    { "why": "the owner turns the toggle on", "as": "owner", "do": "POST {api}/settings", "body": { "public_to_space_viewers": true }, "status": 200, "is": { "/prefs": { "title": "Town square", "public_to_space_viewers": true } } },
    { "why": "in the session's own settings, beside the channel's name", "table": "_settings", "has": ["discussion_viewers_participate", "\"v\":\"true\"", "discussion_title", "Town square"], "lacks": ["Mine"] },
    { "why": "a viewer may write now", "as": "viewer", "do": "GET {api}/state", "is": { "/can_participate": true, "/prefs/public_to_space_viewers": true } },
    { "why": "a viewer's message is taken", "as": "viewer", "do": "POST {api}/send", "body": { "body": "Mine too." }, "status": 200, "save": { "theirs": "/id" } },
    { "why": "under their own name", "table": "_fdata/discussion_messages", "has": ["\"body\":\"Mine too.\"", "\"user_name\":\"Viewer\"", "{did:viewer}"] },
    { "why": "a viewer reacts", "as": "viewer", "do": "POST {api}/react", "body": { "message_id": "{new}", "icon": "star" }, "status": 200 },
    { "why": "and deletes nobody else's message", "as": "viewer", "do": "POST {api}/delete", "body": { "id": "{new}" }, "status": 403 },
    { "why": "someone on no roster still sends nothing", "as": "signed", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "nor a stranger", "do": "POST {api}/send", "body": { "body": "hi" }, "status": 403 },
    { "why": "a viewer deletes their own", "as": "viewer", "do": "POST {api}/delete", "body": { "id": "{theirs}" }, "status": 200 },

    { "why": "a collaborator deletes their own", "as": "collaborator", "do": "POST {api}/delete", "body": { "id": "{new}" }, "status": 200 },
    { "why": "with its reactions", "table": "_fdata/discussion_reactions", "has": ["heart"], "lacks": ["star"] },
    { "why": "and the channel is as it was", "do": "GET {api}/state", "is": { "/messages/0/id": "old1", "/messages/0/reactions/0/icon": "heart" }, "lacks": ["The door sticks.", "Mine too."] }
  ]
}
