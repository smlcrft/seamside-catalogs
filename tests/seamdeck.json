{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a best already on the board, in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fseamdeck_scores/old1", "body": { "initials": "ANA", "game_id": "shotput", "points": 90, "scored_at": 5, "client_id": "c-ana", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and a score still waiting for its initials", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fseamdeck_scores/old2", "body": { "initials": "???", "game_id": "regatta", "points": 40, "scored_at": 6, "client_id": "2569a8692f2fc493", "_created_at": 6, "_modified_at": 6 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["/dyn/frame-prefs.css", "console.js"] },
    { "why": "and its console", "do": "GET {frame}/console.js", "status": 200, "has": ["/lib/js/framelib.js", "seamside.fetch", "seamside.prefs"], "lacks": ["busSend", "frame.api", "localStorageGetItem"] },
    { "why": "and its cartridges", "do": "GET {frame}/games/shotput.js", "status": 200, "has": ["/lib/js/framelib.js"] },
    { "why": "the worker's own code is not a page", "do": "GET {frame}/frame.ts", "status": 404, "lacks": ["seamdeck_scores"] },

    { "why": "a stranger sees the board as it stands, highest first, and no one's player token", "do": "GET {api}/state", "status": 200, "is": { "/sessions": [], "/leaderboard/0": { "initials": "ANA", "game_id": "shotput", "points": 90 }, "/leaderboard/1": { "initials": "???", "game_id": "regatta", "points": 40 }, "/me/user_name": "" }, "lacks": ["c-ana", "c-sam", "_created_at"] },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fseamdeck_scores/x", "body": { "initials": "ZZZ", "game_id": "shotput", "points": 999 }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fseamdeck_scores/", "lacks": ["ANA"] },

    { "why": "a create names its game and its player", "do": "POST {api}/create_session", "body": { "game_id": "shotput" }, "status": 400 },
    { "why": "and a game there is", "do": "POST {api}/create_session", "body": { "game_id": "tetris", "client_id": "c-sam" }, "status": 400, "is": { "/error": "unknown game" } },
    { "why": "a stranger opens a lobby, and is told which", "do": "POST {api}/create_session", "body": { "game_id": "shotput", "client_id": "c-sam", "display_name": "Sam" }, "status": 200, "is": { "/ok": true }, "save": { "lobby": "/session_id" } },
    { "why": "someone signed in and on no roster joins it", "as": "signed", "do": "POST {api}/claim", "body": { "session_id": "{lobby}", "client_id": "c-gil", "display_name": "Gil" }, "status": 200, "is": { "/seat_no": 2 } },
    { "why": "a second claim is no second seat", "as": "signed", "do": "POST {api}/claim", "body": { "session_id": "{lobby}", "client_id": "c-gil" }, "status": 200, "is": { "/already": true } },
    { "why": "anyone sees the lobby, the host first, each player by public id and never by their client_id", "as": "viewer", "do": "GET {api}/state", "is": { "/sessions/0/session_id": "{lobby}", "/sessions/0/phase": "lobby", "/sessions/0/seats/0/display_name": "Sam", "/sessions/0/seats/0/player_id": "2569a8692f2fc493", "/sessions/0/seats/1/display_name": "Gil", "/sessions/0/seats/1/player_id": "f724edde26365b6e" }, "absent": ["/sessions/0/seats/0/client_id"], "lacks": ["c-sam", "c-gil"] },
    { "why": "a public id is no client_id: it does not start Sam's lobby", "as": "signed", "do": "POST {api}/start", "body": { "session_id": "{lobby}", "client_id": "2569a8692f2fc493" }, "status": 403, "is": { "/error": "only the host can start" } },
    { "why": "nor stand Sam up", "as": "viewer", "do": "POST {api}/leave", "body": { "client_id": "2569a8692f2fc493" }, "status": 400 },
    { "why": "nor take a seat as Sam", "as": "viewer", "do": "POST {api}/claim", "body": { "session_id": "{lobby}", "client_id": "2569a8692f2fc493" }, "status": 400 },
    { "why": "Sam is still host, and nobody else sat down", "do": "GET {api}/state", "is": { "/sessions/0/phase": "lobby", "/sessions/0/seats/0/player_id": "2569a8692f2fc493" }, "absent": ["/sessions/0/seats/2"] },
    { "why": "only the host starts", "as": "signed", "do": "POST {api}/start", "body": { "session_id": "{lobby}", "client_id": "c-gil" }, "status": 403, "is": { "/error": "only the host can start" } },
    { "why": "the owner is no host of a stranger's lobby", "as": "owner", "do": "POST {api}/start", "body": { "session_id": "{lobby}", "client_id": "c-own" }, "status": 403 },
    { "why": "the host starts", "do": "POST {api}/start", "body": { "session_id": "{lobby}", "client_id": "c-sam" }, "status": 200 },
    { "why": "and everyone has the round's seed", "as": "collaborator", "do": "GET {api}/state", "is": { "/sessions/0/phase": "playing", "/sessions/0/round_id": 1, "/sessions/0/turn_index": 0 } },
    { "why": "a lobby is no longer joinable", "as": "viewer", "do": "POST {api}/claim", "body": { "session_id": "{lobby}", "client_id": "c-vic" }, "status": 409 },

    { "why": "a throw out of turn is refused", "as": "signed", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-gil", "payload": { "charge": 0.5 } }, "status": 403, "is": { "/error": "not your turn" } },
    { "why": "nor by someone not seated", "as": "viewer", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-vic", "payload": { "charge": 0.5 } }, "status": 403, "is": { "/error": "not seated" } },
    { "why": "nobody throws as Sam by their public id", "as": "viewer", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "2569a8692f2fc493", "payload": { "charge": 0.35 } }, "status": 400 },
    { "why": "Sam throws, scored by the worker", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-sam", "payload": { "charge": 0.35 } }, "status": 200, "is": { "/summary": "14.0 m" } },
    { "why": "and throws once a turn", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-sam", "payload": { "charge": 0.35 } }, "status": 403 },
    { "why": "Gil throws", "as": "signed", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-gil", "payload": { "charge": 1 } }, "status": 200, "is": { "/points": 0, "/summary": "FOUL" } },
    { "why": "each throw is in the state, in rotation order", "do": "GET {api}/state", "is": { "/sessions/0/turns/0/player_id": "2569a8692f2fc493", "/sessions/0/turns/0/summary": "14.0 m", "/sessions/0/turns/1/player_id": "f724edde26365b6e", "/sessions/0/turn_index": 2 }, "absent": ["/sessions/0/turns/0/client_id"], "lacks": ["c-sam", "c-gil"] },
    { "why": "Sam again", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-sam", "payload": { "charge": 0.575 } }, "status": 200 },
    { "why": "Gil again", "as": "signed", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-gil", "payload": { "charge": 1.2 } }, "status": 200 },
    { "why": "Sam's last", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-sam", "payload": { "charge": 0.8 } }, "status": 200 },
    { "why": "Gil's last ends the round", "as": "signed", "do": "POST {api}/turn", "body": { "session_id": "{lobby}", "client_id": "c-gil", "payload": { "charge": 1 } }, "status": 200 },
    { "why": "the round is over", "do": "GET {api}/state", "is": { "/sessions/0/phase": "results" } },
    { "why": "Sam's best is a row of the space's frame data, in the shape the others hold, and Gil's fouls are none", "table": "_fdata/seamdeck_scores", "has": ["\"client_id\":\"2569a8692f2fc493\"", "\"game_id\":\"shotput\",\"initials\":\"???\"", "\"scored_at\":", "_created_at", "_modified_at", "\"initials\":\"ANA\""], "lacks": ["c-gil"] },

    { "why": "initials name nothing without a player", "do": "POST {api}/initials", "body": { "initials": "sam" }, "status": 400 },
    { "why": "nobody names Sam's scores by Sam's public id", "do": "POST {api}/initials", "body": { "client_id": "2569a8692f2fc493", "game_id": "shotput", "initials": "BAD" }, "status": 400 },
    { "why": "Sam's score still waits", "table": "_fdata/seamdeck_scores", "has": ["\"client_id\":\"2569a8692f2fc493\",\"game_id\":\"shotput\",\"initials\":\"???\""], "lacks": ["BAD"] },
    { "why": "Sam puts initials on this game's waiting scores", "do": "POST {api}/initials", "body": { "client_id": "c-sam", "game_id": "shotput", "initials": "s-a-m!" }, "status": 200, "is": { "/initials": "SAM" } },
    { "why": "the seat carries them", "do": "GET {api}/state", "is": { "/sessions/0/seats/0/initials": "SAM" } },
    { "why": "the row took them, and Sam's waiting score for another game still waits", "table": "_fdata/seamdeck_scores", "has": ["\"initials\":\"SAM\"", "\"initials\":\"???\",\"points\":40"] },
    { "why": "and on the regatta board it is theirs too, over the row as it was", "do": "POST {api}/initials", "body": { "client_id": "c-sam", "game_id": "regatta", "initials": "SAM" }, "status": 200 },
    { "why": "the old row kept what it held", "table": "_fdata/seamdeck_scores", "has": ["\"_created_at\":6", "\"client_id\":\"2569a8692f2fc493\",\"game_id\":\"regatta\",\"initials\":\"SAM\",\"points\":40,\"scored_at\":6"], "lacks": ["???"] },

    { "why": "only the host plays again", "as": "signed", "do": "POST {api}/next", "body": { "session_id": "{lobby}", "client_id": "c-gil" }, "status": 403, "is": { "/error": "only the host can continue" } },
    { "why": "a collaborator is no host either", "as": "collaborator", "do": "POST {api}/next", "body": { "session_id": "{lobby}", "client_id": "c-col" }, "status": 403 },
    { "why": "the owner sends anyone's results back to the lobby", "as": "owner", "do": "POST {api}/next", "body": { "session_id": "{lobby}", "client_id": "c-own" }, "status": 200 },
    { "why": "which keeps its seats, and no seed until the next start", "do": "GET {api}/state", "is": { "/sessions/0/phase": "lobby", "/sessions/0/seed": null, "/sessions/0/seats/1/player_id": "f724edde26365b6e" }, "lacks": ["c-sam", "c-gil"] },

    { "why": "a viewer plays too: a race", "as": "viewer", "do": "POST {api}/create_session", "body": { "game_id": "hotslice", "client_id": "c-vic", "display_name": "Vic" }, "status": 200, "save": { "race": "/session_id" } },
    { "why": "a collaborator joins it", "as": "collaborator", "do": "POST {api}/claim", "body": { "session_id": "{race}", "client_id": "c-col" }, "status": 200, "is": { "/seat_no": 2 } },
    { "why": "the viewer starts it", "as": "viewer", "do": "POST {api}/start", "body": { "session_id": "{race}", "client_id": "c-vic" }, "status": 200 },
    { "why": "a racer's beacon is their live position", "as": "collaborator", "do": "POST {api}/beacon", "body": { "session_id": "{race}", "client_id": "c-col", "x": 12.5, "y": 3, "heading": 1, "note": "fast" }, "status": 200 },
    { "why": "which everyone sees", "do": "GET {api}/state", "is": { "/sessions/1/racers/0": { "seat_no": 2, "player_id": "88a444edc3bcceba", "x": 12.5, "y": 3, "heading": 1, "note": "fast" }, "/sessions/1/seats/0/player_id": "e84d9bede24c80fa" }, "lacks": ["c-sam", "c-gil", "c-col", "c-vic", "c-ana"] },
    { "why": "and a beacon sent with the racer's public id moves nobody", "as": "viewer", "do": "POST {api}/beacon", "body": { "session_id": "{race}", "client_id": "88a444edc3bcceba", "x": 99, "y": 9 }, "status": 200 },
    { "why": "the racer is where they said", "as": "signed", "do": "GET {api}/state", "is": { "/sessions/1/racers/0/x": 12.5 }, "lacks": ["c-col", "c-vic"] },
    { "why": "a finish too large is refused", "as": "viewer", "do": "POST {api}/turn", "body": { "session_id": "{race}", "client_id": "c-vic", "payload": { "events": "" } }, "status": 400, "is": { "/error": "payload too large" } },
    { "why": "the viewer rides nowhere: a finish of nothing, scored nothing", "as": "viewer", "do": "POST {api}/turn", "body": { "session_id": "{race}", "client_id": "c-vic", "payload": { "events": [] } }, "status": 200, "is": { "/points": 0 } },
    { "why": "one finish is all a racer has", "as": "viewer", "do": "POST {api}/turn", "body": { "session_id": "{race}", "client_id": "c-vic", "payload": { "events": [] } }, "status": 200, "is": { "/duplicate": true } },
    { "why": "the collaborator's finish ends the race", "as": "collaborator", "do": "POST {api}/turn", "body": { "session_id": "{race}", "client_id": "c-col", "payload": {} }, "status": 200 },
    { "why": "results, and a score of nothing is no row", "do": "GET {api}/state", "is": { "/sessions/1/phase": "results", "/sessions/1/racers": [] } },
    { "why": "no row for either racer", "table": "_fdata/seamdeck_scores", "lacks": ["c-vic", "c-col", "hotslice"] },

    { "why": "a player who leaves stands up", "as": "signed", "do": "POST {api}/leave", "body": { "client_id": "c-gil" }, "status": 200 },
    { "why": "the last player out ends the lobby", "do": "POST {api}/leave", "body": { "client_id": "c-sam" }, "status": 200 },
    { "why": "and only the race is left", "do": "GET {api}/state", "is": { "/sessions/0/session_id": "{race}" }, "absent": ["/sessions/1"] },
    { "why": "a lobby that is gone is joined by nobody", "as": "signed", "do": "POST {api}/claim", "body": { "session_id": "{lobby}", "client_id": "c-gil" }, "status": 400 },
    { "why": "a create may name its session", "as": "signed", "do": "POST {api}/create_session", "body": { "game_id": "regatta", "client_id": "c-gil", "session_id": "gil-regatta-1" }, "status": 200, "is": { "/session_id": "gil-regatta-1" } },
    { "why": "but never one there is", "as": "viewer", "do": "POST {api}/create_session", "body": { "game_id": "regatta", "client_id": "c-vic", "session_id": "gil-regatta-1" }, "status": 409, "is": { "/error": "session exists" } },

    { "why": "an act there is none of", "do": "POST {api}/nope", "body": {}, "status": 405 },
    { "why": "nor a read", "do": "GET {api}/nope", "status": 405 },
    { "why": "and a write to a page is none either", "do": "POST {frame}/index.html", "body": {}, "status": 405 }
  ]
}
