{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a daily chore already in the table, last done long ago on a run of 4", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old1", "body": { "chore": "Dishes", "assignee": "Ana", "cadence": "daily", "last_done_ms": 5, "last_done_by": "Ana", "streak": 4, "best_streak": 6, "sort_order": 0, "notes": "after dinner", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a weekly one never done", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old2", "body": { "chore": "Bins", "assignee": "", "cadence": "weekly", "last_done_ms": 0, "last_done_by": "", "streak": 0, "best_streak": 0, "sort_order": 1, "notes": "", "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "one whose rhythm another frame wrote as free text", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old3", "body": { "chore": "Lawn", "assignee": "Bo", "cadence": "Fortnightly", "last_done_ms": 5, "last_done_by": "Bo", "streak": 1, "best_streak": 1, "sort_order": 2, "notes": "", "_created_at": 7, "_modified_at": 7 }, "status": 200 },
    { "why": "and a one-off done long ago", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old4", "body": { "chore": "Hang the shelf", "assignee": "Ana", "cadence": "once", "last_done_ms": 5, "last_done_by": "Ana", "streak": 1, "best_streak": 1, "sort_order": 3, "notes": "", "_created_at": 8, "_modified_at": 8 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Chore Chart", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["busSend"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the board as it was put in, in order", "do": "GET {api}/list", "status": 200, "is": { "/chores/0/id": "old1", "/chores/0/chore": "Dishes", "/chores/0/assignee": "Ana", "/chores/0/cadence": "daily", "/chores/0/streak": 4, "/chores/0/best_streak": 6, "/chores/0/notes": "after dinner", "/chores/1/id": "old2", "/chores/2/id": "old3", "/chores/3/id": "old4" }, "absent": ["/chores/4", "/chores/0/_created_at"] },
    { "why": "a daily chore done in an earlier period is not done now", "do": "GET {api}/list", "is": { "/chores/0/done": false, "/chores/1/done": false } },
    { "why": "a rhythm that is none of the four reads as weekly, and is not done now", "do": "GET {api}/list", "is": { "/chores/2/cadence": "weekly", "/chores/2/done": false } },
    { "why": "a one-off done at all is done for good", "do": "GET {api}/list", "is": { "/chores/3/cadence": "once", "/chores/3/done": true } },
    { "why": "a stranger adds nothing", "do": "POST {api}/chore", "body": { "chore": "sneak" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "ticks nothing off", "do": "POST {api}/chore/old2/done", "body": {}, "status": 403 },
    { "why": "undoes nothing", "do": "POST {api}/chore/old4/undo", "body": {}, "status": 403 },
    { "why": "renames nothing", "do": "PUT {api}/chore/old2", "body": { "chore": "mine" }, "status": 403 },
    { "why": "deletes nothing", "do": "POST {api}/chore/old1/delete", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fchores/x", "body": { "chore": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fchores/", "lacks": ["Dishes", "after dinner"] },
    { "why": "the board is as it was", "table": "_fdata/chores", "has": ["Dishes", "Bins", "Lawn", "Hang the shelf"], "lacks": ["sneak", "mine", "\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the board", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/chores/0/id": "old1" } },
    { "why": "and ticks nothing off", "as": "signed", "do": "POST {api}/chore/old2/done", "body": {}, "status": 403 },
    { "why": "nor adds", "as": "signed", "do": "POST {api}/chore", "body": { "chore": "sneak" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the board", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/chores/1/chore": "Bins" } },
    { "why": "a viewer adds nothing", "as": "viewer", "do": "POST {api}/chore", "body": { "chore": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "ticks nothing off", "as": "viewer", "do": "POST {api}/chore/old2/done", "body": {}, "status": 403 },
    { "why": "undoes nothing", "as": "viewer", "do": "POST {api}/chore/old4/undo", "body": {}, "status": 403 },
    { "why": "changes no rhythm", "as": "viewer", "do": "POST {api}/chore/old2", "body": { "cadence": "daily" }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/chore/old2/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/x", "body": { "chore": "x" }, "status": 403 },
    { "why": "nothing a viewer asked for landed", "table": "_fdata/chores", "lacks": ["mine", "\"cadence\":\"daily\",\"chore\":\"Bins\""] },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "an empty chore is refused", "as": "collaborator", "do": "POST {api}/chore", "body": { "chore": "   " }, "status": 400, "is": { "/error": "chore required" } },
    { "why": "a collaborator adds a chore, last, and is answered with the board", "as": "collaborator", "do": "POST {api}/chore", "body": { "chore": "  Feed the cat  ", "assignee": " Cy ", "cadence": "DAILY" }, "status": 200, "is": { "/chores/4/chore": "Feed the cat", "/chores/4/assignee": "Cy", "/chores/4/cadence": "daily", "/chores/4/sort_order": 4, "/chores/4/done": false, "/chores/4/streak": 0, "/chores/4/best_streak": 0, "/chores/4/last_done_ms": 0 }, "save": { "cat": "/chores/4/id" } },
    { "why": "as a row of the space, from the contract's defaults, stamped", "table": "_fdata/chores", "has": ["\"assignee\":\"Cy\",\"best_streak\":0,\"cadence\":\"daily\",\"chore\":\"Feed the cat\",\"last_done_by\":\"\",\"last_done_ms\":0,\"notes\":\"\",\"sort_order\":4,\"streak\":0", "_created_at", "_modified_at"] },
    { "why": "a rhythm that is none of the four is kept as weekly", "as": "collaborator", "do": "POST {api}/chore", "body": { "chore": "Windows", "cadence": "yearly" }, "status": 200, "is": { "/chores/5/cadence": "weekly", "/chores/5/assignee": "" }, "save": { "windows": "/chores/5/id" } },

    { "why": "a chore last done in an earlier period starts its run again at 1, the best kept", "as": "collaborator", "do": "POST {api}/chore/old1/done", "body": {}, "status": 200, "is": { "/chores/0/done": true, "/chores/0/streak": 1, "/chores/0/best_streak": 6, "/chores/0/last_done_by": "Collaborator" }, "save": { "now": "/chores/0/last_done_ms" } },
    { "why": "over the row, which kept what it held and when it was made", "table": "_fdata/chores", "has": ["\"notes\":\"after dinner\"", "\"_created_at\":5", "\"last_done_ms\":{now}"] },
    { "why": "a second tick in the same period counts nothing", "as": "collaborator", "do": "POST {api}/chore/old1/done", "body": {}, "status": 200, "is": { "/chores/0/done": true, "/chores/0/streak": 1, "/chores/0/best_streak": 6 }, "has": ["\"last_done_ms\":{now}"] },
    { "why": "a daily chore another frame marked done this period, on a run of 2", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old5", "body": "{\"chore\":\"Walk the dog\",\"assignee\":\"Bo\",\"cadence\":\"daily\",\"last_done_ms\":{now},\"last_done_by\":\"Bo\",\"streak\":2,\"best_streak\":2,\"sort_order\":9,\"notes\":\"\",\"_created_at\":9,\"_modified_at\":9}", "status": 200 },
    { "why": "reads as done now", "do": "GET {api}/list", "is": { "/chores/6/id": "old5", "/chores/6/done": true, "/chores/6/streak": 2 } },
    { "why": "and a tick on it is no second count", "as": "collaborator", "do": "POST {api}/chore/old5/done", "body": {}, "status": 200, "is": { "/chores/6/streak": 2, "/chores/6/best_streak": 2, "/chores/6/last_done_by": "Bo" } },
    { "why": "a weekly chore done in this week reads as done", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old6", "body": "{\"chore\":\"Hoover\",\"assignee\":\"\",\"cadence\":\"weekly\",\"last_done_ms\":{now},\"last_done_by\":\"\",\"streak\":3,\"best_streak\":3,\"sort_order\":10,\"notes\":\"\",\"_created_at\":10,\"_modified_at\":10}", "status": 200 },
    { "why": "and a monthly one this month too", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old7", "body": "{\"chore\":\"Change the filter\",\"assignee\":\"\",\"cadence\":\"monthly\",\"last_done_ms\":{now},\"last_done_by\":\"\",\"streak\":1,\"best_streak\":1,\"sort_order\":11,\"notes\":\"\",\"_created_at\":11,\"_modified_at\":11}", "status": 200 },
    { "why": "while one done in an earlier month is not", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fchores/old8", "body": { "chore": "Descale", "assignee": "", "cadence": "monthly", "last_done_ms": 5, "last_done_by": "", "streak": 7, "best_streak": 7, "sort_order": 12, "notes": "", "_created_at": 12, "_modified_at": 12 }, "status": 200 },
    { "why": "the board says so", "do": "GET {api}/list", "is": { "/chores/7/id": "old6", "/chores/7/done": true, "/chores/8/id": "old7", "/chores/8/done": true, "/chores/9/id": "old8", "/chores/9/done": false } },
    { "why": "a monthly run broken by a gap starts again at 1, its best kept", "as": "collaborator", "do": "POST {api}/chore/old8/done", "body": {}, "status": 200, "is": { "/chores/9/done": true, "/chores/9/streak": 1, "/chores/9/best_streak": 7 } },

    { "why": "an undo gives back the run it granted and clears the tick, the best kept", "as": "collaborator", "do": "POST {api}/chore/old1/undo", "body": {}, "status": 200, "is": { "/chores/0/done": false, "/chores/0/streak": 0, "/chores/0/best_streak": 6, "/chores/0/last_done_ms": 0, "/chores/0/last_done_by": "" } },
    { "why": "an undo of a chore not done changes nothing", "as": "collaborator", "do": "POST {api}/chore/old2/undo", "body": {}, "status": 200, "is": { "/chores/1/streak": 0, "/chores/1/last_done_ms": 0 } },
    { "why": "a first tick of a chore never done starts a run of 1", "as": "collaborator", "do": "POST {api}/chore/old2/done", "body": {}, "status": 200, "is": { "/chores/1/done": true, "/chores/1/streak": 1, "/chores/1/best_streak": 1 } },
    { "why": "a one-off done already is not done again", "as": "collaborator", "do": "POST {api}/chore/old4/done", "body": {}, "status": 200, "is": { "/chores/3/streak": 1, "/chores/3/last_done_ms": 5, "/chores/3/last_done_by": "Ana" } },
    { "why": "undone, it is open again", "as": "collaborator", "do": "POST {api}/chore/old4/undo", "body": {}, "status": 200, "is": { "/chores/3/done": false, "/chores/3/streak": 0, "/chores/3/best_streak": 1 } },
    { "why": "and a one-off's tick never continues a run", "as": "collaborator", "do": "POST {api}/chore/old4/done", "body": {}, "status": 200, "is": { "/chores/3/done": true, "/chores/3/streak": 1 } },

    { "why": "a chore is renamed, given to someone, a new rhythm and a note, in one write", "as": "collaborator", "do": "PUT {api}/chore/old3", "body": { "chore": " Mow the lawn ", "assignee": "Cy", "cadence": "monthly", "notes": "front and back" }, "status": 200, "is": { "/chores/2/chore": "Mow the lawn", "/chores/2/assignee": "Cy", "/chores/2/cadence": "monthly", "/chores/2/notes": "front and back", "/chores/2/streak": 1, "/chores/2/last_done_by": "Bo" } },
    { "why": "an empty name leaves the name, and the rest still lands", "as": "collaborator", "do": "POST {api}/chore/old3", "body": { "chore": "  ", "assignee": "" }, "status": 200, "is": { "/chores/2/chore": "Mow the lawn", "/chores/2/assignee": "" } },
    { "why": "over the row, which kept when it was made", "table": "_fdata/chores", "has": ["\"chore\":\"Mow the lawn\"", "\"_created_at\":7", "\"best_streak\":1"] },
    { "why": "a chore there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/chore/ghost/done", "body": {}, "status": 400, "is": { "/error": "bad id" } },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/chore/old2/nope", "body": {}, "status": 404 },
    { "why": "and nothing was made for either", "table": "_fdata/chores", "lacks": ["ghost"] },
    { "why": "a chore is removed", "as": "collaborator", "do": "POST {api}/chore/{windows}/delete", "body": {}, "status": 200, "lacks": ["Windows"] },
    { "why": "and gone from the table", "table": "_fdata/chores", "lacks": ["Windows"] },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/chore/{cat}/done", "body": {}, "status": 200, "is": { "/chores/4/done": true, "/chores/4/streak": 1, "/chores/4/last_done_by": "Admin" } },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner adds a chore, after the last", "as": "owner", "do": "POST {api}/chore", "body": { "chore": "Call the plumber", "cadence": "once" }, "status": 200, "is": { "/chores/9/chore": "Call the plumber", "/chores/9/sort_order": 13 }, "save": { "plumber": "/chores/9/id" } },
    { "why": "and ticks it off", "as": "owner", "do": "POST {api}/chore/{plumber}/done", "body": {}, "status": 200, "is": { "/chores/9/done": true, "/chores/9/streak": 1 } },
    { "why": "and removes it", "as": "owner", "do": "POST {api}/chore/{plumber}/delete", "body": {}, "status": 200, "lacks": ["Call the plumber"] },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "is": { "/chores/0/chore": "Dishes", "/chores/0/done": false, "/chores/1/done": true, "/chores/2/chore": "Mow the lawn", "/chores/4/chore": "Feed the cat", "/chores/4/done": true }, "absent": ["/chores/9"] }
  ]
}
