{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the sharing settings an installed copy kept in the session", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"who_can_add\":\"owner\",\"max_size_mb\":2,\"max_files\":3}", "status": 200 },
    { "why": "and the folder it was pointed at", "as": "collaborator", "at": "space", "do": "KV.PUT folder f:{id}", "body": "Shared/Drop", "status": 200 },
    { "why": "a file already in that folder of the space", "as": "collaborator", "at": "space", "do": "PUT /files/Shared/Drop/old-notes.txt", "body": "notes from before\n", "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["File Folder", "/lib/js/framelib.js"] },
    { "why": "a stranger is shown the folder the session kept, with its settings", "do": "GET {api}/state", "status": 200, "is": { "/folder": "Shared/Drop", "/prefs": { "who_can_add": "owner", "max_size_mb": 2, "max_files": 3 }, "/can_add": false, "/can_move": false, "/me/is_anon": true, "/me/is_owner": false, "/files/0": { "id": "old-notes.txt", "name": "old-notes.txt", "size": 18 } }, "absent": ["/files/0/link", "/files/1"] },
    { "why": "the old keys moved into the session's own settings, each value JSON under v", "table": "__fc_settings", "has": ["\"v\":\"{\\\"who_can_add\\\":\\\"owner\\\",\\\"max_size_mb\\\":2,\\\"max_files\\\":3}\"", "\"v\":\"\\\"Shared/Drop\\\"\"", "_created_at", "_modified_at"] },
    { "why": "and are gone from the door", "as": "collaborator", "at": "space", "do": "KV.GET prefs f:{id}", "status": 404 },
    { "why": "both of them", "as": "collaborator", "at": "space", "do": "KV.GET folder f:{id}", "status": 404 },
    { "why": "a stranger reads no setting at the door", "do": "KV.GET t/__fc_settings/prefs f:{id}", "status": 403 },
    { "why": "nor writes one", "do": "KV.PUT t/__fc_settings/prefs f:{id}", "body": { "v": "{\"who_can_add\":\"editors\"}" }, "status": 403 },
    { "why": "a collaborator reads none at the door either", "as": "collaborator", "at": "space", "do": "KV.GET t/__fc_settings/folder f:{id}", "status": 403 },
    { "why": "nor writes the owner's", "as": "collaborator", "at": "space", "do": "KV.PUT t/__fc_settings/prefs f:{id}", "body": { "v": "{\"who_can_add\":\"editors\"}" }, "status": 403 },
    { "why": "and a key written at the door now moves nothing", "as": "collaborator", "at": "space", "do": "KV.PUT prefs f:{id}", "body": "{\"who_can_add\":\"editors\",\"max_files\":50}", "status": 200 },
    { "why": "nor does a folder key", "as": "collaborator", "at": "space", "do": "KV.PUT folder f:{id}", "body": "Elsewhere", "status": 200 },
    { "why": "the session keeps its own", "do": "GET {api}/state", "is": { "/prefs": { "who_can_add": "owner", "max_size_mb": 2, "max_files": 3 }, "/folder": "Shared/Drop" } },
    { "why": "and downloads what is in it", "do": "GET {api}/download/old-notes.txt", "status": 200, "has": ["notes from before"] },
    { "why": "but nothing outside it", "do": "GET {api}/download/..%2F..%2F_meta%2Fspace.json", "status": 404 },
    { "why": "a stranger adds no file", "do": "POST {api}/upload?name=mine.txt", "body": "mine", "status": 403 },
    { "why": "deletes none", "do": "POST {api}/delete/old-notes.txt", "status": 403 },
    { "why": "changes no setting", "do": "POST {api}/prefs", "body": { "who_can_add": "editors" }, "status": 403 },
    { "why": "moves no folder", "do": "POST {api}/folder", "body": { "folder": "Mine" }, "status": 403 },
    { "why": "a stranger writes no key at the door", "do": "KV.PUT prefs f:{id}", "body": "{\"who_can_add\":\"editors\"}", "status": 403 },
    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "POST {api}/upload?name=mine.txt", "body": "mine", "status": 403 },
    { "why": "and is told so", "as": "signed", "do": "GET {api}/state", "is": { "/me/is_anon": true, "/can_add": false } },

    { "why": "a viewer is a member who may not add", "as": "viewer", "do": "GET {api}/state", "is": { "/me/is_sfi_member": true, "/me/is_sfi_editor": false, "/can_add": false, "/can_move": false } },
    { "why": "a viewer adds no file", "as": "viewer", "do": "POST {api}/upload?name=mine.txt", "body": "mine", "status": 403 },
    { "why": "moves no folder", "as": "viewer", "do": "POST {api}/folder", "body": { "folder": "Mine" }, "status": 403 },
    { "why": "a collaborator may move the folder, and while only the owner adds, may not add", "as": "collaborator", "do": "GET {api}/state", "is": { "/me/is_sfi_editor": true, "/me/is_owner": false, "/can_add": false, "/can_move": true } },
    { "why": "so adds nothing", "as": "collaborator", "do": "POST {api}/upload?name=mine.txt", "body": "mine", "status": 403 },
    { "why": "deletes nothing", "as": "collaborator", "do": "POST {api}/delete/old-notes.txt", "status": 403 },
    { "why": "and changes no setting", "as": "collaborator", "do": "POST {api}/prefs", "body": { "who_can_add": "editors" }, "status": 403 },

    { "why": "the owner adds", "as": "owner", "do": "GET {api}/state", "is": { "/me/is_owner": true, "/can_add": true, "/can_move": true } },
    { "why": "a file, its bytes as the body", "as": "owner", "do": "POST {api}/upload?name=hello.txt", "body": "hello, folder\n", "status": 200, "has": ["\"name\":\"hello.txt\",\"size\":14"] },
    { "why": "a file of the space, where the session points", "as": "collaborator", "at": "space", "do": "GET /files/Shared/Drop/hello.txt", "status": 200, "has": ["hello, folder"] },
    { "why": "which anyone downloads as it went up", "do": "GET {api}/download/hello.txt", "status": 200, "has": ["hello, folder"] },
    { "why": "a name taken is given another", "as": "owner", "do": "POST {api}/upload?name=..%2Fhello.txt", "body": "second", "status": 200, "has": ["\"name\":\"hello (2).txt\",\"size\":6"] },
    { "why": "a file with no name is refused", "as": "owner", "do": "POST {api}/upload?name=", "body": "x", "status": 400, "is": { "/error": "missing file name" } },
    { "why": "and a full folder takes no more", "as": "owner", "do": "POST {api}/upload?name=four.txt", "body": "4", "status": 409, "is": { "/error": "file limit reached (3)" } },

    { "why": "the owner lets editors add, and raises the count", "as": "owner", "do": "POST {api}/prefs", "body": { "who_can_add": "editors", "max_size_mb": 99, "max_files": 5 }, "status": 200, "is": { "/prefs": { "who_can_add": "editors", "max_size_mb": 8, "max_files": 5 } } },
    { "why": "kept as the session's prefs setting", "table": "__fc_settings", "has": ["\"v\":\"{\\\"who_can_add\\\":\\\"editors\\\",\\\"max_size_mb\\\":8,\\\"max_files\\\":5}\""] },
    { "why": "now a collaborator adds", "as": "collaborator", "do": "POST {api}/upload?name=from-collab.txt", "body": "from a collaborator", "status": 200, "has": ["from-collab.txt"] },
    { "why": "and deletes", "as": "collaborator", "do": "POST {api}/delete/hello%20(2).txt", "status": 200, "lacks": ["hello (2).txt"] },
    { "why": "which is gone from the space", "as": "collaborator", "at": "space", "do": "GET /files/Shared/Drop/hello%20(2).txt", "status": 404 },
    { "why": "not what is not there", "as": "collaborator", "do": "POST {api}/delete/nothing.txt", "status": 404 },
    { "why": "a viewer still adds nothing", "as": "viewer", "do": "POST {api}/upload?name=mine.txt", "body": "mine", "status": 403 },
    { "why": "nor deletes", "as": "viewer", "do": "POST {api}/delete/hello.txt", "status": 403 },
    { "why": "nor does a stranger", "do": "POST {api}/delete/hello.txt", "status": 403 },

    { "why": "a folder that is Seamside's own is refused", "as": "collaborator", "do": "POST {api}/folder", "body": { "folder": "_meta" }, "status": 400 },
    { "why": "and one that climbs out", "as": "collaborator", "do": "POST {api}/folder", "body": { "folder": "../up" }, "status": 400 },
    { "why": "a collaborator points the session at another folder", "as": "collaborator", "do": "POST {api}/folder", "body": { "folder": " Other / Place " }, "status": 200, "is": { "/folder": "Other/Place", "/files": [] } },
    { "why": "kept as the session's folder setting", "table": "__fc_settings", "has": ["\"v\":\"\\\"Other/Place\\\"\""], "lacks": ["Shared/Drop"] },
    { "why": "and a stranger follows it there", "do": "GET {api}/state", "is": { "/folder": "Other/Place", "/files": [] } },
    { "why": "the old folder's files stay where they were", "as": "collaborator", "at": "space", "do": "GET /files/Shared/Drop/old-notes.txt", "status": 200, "has": ["notes from before"] }
  ]
}
