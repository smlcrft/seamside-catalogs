{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a trip already kept in the space's frame data", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrips/old1", "body": { "name": "Lake Tahoe", "destination": "Lake Tahoe", "start_date": "2026-07-01", "end_date": "2026-07-03", "notes": "Bring chains", "created_ms": 5, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a stop on it, already placed", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrip_itinerary/oi1", "body": { "trip_id": "old1", "day_date": "2026-07-01", "time": "10:00", "activity": "Kayak", "location": "Emerald Bay", "sort_order": 0, "lat": 38.95, "lon": -120.1, "geo_q": "Emerald Bay", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one with nowhere named", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrip_itinerary/oi2", "body": { "trip_id": "old1", "day_date": "2026-07-01", "time": "", "activity": "Picnic", "location": "", "sort_order": 1, "lat": 0, "lon": 0, "geo_q": "", "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "two things to pack, one packed", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrip_packing/op1", "body": { "trip_id": "old1", "item": "Sunscreen", "category": "toiletries", "packed": 1, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "and one not", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrip_packing/op2", "body": { "trip_id": "old1", "item": "Tent", "category": "general", "packed": 0, "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "a cost", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Ftrip_expenses/oe1", "body": { "trip_id": "old1", "description": "Cabin", "amount": 250.5, "category": "lodging", "date": "2026-07-01", "_created_at": 5, "_modified_at": 5 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Trip Planner", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["busSend", "frame.api"] },
    { "why": "and the map it carries", "do": "GET {frame}/vendor/maplibre-gl.css", "status": 200, "has": ["maplibregl"] },
    { "why": "and the map's worker, for a page that makes it from its bytes", "do": "GET {frame}/vendor/maplibre-gl-csp-worker.js", "status": 200 },
    { "why": "a tile path that is not one is refused before anything is fetched", "do": "GET {frame}/tiles/a!b", "status": 400, "has": ["bad path"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger is shown the trips, old rows and all", "do": "GET {api}/trips", "status": 200, "is": { "/trips/0/id": "old1", "/trips/0/name": "Lake Tahoe", "/trips/0/destination": "Lake Tahoe", "/trips/0/start_date": "2026-07-01", "/trips/0/days": 1, "/trips/0/packed": 1, "/trips/0/pack_total": 2, "/trips/0/expense_total": 250.5 }, "absent": ["/trips/1", "/trips/0/notes", "/trips/0/created_ms"] },
    { "why": "and the trip itself, in order", "do": "GET {api}/trip?id=old1", "status": 200, "is": { "/trip/id": "old1", "/trip/notes": "Bring chains", "/itinerary/0/id": "oi1", "/itinerary/0/activity": "Kayak", "/itinerary/0/location": "Emerald Bay", "/itinerary/0/lat": 38.95, "/itinerary/0/lon": -120.1, "/itinerary/1/id": "oi2", "/itinerary/1/lat": 0, "/packing/0/id": "op2", "/packing/0/item": "Tent", "/packing/0/packed": 0, "/packing/1/item": "Sunscreen", "/packing/1/packed": 1, "/expenses/0/id": "oe1", "/expenses/0/amount": 250.5, "/expenses/0/category": "lodging", "/total": 250.5 }, "absent": ["/itinerary/0/geo_q", "/itinerary/2"] },
    { "why": "a trip asked for by nothing", "do": "GET {api}/trip", "status": 400, "is": { "/error": "id required" } },
    { "why": "a trip there is none of", "do": "GET {api}/trip?id=nope", "status": 404 },
    { "why": "a stranger plans no trip", "do": "POST {api}/trip", "body": { "name": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "renames none", "do": "PUT {api}/trip/old1", "body": { "name": "Mine" }, "status": 403 },
    { "why": "deletes none", "do": "POST {api}/trip/old1/delete", "body": {}, "status": 403 },
    { "why": "adds no stop", "do": "POST {api}/it", "body": { "trip_id": "old1", "activity": "Mine" }, "status": 403 },
    { "why": "reorders none", "do": "POST {api}/it/reorder", "body": { "trip_id": "old1", "day_date": "2026-07-01", "ids": ["oi2", "oi1"] }, "status": 403 },
    { "why": "packs nothing", "do": "POST {api}/pack/op2", "body": { "packed": 1 }, "status": 403 },
    { "why": "spends nothing", "do": "POST {api}/exp", "body": { "trip_id": "old1", "description": "Mine", "amount": 1 }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Ftrips/x", "body": { "name": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Ftrips/", "lacks": ["Lake Tahoe", "Bring chains"] },
    { "why": "nor the costs", "do": "KV.LIST t/_fdata%2Ftrip_expenses/", "lacks": ["Cabin"] },
    { "why": "the trip is as it was", "table": "_fdata/trips", "has": ["Lake Tahoe"], "lacks": ["Mine", "\"name\":\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the trip", "as": "signed", "do": "GET {api}/trip?id=old1", "status": 200, "is": { "/itinerary/0/activity": "Kayak" } },
    { "why": "and plans nothing", "as": "signed", "do": "POST {api}/trip", "body": { "name": "Mine" }, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false } },
    { "why": "a viewer reads the trip", "as": "viewer", "do": "GET {api}/trip?id=old1", "status": 200, "is": { "/packing/1/item": "Sunscreen" } },
    { "why": "a viewer plans no trip", "as": "viewer", "do": "POST {api}/trip", "body": { "name": "Mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "changes no stop", "as": "viewer", "do": "PUT {api}/it/oi1", "body": { "activity": "Mine" }, "status": 403 },
    { "why": "packs nothing", "as": "viewer", "do": "POST {api}/pack/op2", "body": { "packed": 1 }, "status": 403 },
    { "why": "deletes no cost", "as": "viewer", "do": "POST {api}/exp/oe1/delete", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Ftrips/x", "body": { "name": "x" }, "status": 403 },
    { "why": "nothing a visitor sent landed", "table": "_fdata/trip_itinerary", "lacks": ["Mine"] },

    { "why": "a trip needs a name", "as": "collaborator", "do": "POST {api}/trip", "body": { "name": "  " }, "status": 400, "is": { "/error": "name required" } },
    { "why": "a collaborator plans a trip", "as": "collaborator", "do": "POST {api}/trip", "body": { "name": " Big Sur ", "destination": "Big Sur", "start_date": "2026-08-10", "end_date": "soon" }, "status": 200, "is": { "/ok": true } },
    { "why": "which lists first, the latest start leading", "as": "collaborator", "do": "GET {api}/trips", "is": { "/trips/0/name": "Big Sur", "/trips/0/end_date": "", "/trips/0/days": 0, "/trips/1/id": "old1" }, "save": { "bs": "/trips/0/id" } },
    { "why": "as a row in the shape the others hold", "table": "_fdata/trips", "has": ["\"name\":\"Big Sur\"", "\"notes\":\"\"", "\"created_ms\":", "\"_created_at\":", "\"_modified_at\":"] },
    { "why": "a trip's details change and an empty name is ignored", "as": "collaborator", "do": "PUT {api}/trip/{bs}", "body": { "name": "", "notes": "Fog likely" }, "status": 200 },
    { "why": "over the row as it was", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/trip/name": "Big Sur", "/trip/notes": "Fog likely", "/trip/start_date": "2026-08-10" } },
    { "why": "a POST changes one too, as it always could", "as": "collaborator", "do": "POST {api}/trip/old1", "body": { "destination": "Tahoe" }, "status": 200 },
    { "why": "and an old trip keeps what it held", "table": "_fdata/trips", "has": ["\"destination\":\"Tahoe\"", "\"notes\":\"Bring chains\"", "\"_created_at\":5"] },
    { "why": "a trip that is not one", "as": "collaborator", "do": "PUT {api}/trip/nope", "body": { "notes": "x" }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "nor a thing a trip does", "as": "collaborator", "do": "POST {api}/trip/{bs}/fly", "body": {}, "status": 404 },

    { "why": "a stop needs a trip", "as": "collaborator", "do": "POST {api}/it", "body": { "trip_id": "nope", "activity": "Hike" }, "status": 400, "is": { "/error": "bad trip" } },
    { "why": "and something to do", "as": "collaborator", "do": "POST {api}/it", "body": { "trip_id": "{bs}", "activity": " " }, "status": 400, "is": { "/error": "activity required" } },
    { "why": "a stop is added", "as": "collaborator", "do": "POST {api}/it", "body": { "trip_id": "{bs}", "day_date": "2026-08-10", "time": "09:00", "activity": "Bixby Bridge" }, "status": 200 },
    { "why": "and another after it", "as": "collaborator", "do": "POST {api}/it", "body": { "trip_id": "{bs}", "day_date": "2026-08-10", "activity": "Lunch" }, "status": 200 },
    { "why": "each in the next slot of its day", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/itinerary/0/activity": "Bixby Bridge", "/itinerary/0/sort_order": 0, "/itinerary/0/time": "09:00", "/itinerary/1/activity": "Lunch", "/itinerary/1/sort_order": 1 }, "save": { "bixby": "/itinerary/0/id", "lunch": "/itinerary/1/id" } },
    { "why": "a new stop starts from the schema's defaults", "table": "_fdata/trip_itinerary", "has": ["\"activity\":\"Lunch\"", "\"geo_q\":\"\"", "\"lat\":0", "\"lon\":0", "\"location\":\"\""] },
    { "why": "a day is reordered, and a stop that is not there is left alone", "as": "collaborator", "do": "POST {api}/it/reorder", "body": { "trip_id": "{bs}", "day_date": "2026-08-10", "ids": ["{lunch}", "{bixby}", "phantom"] }, "status": 200 },
    { "why": "in the order it was given", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/itinerary/0/activity": "Lunch", "/itinerary/1/activity": "Bixby Bridge" } },
    { "why": "and made up nothing", "table": "_fdata/trip_itinerary", "lacks": ["phantom"] },
    { "why": "a stop moves to another day", "as": "collaborator", "do": "PUT {api}/it/{bixby}", "body": { "day_date": "2026-08-11" }, "status": 200 },
    { "why": "at that day's end", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/itinerary/1/activity": "Bixby Bridge", "/itinerary/1/day_date": "2026-08-11", "/itinerary/1/sort_order": 0, "/itinerary/1/time": "09:00" } },
    { "why": "an old stop's time changes", "as": "collaborator", "do": "PUT {api}/it/oi2", "body": { "time": "12:00" }, "status": 200 },
    { "why": "clearing a place clears its pin", "as": "collaborator", "do": "PUT {api}/it/oi1", "body": { "location": "" }, "status": 200 },
    { "why": "both over the rows as they were", "as": "viewer", "do": "GET {api}/trip?id=old1", "is": { "/itinerary/0/activity": "Kayak", "/itinerary/0/location": "", "/itinerary/0/lat": 0, "/itinerary/0/lon": 0, "/itinerary/1/activity": "Picnic", "/itinerary/1/time": "12:00" } },
    { "why": "a place named is looked up once, after the answer, and kept on the row", "as": "collaborator", "do": "PUT {api}/it/oi2", "body": { "location": "Vikingsholm" }, "status": 200 },
    { "why": "the lookup lands on the row by itself", "table": "_fdata/trip_itinerary", "tries": 150, "has": ["\"geo_q\":\"Vikingsholm\""] },
    { "why": "a stop that is not one", "as": "collaborator", "do": "PUT {api}/it/nope", "body": { "time": "1" }, "status": 400, "is": { "/error": "bad id" } },

    { "why": "something to pack needs a name", "as": "collaborator", "do": "POST {api}/pack", "body": { "trip_id": "{bs}", "item": "" }, "status": 400, "is": { "/error": "item required" } },
    { "why": "something to pack, with no category", "as": "collaborator", "do": "POST {api}/pack", "body": { "trip_id": "{bs}", "item": "Jacket", "category": " " }, "status": 200 },
    { "why": "is general", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/packing/0/item": "Jacket", "/packing/0/category": "general", "/packing/0/packed": 0 }, "save": { "jacket": "/packing/0/id" } },
    { "why": "and is packed", "as": "collaborator", "do": "POST {api}/pack/{jacket}", "body": { "packed": true }, "status": 200 },
    { "why": "an old item is packed too", "as": "collaborator", "do": "PUT {api}/pack/op2", "body": { "packed": "1" }, "status": 200 },
    { "why": "the counts follow", "do": "GET {api}/trips", "is": { "/trips/0/packed": 1, "/trips/0/pack_total": 1, "/trips/1/packed": 2, "/trips/1/pack_total": 2 } },
    { "why": "the old item kept its category", "table": "_fdata/trip_packing", "has": ["\"item\":\"Tent\"", "\"packed\":1"], "lacks": ["\"packed\":0"] },

    { "why": "a cost needs an amount", "as": "collaborator", "do": "POST {api}/exp", "body": { "trip_id": "{bs}", "description": "Gas", "amount": "-3" }, "status": 400, "is": { "/error": "bad amount" } },
    { "why": "and what it was for", "as": "collaborator", "do": "POST {api}/exp", "body": { "trip_id": "{bs}", "description": "", "amount": 3 }, "status": 400, "is": { "/error": "description required" } },
    { "why": "a cost, to the cent", "as": "collaborator", "do": "POST {api}/exp", "body": { "trip_id": "{bs}", "description": "Gas", "amount": "40.456", "category": "", "date": "2026-08-10" }, "status": 200 },
    { "why": "is other, and totalled", "as": "collaborator", "do": "GET {api}/trip?id={bs}", "is": { "/expenses/0/amount": 40.46, "/expenses/0/category": "other", "/expenses/0/date": "2026-08-10", "/total": 40.46 }, "save": { "gas": "/expenses/0/id" } },
    { "why": "an amount that is not one is ignored", "as": "collaborator", "do": "PUT {api}/exp/oe1", "body": { "amount": "lots", "category": "cabin" }, "status": 200 },
    { "why": "and the rest lands", "do": "GET {api}/trip?id=old1", "is": { "/expenses/0/amount": 250.5, "/expenses/0/category": "cabin", "/expenses/0/description": "Cabin" } },
    { "why": "a cost goes", "as": "collaborator", "do": "POST {api}/exp/{gas}/delete", "body": {}, "status": 200 },
    { "why": "and is gone", "table": "_fdata/trip_expenses", "lacks": ["Gas"] },
    { "why": "something to pack that is not there", "as": "collaborator", "do": "POST {api}/pack/nope/delete", "body": {}, "status": 400 },

    { "why": "the owner may plan", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner deletes a trip", "as": "owner", "do": "POST {api}/trip/{bs}/delete", "body": {}, "status": 200 },
    { "why": "it is gone", "do": "GET {api}/trip?id={bs}", "status": 404 },
    { "why": "with its stops", "table": "_fdata/trip_itinerary", "has": ["Picnic"], "lacks": ["Bixby Bridge", "Lunch"] },
    { "why": "and its packing", "table": "_fdata/trip_packing", "has": ["Tent"], "lacks": ["Jacket"] },
    { "why": "and the other trip is left", "do": "GET {api}/trips", "is": { "/trips/0/id": "old1" }, "absent": ["/trips/1"] },
    { "why": "a route there is none of", "do": "GET {api}/nope", "status": 404 }
  ]
}
