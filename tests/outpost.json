{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "the owner sets the board up", "as": "owner", "do": "POST {api}/prefs", "body": { "title": "Old board", "tagline": "News from the shed", "who_can_post": "editors" }, "status": 200 },
    { "why": "a poll by the collaborator, already in the shared posts table", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fposts/oldpost0001", "body": { "author": "Ada", "author_user_id": "{did:collaborator}", "created_ms": 1000, "kind": "question", "text": "Old question", "poll_options": "[\"Yes\",\"No\"]", "_created_at": 1000, "_modified_at": 1000 }, "status": 200 },
    { "why": "and an older one by someone else", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fposts/oldpost0000", "body": { "author": "Bo", "author_user_id": "did:dht:someoneelse", "created_ms": 500, "kind": "thought", "text": "Older thought", "poll_options": null, "_created_at": 500, "_modified_at": 500 }, "status": 200 },
    { "why": "the viewer's vote in the poll", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fpost_votes/oldpost0001:u:{did:viewer}", "body": { "post_id": "oldpost0001", "voter": "u:{did:viewer}", "choice": 1, "_created_at": 1001, "_modified_at": 1001 }, "status": 200 },
    { "why": "an attachment's row", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fpost_media/oldmedia0001", "body": { "post_id": "oldpost0001", "name": "note.txt", "mime": "text/plain", "size": 12, "ord": 0, "path": "posts/oldpost0001/note.txt", "_created_at": 1000, "_modified_at": 1000 }, "status": 200 },
    { "why": "and its file beside the posts table", "as": "collaborator", "at": "space", "do": "PUT /files/_fdata/posts/oldpost0001/note.txt", "body": "hello there\n", "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["<title>Outpost</title>", "/lib/js/framelib.js"], "lacks": ["<form", "onSubmit", "busSend"] },
    { "why": "a stranger reads the board, newest first", "do": "GET {api}/state", "status": 200, "is": { "/me/is_anon": true, "/me/signed_in": false, "/me/is_owner": false, "/prefs": { "title": "Old board", "tagline": "News from the shed", "who_can_post": "editors" }, "/can_post": false, "/can_vote": false, "/has_more": false, "/next_before": 500, "/posts/0/id": "oldpost0001", "/posts/0/author": "Ada", "/posts/0/kind": "question", "/posts/0/text": "Old question", "/posts/0/can_delete": false, "/posts/0/poll": { "options": ["Yes", "No"], "counts": [0, 1], "total": 1, "my_choice": null }, "/posts/0/media/0": { "id": "oldmedia0001", "name": "note.txt", "mime": "text/plain", "size": 12, "is_image": false, "is_video": false, "is_audio": false }, "/posts/1/id": "oldpost0000", "/posts/1/poll": null, "/posts/1/media": [] }, "absent": ["/posts/0/media/0/path", "/posts/0/author_user_id", "/posts/2"] },
    { "why": "a collaborator reads no setting of the session's at the door, the heading included", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/title f:{id}", "status": 403 },
    { "why": "nor who may post", "as": "collaborator", "at": "space", "do": "KV.GET t/_settings/who_can_post f:{id}", "status": 403 },
    { "why": "nor widens it", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/who_can_post f:{id}", "body": { "v": "\"editors\"" }, "status": 403 },
    { "why": "nor rewrites the heading", "as": "collaborator", "at": "space", "do": "KV.PUT t/_settings/title f:{id}", "body": { "v": "\"Mine\"" }, "status": 403 },
    { "why": "and its attachment", "do": "GET {api}/media/oldpost0001/oldmedia0001", "status": 200, "has": ["hello there"] },
    { "why": "only under the post it belongs to", "do": "GET {api}/media/oldpost0000/oldmedia0001", "status": 404 },
    { "why": "and never by a path that is not one", "do": "GET {api}/media/oldpost0001", "status": 400 },
    { "why": "a stranger posts nothing", "do": "POST {api}/post", "body": { "text": "mine" }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "votes in nothing", "do": "POST {api}/vote", "body": { "post_id": "oldpost0001", "option": 0 }, "status": 403, "is": { "/error": "sign in to Seamside to vote" } },
    { "why": "deletes nothing", "do": "POST {api}/delete/oldpost0001", "body": {}, "status": 403 },
    { "why": "attaches nothing", "do": "POST {api}/post/oldpost0001/media?name=a.txt&mime=text/plain", "body": "mine", "status": 403 },
    { "why": "changes no setting", "do": "POST {api}/prefs", "body": { "title": "Mine" }, "status": 403 },
    { "why": "reads no setting of the session's at the door", "do": "KV.GET t/_settings/who_can_post f:{id}", "status": 403 },
    { "why": "nor writes the heading there", "do": "KV.PUT t/_settings/title f:{id}", "body": { "v": "\"Mine\"" }, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fposts/strangerpost", "body": { "text": "x" }, "status": 403 },
    { "why": "nor a vote", "do": "KV.PUT t/_fdata%2Fpost_votes/x", "body": { "post_id": "oldpost0001", "choice": 0 }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fposts/", "lacks": ["Old question"] },
    { "why": "a route there is none of", "do": "GET {api}/nothing", "status": 404 },

    { "why": "someone signed in and on no roster may vote, and not post", "as": "signed", "do": "GET {api}/state", "is": { "/me/signed_in": true, "/me/is_anon": true, "/can_vote": true, "/can_post": false, "/posts/0/poll/my_choice": null } },
    { "why": "their vote counts", "as": "signed", "do": "POST {api}/vote", "body": { "post_id": "oldpost0001", "option": 0 }, "status": 200, "is": { "/post/id": "oldpost0001", "/post/poll/counts": [1, 1], "/post/poll/my_choice": 0 } },
    { "why": "and a second one replaces it", "as": "signed", "do": "POST {api}/vote", "body": { "post_id": "oldpost0001", "option": 1 }, "status": 200, "is": { "/post/poll/counts": [0, 2], "/post/poll/total": 2, "/post/poll/my_choice": 1 } },
    { "why": "kept as one row per voter", "table": "_fdata/post_votes", "has": ["oldpost0001:u:{did:signed}", "\"voter\":\"u:{did:signed}\"", "\"choice\":1", "_created_at", "_modified_at"] },
    { "why": "an option the poll does not have is refused", "as": "signed", "do": "POST {api}/vote", "body": { "post_id": "oldpost0001", "option": 5 }, "status": 400 },
    { "why": "and a post that is no poll", "as": "signed", "do": "POST {api}/vote", "body": { "post_id": "oldpost0000", "option": 0 }, "status": 404 },
    { "why": "they post nothing", "as": "signed", "do": "POST {api}/post", "body": { "text": "mine" }, "status": 403 },
    { "why": "delete nothing", "as": "signed", "do": "POST {api}/delete/oldpost0001", "body": {}, "status": 403 },
    { "why": "and write no row at the door", "as": "signed", "do": "KV.PUT t/_fdata%2Fpost_votes/oldpost0001:u:{did:signed}", "body": { "post_id": "oldpost0001", "choice": 0 }, "status": 403 },

    { "why": "a viewer sees the vote they left", "as": "viewer", "do": "GET {api}/state", "is": { "/me/is_sfi_member": true, "/me/is_sfi_editor": false, "/can_vote": true, "/can_post": false, "/posts/0/poll/my_choice": 1, "/posts/0/can_delete": false } },
    { "why": "a viewer votes", "as": "viewer", "do": "POST {api}/vote", "body": { "post_id": "oldpost0001", "option": 0 }, "status": 200, "is": { "/post/poll/counts": [1, 1], "/post/poll/my_choice": 0 } },
    { "why": "posts nothing", "as": "viewer", "do": "POST {api}/post", "body": { "text": "mine" }, "status": 403 },
    { "why": "attaches nothing", "as": "viewer", "do": "POST {api}/post/oldpost0001/media?name=a.txt", "body": "mine", "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/delete/oldpost0001", "body": {}, "status": 403 },
    { "why": "changes no setting", "as": "viewer", "do": "POST {api}/prefs", "body": { "title": "Mine" }, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "do": "KV.PUT t/_fdata%2Fposts/viewerpost", "body": { "text": "x" }, "status": 403 },

    { "why": "a collaborator may post", "as": "collaborator", "do": "GET {api}/state", "is": { "/me/is_sfi_editor": true, "/can_post": true, "/posts/0/can_delete": true, "/posts/1/can_delete": false } },
    { "why": "a post with nothing in it is refused", "as": "collaborator", "do": "POST {api}/post", "body": { "text": "   " }, "status": 400, "is": { "/error": "a post needs text, a poll, or media" } },
    { "why": "a post is shared, under their name", "as": "collaborator", "do": "POST {api}/post", "body": { "text": "Hello from https://example.com", "kind": "status" }, "status": 200, "save": { "p1": "/post_id" }, "is": { "/post/author": "Collaborator", "/post/kind": "status", "/post/text": "Hello from https://example.com", "/post/poll": null, "/post/media": [], "/post/can_delete": true } },
    { "why": "a poll of a kind there is none of is a thought", "as": "collaborator", "do": "POST {api}/post", "body": { "kind": "rant", "poll_options": ["Tea", " ", "Coffee"] }, "status": 200, "save": { "p2": "/post_id" }, "is": { "/post/kind": "thought", "/post/poll": { "options": ["Tea", "Coffee"], "counts": [0, 0], "total": 0, "my_choice": null } } },
    { "why": "a post whose media follows", "as": "collaborator", "do": "POST {api}/post", "body": { "media_count": 2 }, "status": 200, "save": { "p3": "/post_id" } },
    { "why": "its file goes up", "as": "collaborator", "do": "POST {api}/post/{p3}/media?name=pic.txt&mime=text/plain", "body": "first bytes", "status": 200, "is": { "/ok": true } },
    { "why": "and a second of the same name", "as": "collaborator", "do": "POST {api}/post/{p3}/media?name=pic.txt&mime=text/plain", "body": "second bytes", "status": 200 },
    { "why": "each a file in the frame data folder, the second named apart", "as": "collaborator", "at": "space", "do": "GET /files/_fdata/posts/{p3}/pic%20(2).txt", "status": 200, "has": ["second bytes"] },
    { "why": "the rows name them, in order, stamped", "table": "_fdata/post_media", "has": ["\"path\":\"posts/{p3}/pic.txt\"", "\"path\":\"posts/{p3}/pic (2).txt\"", "\"ord\":1", "\"size\":12", "_created_at", "_modified_at"] },
    { "why": "the posts are rows of the shared table", "table": "_fdata/posts", "has": ["\"author_user_id\":\"{did:collaborator}\"", "\"poll_options\":null", "\"poll_options\":\"[\\\"Tea\\\",\\\"Coffee\\\"]\"", "\"kind\":\"thought\"", "\"text\":\"\"", "_created_at", "_modified_at"] },
    { "why": "a stranger reads the new post first, with both files", "do": "GET {api}/state", "is": { "/posts/0/id": "{p3}", "/posts/0/media/0/name": "pic.txt", "/posts/0/media/1/name": "pic.txt", "/posts/1/id": "{p2}", "/posts/2/id": "{p1}" }, "save": { "m2": "/posts/0/media/1/id" } },
    { "why": "and a file's bytes", "do": "GET {api}/media/{p3}/{m2}", "status": 200, "has": ["second bytes"] },
    { "why": "a post is not the collaborator's to attach to when they did not write it", "as": "collaborator", "do": "POST {api}/post/oldpost0000/media?name=a.txt", "body": "x", "status": 403, "is": { "/error": "not your post" } },
    { "why": "nor to delete", "as": "collaborator", "do": "POST {api}/delete/oldpost0000", "body": {}, "status": 403 },
    { "why": "a collaborator changes no setting", "as": "collaborator", "do": "POST {api}/prefs", "body": { "title": "Mine" }, "status": 403, "is": { "/error": "owner only" } },
    { "why": "deletes the poll they wrote", "as": "collaborator", "do": "POST {api}/delete/oldpost0001", "body": {}, "status": 200, "is": { "/ok": true } },
    { "why": "its votes go with it", "table": "_fdata/post_votes", "lacks": ["oldpost0001"] },
    { "why": "its media rows", "table": "_fdata/post_media", "lacks": ["oldmedia0001"] },
    { "why": "and its files", "as": "collaborator", "at": "space", "do": "GET /files/_fdata/posts/oldpost0001/note.txt", "status": 404 },
    { "why": "and it is gone from the board", "do": "GET {api}/state", "lacks": ["Old question"] },

    { "why": "the owner sees the settings and may post", "as": "owner", "do": "GET {api}/state", "is": { "/me/is_owner": true, "/can_post": true, "/posts/0/can_delete": true } },
    { "why": "the owner changes the heading and keeps posting to themselves", "as": "owner", "do": "POST {api}/prefs", "body": { "title": "  ", "tagline": " Fresh ", "who_can_post": "owner" }, "status": 200, "is": { "/prefs": { "title": "Outpost", "tagline": "Fresh", "who_can_post": "owner" } } },
    { "why": "who may post, the heading and the tagline are the session's own settings", "table": "_settings", "has": ["\"id\":\"who_can_post\"", "\"v\":\"\\\"owner\\\"\"", "\"v\":\"\\\"Fresh\\\"\"", "\"v\":\"\\\"Outpost\\\"\""], "lacks": ["Mine"] },
    { "why": "which even the owner does not reach at the door", "as": "owner", "at": "space", "do": "KV.LIST t/_settings/ f:{id}", "status": 403 },
    { "why": "a collaborator posts no more", "as": "collaborator", "do": "POST {api}/post", "body": { "text": "again" }, "status": 403 },
    { "why": "nor attaches to their own", "as": "collaborator", "do": "POST {api}/post/{p3}/media?name=b.txt", "body": "x", "status": 403 },
    { "why": "and the board says so", "as": "collaborator", "do": "GET {api}/state", "is": { "/can_post": false, "/prefs/who_can_post": "owner" } },
    { "why": "the owner posts", "as": "owner", "do": "POST {api}/post", "body": { "text": "From the keeper", "kind": "announcement" }, "status": 200, "save": { "p4": "/post_id" }, "is": { "/post/kind": "announcement" } },
    { "why": "which a collaborator may not delete", "as": "collaborator", "do": "POST {api}/delete/{p4}", "body": {}, "status": 403 },
    { "why": "the owner deletes anyone's", "as": "owner", "do": "POST {api}/delete/{p2}", "body": {}, "status": 200 },

    { "why": "the feed comes a page at a time", "do": "GET {api}/state?limit=2", "is": { "/posts/0/id": "{p4}", "/posts/1/id": "{p3}", "/has_more": true }, "absent": ["/posts/2"], "save": { "cursor": "/next_before" } },
    { "why": "and older pages after the cursor", "do": "GET {api}/posts?before={cursor}&limit=2", "status": 200, "is": { "/posts/0/id": "{p1}", "/posts/1/id": "oldpost0000", "/has_more": false } },
    { "why": "the last page ends the feed", "do": "GET {api}/posts?before=500", "is": { "/posts": [], "/has_more": false, "/next_before": null } }
  ]
}
