{
  "tier": "members",
  "publish": "open",
  "steps": [
    { "why": "a Monday meeting already in the table", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fclass_schedule/old1", "body": { "title": "Maths", "day": 0, "start_min": 540, "end_min": 600, "place": "Room 1", "note": "bring a calculator", "_created_at": 5, "_modified_at": 5 }, "status": 200 },
    { "why": "the same class on Wednesday", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fclass_schedule/old2", "body": { "title": "Maths", "day": 2, "start_min": 540, "end_min": 600, "place": "Room 1", "note": "", "_created_at": 6, "_modified_at": 6 }, "status": 200 },
    { "why": "and another class on Tuesday, with a time out of range", "as": "collaborator", "at": "space", "do": "KV.PUT t/_fdata%2Fclass_schedule/old3", "body": { "title": "Art", "day": 1, "start_min": 780, "end_min": 9999, "place": "", "note": "", "_created_at": 7, "_modified_at": 7 }, "status": 200 },

    { "why": "the page is served", "do": "GET {frame}/index.html", "status": 200, "has": ["Class Schedule", "/lib/js/framelib.js", "/dyn/frame-prefs.css"], "lacks": ["busSend", "frame.api"] },
    { "why": "a stranger is told they are nobody here", "do": "GET {api}/whoami", "status": 200, "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/is_owner": false, "/user_id": "" } },
    { "why": "a stranger reads the week, old rows and all, by day then time", "do": "GET {api}/list", "status": 200, "is": { "/classes/0/id": "old1", "/classes/0/title": "Maths", "/classes/0/day": 0, "/classes/0/start_min": 540, "/classes/0/end_min": 600, "/classes/0/place": "Room 1", "/classes/0/note": "bring a calculator", "/classes/1/id": "old3", "/classes/1/end_min": 1440, "/classes/2/id": "old2" }, "absent": ["/classes/3", "/classes/0/_created_at"] },
    { "why": "a stranger adds no class", "do": "POST {api}/class", "body": { "title": "Sneak", "days": [0] }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "moves none", "do": "POST {api}/class/old1", "body": { "day": 3 }, "status": 403 },
    { "why": "nor by PUT", "do": "PUT {api}/class/old1", "body": { "title": "Mine" }, "status": 403 },
    { "why": "deletes no meeting", "do": "POST {api}/class/old1/delete", "body": {}, "status": 403 },
    { "why": "nor a whole class", "do": "POST {api}/class/old1/delete_all", "body": {}, "status": 403 },
    { "why": "a stranger writes no row at the door", "do": "KV.PUT t/_fdata%2Fclass_schedule/x", "body": { "title": "x" }, "status": 403 },
    { "why": "and reads no table there", "do": "KV.LIST t/_fdata%2Fclass_schedule/", "lacks": ["Maths", "calculator"] },
    { "why": "the week is as it was", "table": "_fdata/class_schedule", "has": ["\"id\":\"old1\"", "\"id\":\"old2\"", "\"id\":\"old3\""], "lacks": ["Sneak", "Mine", "\"x\""] },

    { "why": "someone signed in and on no roster is a visitor too", "as": "signed", "do": "GET {api}/whoami", "is": { "/is_anon": true, "/is_sfi_member": false, "/is_sfi_editor": false, "/user_id": "{did:signed}" } },
    { "why": "who reads the week", "as": "signed", "do": "GET {api}/list", "status": 200, "is": { "/classes/0/id": "old1" } },
    { "why": "and writes nothing", "as": "signed", "do": "POST {api}/class", "body": { "title": "Sneak", "days": [0] }, "status": 403 },
    { "why": "nor deletes", "as": "signed", "do": "POST {api}/class/old1/delete", "body": {}, "status": 403 },

    { "why": "a viewer is a member who may not edit", "as": "viewer", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_member": true, "/is_sfi_editor": false, "/is_owner": false, "/user_name": "Viewer" } },
    { "why": "a viewer reads the week", "as": "viewer", "do": "GET {api}/list", "status": 200, "is": { "/classes/2/id": "old2" } },
    { "why": "a viewer adds no class", "as": "viewer", "do": "POST {api}/class", "body": { "title": "Mine", "days": [0] }, "status": 403, "is": { "/error": "editors only" } },
    { "why": "moves none", "as": "viewer", "do": "POST {api}/class/old1", "body": { "start_min": 600 }, "status": 403 },
    { "why": "renames none", "as": "viewer", "do": "POST {api}/class/old1", "body": { "title": "Mine", "apply_all": true }, "status": 403 },
    { "why": "deletes nothing", "as": "viewer", "do": "POST {api}/class/old1/delete_all", "body": {}, "status": 403 },
    { "why": "and writes no row at the door", "as": "viewer", "at": "space", "do": "KV.PUT t/_fdata%2Fclass_schedule/x", "body": { "title": "x" }, "status": 403 },

    { "why": "a collaborator may edit", "as": "collaborator", "do": "GET {api}/whoami", "is": { "/is_sfi_member": true, "/is_sfi_editor": true, "/user_id": "{did:collaborator}" } },
    { "why": "a class with no name is refused", "as": "collaborator", "do": "POST {api}/class", "body": { "title": "   ", "days": [0] }, "status": 400, "is": { "/error": "name it" } },
    { "why": "a class is added on the days ticked, each once, its end kept after its start", "as": "collaborator", "do": "POST {api}/class", "body": { "title": "  Physics ", "days": [3, 4, 3, 9], "start_min": 600, "end_min": 550, "place": " Lab B " }, "status": 200, "is": { "/ok": true } },
    { "why": "one row per meeting, in the table's shape", "table": "_fdata/class_schedule", "has": ["\"title\":\"Physics\"", "\"day\":3", "\"day\":4", "\"day\":6", "\"start_min\":600", "\"end_min\":630", "\"place\":\"Lab B\"", "\"note\":\"\"", "_created_at", "_modified_at"] },
    { "why": "and the week reads them in order", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/3/title": "Physics", "/classes/3/day": 3, "/classes/4/day": 4, "/classes/5/day": 6, "/classes/5/end_min": 630 }, "absent": ["/classes/6"], "save": { "fri": "/classes/4/id", "sun": "/classes/5/id" } },
    { "why": "one day alone is taken too", "as": "collaborator", "do": "POST {api}/class", "body": { "title": "Choir", "day": 5, "start_min": 1500 }, "status": 200 },
    { "why": "held inside the day", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/5/title": "Choir", "/classes/5/day": 5, "/classes/5/start_min": 1439, "/classes/5/end_min": 1440 }, "save": { "choir": "/classes/5/id" } },

    { "why": "an old meeting moves, keeping what it held", "as": "collaborator", "do": "POST {api}/class/old1", "body": { "day": 1, "start_min": 480 }, "status": 200 },
    { "why": "its length follows from what it was", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/0/id": "old1", "/classes/0/day": 1, "/classes/0/start_min": 480, "/classes/0/end_min": 600, "/classes/0/note": "bring a calculator", "/classes/0/place": "Room 1" } },
    { "why": "over the row, which kept when it was made", "table": "_fdata/class_schedule", "has": ["\"_created_at\":5", "\"note\":\"bring a calculator\""] },
    { "why": "a note and a place are written, emptied place included", "as": "collaborator", "do": "PUT {api}/class/old2", "body": { "note": " quiz ", "place": "" }, "status": 200 },
    { "why": "and read back", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/2/id": "old2", "/classes/2/note": "quiz", "/classes/2/place": "", "/classes/2/title": "Maths" } },
    { "why": "an empty name changes nothing", "as": "collaborator", "do": "POST {api}/class/old2", "body": { "title": "  " }, "status": 200 },
    { "why": "renaming one meeting with apply_all renames the class", "as": "collaborator", "do": "POST {api}/class/old1", "body": { "title": "Calculus", "apply_all": true }, "status": 200 },
    { "why": "every meeting of it, and nothing else", "table": "_fdata/class_schedule", "has": ["\"title\":\"Calculus\"", "\"title\":\"Art\"", "\"title\":\"Physics\""], "lacks": ["\"title\":\"Maths\""] },
    { "why": "without apply_all only that meeting", "as": "collaborator", "do": "POST {api}/class/{sun}", "body": { "title": "Physics lab" }, "status": 200 },
    { "why": "the others keep their name", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/3/title": "Physics", "/classes/4/title": "Physics", "/classes/6/title": "Physics lab" } },

    { "why": "a meeting there is no such thing as is refused, never made", "as": "collaborator", "do": "POST {api}/class/ghost", "body": { "day": 1 }, "status": 400, "is": { "/error": "bad id" } },
    { "why": "and nothing was made for it", "table": "_fdata/class_schedule", "lacks": ["ghost"] },
    { "why": "an act there is none of", "as": "collaborator", "do": "POST {api}/class/old1/nope", "body": {}, "status": 404 },
    { "why": "a route there is none of", "as": "collaborator", "do": "POST {api}/nope", "body": {}, "status": 404 },
    { "why": "nor a read", "as": "collaborator", "do": "GET {api}/nope", "status": 404 },
    { "why": "nor a delete", "as": "collaborator", "do": "DELETE {api}/class/old1", "status": 404 },

    { "why": "one meeting goes", "as": "collaborator", "do": "POST {api}/class/{fri}/delete", "body": {}, "status": 200 },
    { "why": "and only it", "as": "collaborator", "do": "GET {api}/list", "is": { "/classes/3/title": "Physics", "/classes/3/day": 3, "/classes/4/title": "Choir" }, "absent": ["/classes/6"] },
    { "why": "a whole class goes at once", "as": "collaborator", "do": "POST {api}/class/old2/delete_all", "body": {}, "status": 200 },
    { "why": "every meeting of it", "table": "_fdata/class_schedule", "lacks": ["Calculus", "old1", "old2"], "has": ["Art", "Physics", "Choir"] },

    { "why": "an admin edits too", "as": "admin", "do": "POST {api}/class/{choir}", "body": { "place": "Hall" }, "status": 200 },
    { "why": "the owner may edit", "as": "owner", "do": "GET {api}/whoami", "is": { "/is_anon": false, "/is_sfi_editor": true, "/user_id": "{did:owner}" } },
    { "why": "the owner adds a class", "as": "owner", "do": "POST {api}/class", "body": { "title": "History", "days": [0], "start_min": 420, "end_min": 480 }, "status": 200 },
    { "why": "and removes one", "as": "owner", "do": "POST {api}/class/{choir}/delete", "body": {}, "status": 200 },
    { "why": "a stranger sees every change", "do": "GET {api}/list", "is": { "/classes/0/title": "History", "/classes/1/title": "Art", "/classes/2/title": "Physics", "/classes/3/title": "Physics lab" }, "absent": ["/classes/4"] }
  ]
}
